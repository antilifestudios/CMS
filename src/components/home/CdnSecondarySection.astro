---

<section class="cdn-section" id="cdn-detection" aria-labelledby="cdn-h2">
  <div class="container">
    <div class="cdn-card card-dark">
      <div class="cdn-header">
        <span class="eyebrow type-mono-eyebrow text-mute">Complementary Feature</span>
        <h2 id="cdn-h2" class="cdn-title">
          Also Identify a Website's CDN Provider
        </h2>
        <p class="cdn-subtitle text-ash">
          While CMS detection identifies <em>how</em> content is managed, our tool also inspects HTTP headers to identify <em>how</em> that content is delivered across global edge networks.
        </p>
      </div>

      <div class="cdn-explainer-text">
        <p>
          A <strong>Content Delivery Network (CDN)</strong> distributes website static assets—including images, JavaScript bundles, stylesheets, and cached HTML—across a worldwide network of edge servers. As explained by the <a href="https://www.cloudflare.com/learning/cdn/what-is-a-cdn/" target="_blank" rel="noopener noreferrer" class="text-link-soft">Cloudflare Learning Center</a>, CDNs significantly reduce page latency by serving requests from edge locations closest to the visitor.
        </p>
        <p>
          During every scan, our engine checks response headers and network markers for the following supported CDN and edge providers:
        </p>
      </div>

      <div class="cdn-grid">
        {CDN_PROVIDERS.map((provider) => (
          <div class="cdn-item-card">
            <div class="cdn-item-top">
              <div class="cdn-provider-head">
                <div class="cdn-provider-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d={provider.iconPath} />
                  </svg>
                </div>
                <span class="cdn-provider-name">{provider.name}</span>
              </div>
              <span class="cdn-provider-tag">{provider.tag}</span>
            </div>
            <p class="cdn-provider-desc">
              {provider.desc}
            </p>
            <div class="cdn-signals-row">
              <span class="cdn-sig-label">Headers:</span>
              <code class="cdn-sig-code">{provider.signals}</code>
            </div>
          </div>
        ))}
      </div>

      <div class="cdn-note">
        <span class="cdn-note-label">Note:</span>
        <span class="cdn-note-body">CDN detection reflects observable public edge headers. Some enterprise custom domains route through private origins or multi-tiered proxies that may mask the primary edge layer.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cdn-section {
    padding-block: clamp(40px, 5vw, 64px);
    border-block-start: 1px solid var(--color-hairline-soft);
  }

  .cdn-card {
    padding: clamp(22px, 3.5vw, 36px);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-marketing);
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: auto;
  }

  .cdn-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cdn-title {
    color: var(--color-on-primary);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .cdn-subtitle {
    margin: 0;
    font-size: clamp(17px, 1.8vw, 19px);
    line-height: 1.55;
    color: var(--color-ash);
    max-inline-size: 880px;
  }

  .cdn-explainer-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-inline-size: 920px;
  }

  .cdn-explainer-text p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #d1d5db;
  }

  .cdn-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-block-start: 4px;
  }

  @media (min-width: 640px) {
    .cdn-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cdn-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cdn-item-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 22px;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-app-lg);
    height: auto;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .cdn-item-card:hover {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  .cdn-item-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cdn-provider-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cdn-provider-icon {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-app-sm);
    color: var(--color-on-primary);
    flex-shrink: 0;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .cdn-item-card:hover .cdn-provider-icon {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }

  .cdn-provider-name {
    color: var(--color-on-primary);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  .cdn-provider-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #a3a3a3;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 2px 7px;
    border-radius: var(--radius-app-xs);
    white-space: nowrap;
  }

  .cdn-provider-desc {
    margin: 0;
    line-height: 1.55;
    flex: 1;
    font-size: 15px;
    color: #d4d4d8;
  }

  .cdn-signals-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding-block-start: 10px;
    border-block-start: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
  }

  .cdn-sig-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: #a1a1aa;
    flex-shrink: 0;
    padding-top: 2px;
  }

  .cdn-sig-code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.45;
    background-color: rgba(0, 0, 0, 0.35);
    color: #e2e8f0;
    padding: 3px 7px;
    border-radius: var(--radius-app-xs);
    border: 1px solid rgba(255, 255, 255, 0.06);
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .cdn-note {
    font-size: 14px;
    line-height: 1.5;
    color: #a1a1aa;
    padding-block-start: 14px;
    border-block-start: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-block-start: 2px;
  }

  .cdn-note-label {
    font-weight: 500;
    color: var(--color-on-primary);
    flex-shrink: 0;
  }

  .cdn-note-body {
    color: #a1a1aa;
  }

  .text-link-soft {
    color: var(--color-link-blue-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .text-link-soft:hover {
    color: var(--color-on-primary);
  }
</style>
