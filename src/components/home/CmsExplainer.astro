    padding: 2px 7px;
    border-radius: var(--radius-app-xs);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .arch-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: #cbd5e1;
  }

  .arch-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-block-start: 2px;
  }

  .tech-pill {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: #f8fafc;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-app-xs);
  }

  .stat-callout {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: 12px 16px;
    background-color: rgba(243, 100, 88, 0.07);
    border: 1px solid rgba(243, 100, 88, 0.22);
