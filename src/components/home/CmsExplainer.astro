  .limit-heading {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
  }

  .limit-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #cbd5e1;
  }

  .limit-text code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    background-color: rgba(255, 255, 255, 0.08);
