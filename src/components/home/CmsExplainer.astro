  }

  .stat-text {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: #e2e8f0;
  }

  /* Card 2: Signal Inspector */
  .signal-inspector {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-block-start: auto;
  }

  .signal-row {
    padding: 12px 14px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
