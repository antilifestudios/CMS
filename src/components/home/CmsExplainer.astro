    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .signal-title {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
  }

  .code-pill {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: #f8fafc;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 6px 10px;
    border-radius: var(--radius-app-xs);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow-x: auto;
    white-space: nowrap;
  }

  .code-divider {
    color: #94a3b8;
    padding-inline: 4px;
  }

  .signal-note {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: #cbd5e1;
  }

  .signal-note code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    background-color: rgba(255, 255, 255, 0.08);
    color: #f1f5f9;
    padding: 1px 5px;
    border-radius: 3px;
  }

  /* Card 3: Limits */
  .limit-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-block-start: auto;
  }

  .limit-item {
    padding: 14px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-app-md);
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .limit-item-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .limit-tag {
    font-family: var(--font-mono);
    color: #d8b4fe;
    background-color: rgba(168, 85, 247, 0.14);
    border: 1px solid rgba(168, 85, 247, 0.28);
