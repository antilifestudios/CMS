  }

  .trust-ribbon {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background-color: rgba(55, 205, 132, 0.06);
    border: 1px solid rgba(55, 205, 132, 0.22);
    border-radius: var(--radius-app-md);
    margin-block-start: auto;
  }

  .trust-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
    flex-shrink: 0;
  }

  .trust-text {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #e2e8f0;
    line-height: 1.4;
  }

  .text-link-soft {
    color: var(--color-link-blue-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .text-link-soft:hover {
    color: #ffffff;
  }
</style>
