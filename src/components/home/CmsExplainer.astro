    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .explainer-lead {
    margin: 0 0 var(--spacing-md) 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: #e2e8f0;
  }

