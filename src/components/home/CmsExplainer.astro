    border-radius: 3px;
  }

  /* Card 3: Limits */
  .limit-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-block-start: auto;
  }

  .limit-item {
    padding: 9px 11px;
    background-color: rgba(255, 255, 255, 0.03);
