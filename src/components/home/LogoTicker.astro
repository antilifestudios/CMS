---

<section class="ticker-section" aria-label="Recognized Platforms and Technologies">
  <div class="container ticker-container">
    <div class="ticker-header">
      <span class="ticker-eyebrow type-mono-micro">PLATFORMS WE RECOGNIZE</span>
    </div>

    <div class="ticker-viewport" tabindex="0" aria-label="Horizontally scrolling technology platform logos">
      <div class="ticker-track">
        {/* Primary sequence (accessible to screen readers) */}
        <ul class="ticker-list" aria-label="Detected CMS and CDN technologies">
          {PLATFORMS.map((platform) => (
            <li class="ticker-item">
              <svg
                class="ticker-icon"
                viewBox={platform.viewBox || '0 0 24 24'}
                aria-hidden="true"
                focusable="false"
              >
                <path d={platform.path} />
              </svg>
              <span class="ticker-name">{platform.name}</span>
            </li>
          ))}
        </ul>

        {/* Decorative duplicate sequence for seamless infinite loop */}
        <ul class="ticker-list" aria-hidden="true">
          {PLATFORMS.map((platform) => (
            <li class="ticker-item">
              <svg
                class="ticker-icon"
                viewBox={platform.viewBox || '0 0 24 24'}
                focusable="false"
              >
                <path d={platform.path} />
              </svg>
              <span class="ticker-name">{platform.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ticker-section {
    padding-block: var(--spacing-md) var(--spacing-lg);
    background-color: var(--color-canvas);
    border-block: 1px solid var(--color-hairline-soft);
    overflow: hidden;
  }

  .ticker-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .ticker-header {
    display: flex;
    justify-content: center;
  }

  .ticker-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 500;
  }

  .ticker-viewport {
    position: relative;
    inline-size: 100%;
    overflow: hidden;
    outline: none;
    padding-block: var(--spacing-xs);
  }

  .ticker-viewport:focus-visible {
    box-shadow: 0 0 0 2px var(--color-brand);
    border-radius: var(--radius-app-sm);
  }

  .ticker-track {
    display: flex;
    inline-size: max-content;
    will-change: transform;
    animation: ticker-slide 42s linear infinite;
  }

  .ticker-viewport:hover .ticker-track,
  .ticker-viewport:focus-within .ticker-track {
    animation-play-state: paused;
  }

  .ticker-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 48px;
    padding-inline: 24px;
    flex-shrink: 0;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ash);
    user-select: none;
    transition: color 0.2s ease, opacity 0.2s ease;
    opacity: 0.85;
  }

  .ticker-item:hover {
    color: var(--color-on-primary);
    opacity: 1;
  }

  .ticker-icon {
    inline-size: 20px;
    block-size: 20px;
    flex-shrink: 0;
    fill: currentColor;
  }

  .ticker-name {
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    line-height: 1;
  }

  @keyframes ticker-slide {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Accessible fallback for reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .ticker-viewport {
      overflow-x: auto;
    }

    .ticker-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      inline-size: 100%;
    }

    .ticker-list[aria-hidden="true"] {
      display: none;
    }

    .ticker-list {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--spacing-lg);
      padding-inline: 0;
    }
  }

  @media (max-width: 640px) {
    .ticker-list {
      gap: 36px;
      padding-inline: 18px;
    }

    .ticker-icon {
      inline-size: 18px;
      block-size: 18px;
    }

    .ticker-name {
      font-size: 12.5px;
    }
  }
</style>
