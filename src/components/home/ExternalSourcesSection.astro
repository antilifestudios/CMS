---
/**
 * ExternalSourcesSection.astro — Curated authoritative technical references
 * for deep-diving into web technologies, CMS standards, and edge networks.
 */

const SOURCES = [
  {
    name: 'W3Techs CMS Market Share',
    url: 'https://w3techs.com/technologies/overview/content_management',
    org: 'W3Techs Web Technology Surveys',
    desc: 'Historical and current market adoption data across WordPress, Shopify, Drupal, and web builders.',
  },
  {
    name: 'WordPress.org Documentation',
    url: 'https://wordpress.org/documentation/',
    org: 'WordPress Foundation',
    desc: 'Official technical specifications covering template hierarchies, REST API schemas, and theme structures.',
  },
  {
    name: 'Shopify Developer Docs',
    url: 'https://shopify.dev/docs',
    org: 'Shopify Engineering',
    desc: 'Architectural documentation for Liquid theme development, Storefront APIs, and merchant cloud hosting.',
  },
  {
    name: 'Drupal Community Documentation',
    url: 'https://www.drupal.org/docs',
    org: 'Drupal Association',
    desc: 'Open-source standards, cache-tag headers, module architectures, and security best practices.',
  },
  {
    name: 'MDN Web Docs: HTTP Headers',
    url: 'https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers',
    org: 'Mozilla Developer Network',
    desc: 'Authoritative reference on HTTP response headers, server tokens, security policies, and caching controls.',
  },
  {
    name: 'Cloudflare Learning Center: What Is a CDN?',
    url: 'https://www.cloudflare.com/learning/cdn/what-is-a-cdn/',
    org: 'Cloudflare Learning',
    desc: 'Educational guide on edge server distribution, reverse proxies, latency reduction, and CDN operations.',
  },
];
---

<section class="external-sources-section" aria-labelledby="sources-h2">
  <div class="container">
    <div class="sources-card card-dark">
      <div class="sources-head">
        <span class="eyebrow type-mono-eyebrow text-mute">Authority & Standards</span>
        <h2 id="sources-h2" class="type-heading-sm sources-title">
          Authoritative Technical References & Standards
        </h2>
        <p class="type-body-sm text-ash sources-sub">
          We build our detection signatures in alignment with official platform specifications and open web standards:
        </p>
      </div>

      <div class="sources-grid">
        {SOURCES.map((source) => (
          <a href={source.url} target="_blank" rel="noopener noreferrer" class="source-link card-dark" title={`Open ${source.name} (external link)`}>
            <div class="source-item-head">
              <span class="source-name type-heading-sm">{source.name}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="source-ext-icon" aria-hidden="true">
                <path d="M3 2h7v7M10 2L2 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="source-org type-mono-micro text-brand">{source.org}</span>
            <p class="source-desc type-body-sm text-ash">
              {source.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .external-sources-section {
    padding-block: var(--spacing-section-lg);
    border-block-start: 1px solid var(--color-hairline-soft);
  }

  .sources-card {
    padding: var(--spacing-xl);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-marketing);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  @media (min-width: 768px) {
    .sources-card {
      padding: var(--spacing-xxl);
    }
  }

  .sources-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sources-title {
    color: var(--color-on-primary);
    margin: 0;
  }

  .sources-sub {
    margin: 0;
    max-inline-size: 680px;
  }

  .sources-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .sources-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .sources-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .source-link {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-app-lg);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    gap: 4px;
  }

  .source-link:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .source-item-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
  }

  .source-name {
    color: var(--color-on-primary);
    font-size: 15px;
    margin: 0;
    line-height: 1.3;
  }

  .source-ext-icon {
    color: var(--color-mute);
    flex-shrink: 0;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .source-link:hover .source-ext-icon {
    color: var(--color-brand);
    transform: translate(2px, -2px);
  }

  .source-org {
    margin-block-end: 4px;
  }

  .source-desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
  }
</style>
