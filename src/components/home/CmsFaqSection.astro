---
/**
 * CmsFaqSection.astro — Accessible, crawlable FAQ section prioritizing the 10
 * key CMS-first questions in exact sequence.
 */

export interface FAQItem {
  id: string;
  question: string;
  answer: string;
}

export const CMS_FAQ_ITEMS: FAQItem[] = [
  {
    id: 'what-is-cms-detector',
    question: 'What is a CMS detector?',
    answer: 'A CMS detector is an online tool that analyzes a website\'s publicly observable code and HTTP traffic to identify its underlying Content Management System (such as WordPress, Shopify, Drupal, or Webflow). It examines clues including HTML tags, script paths, stylesheet directories, and HTTP headers.',
  },
  {
    id: 'how-to-find-out-cms',
    question: 'How can I find out what CMS a website uses?',
    answer: 'You can find out what CMS a website uses by entering its URL into our CMS detector for instant analysis. Alternatively, you can inspect the site manually by opening page source (Ctrl+U) to search for <meta name="generator"> or asset paths like /wp-content/, or by checking HTTP response headers in browser Developer Tools.',
  },
  {
    id: 'how-does-detector-work',
    question: 'How does a website CMS detector work?',
    answer: 'A CMS detector fetches the public HTML of the target domain and evaluates it against hundreds of technical signatures. It inspects meta generator tags, stylesheet URLs, script hostnames, unique cookie names, and HTTP response headers (such as x-powered-by or x-generator) to confirm matching platforms with evidence.',
  },
  {
    id: 'which-cms-platforms-detected',
    question: 'Which CMS platforms can this tool detect?',
    answer: 'The tool detects over 25 major CMS platforms and website builders, including WordPress, Shopify, Drupal, Joomla, Ghost, TYPO3, Craft CMS, Umbraco, HubSpot CMS, Webflow, Wix, Squarespace, and Framer, alongside popular e-commerce engines like WooCommerce and Magento.',
  },
  {
    id: 'why-cant-detector-identify',
    question: 'Why can\'t the detector identify a website\'s CMS?',
    answer: 'If a site returns "No known platform detected", it may be custom-coded from scratch using frameworks like React, Vue, or Django without a traditional CMS. It could also use a headless CMS where content is served via API to a separate static frontend, or the website owner may have removed identifying headers and generator tags for security.',
  },
  {
    id: 'custom-built-cms',
    question: 'Can a website use a custom-built CMS?',
    answer: 'Yes. Many proprietary applications and large enterprise websites use custom in-house content management systems built specifically for their requirements. Because custom CMSs do not share standardized open-source or commercial signatures, detectors will not match a known commercial platform name.',
  },
  {
    id: 'scan-unowned-website',
    question: 'Can I scan a website I do not own?',
    answer: 'Yes. Our CMS detector only examines publicly accessible HTTP response headers and rendered HTML that web servers deliver to any regular web browser. It does not perform invasive vulnerability scans or access private server environments, making it safe and compliant for public research.',
  },
  {
    id: 'is-cms-detector-free',
    question: 'Is the CMS detector free to use?',
    answer: 'Yes, CMS Detector AI is 100% free to use. There are no fees, paywalls, mandatory user registrations, or subscription plans. Standard edge rate limits apply solely to prevent automated bot abuse and maintain fast performance for all users.',
  },
  {
    id: 'how-accurate-is-detection',
    question: 'How accurate is CMS detection?',
    answer: 'Detection accuracy is very high for websites running standard installations of supported CMS platforms because detections require concrete, deterministic evidence strings. However, accuracy depends on observable signals; heavily obfuscated sites or decoupled headless setups may prevent definitive platform identification.',
  },
  {
    id: 'can-identify-cdn-provider',
    question: 'Can the same tool identify a website\'s CDN provider?',
    answer: 'Yes. In addition to identifying the CMS, every scan checks HTTP headers and network indicators for supported Content Delivery Networks (CDNs) and edge providers—including Cloudflare, AWS CloudFront, Fastly, Akamai, Vercel, and Netlify.',
  },
];
---

<section class="cms-faq-section" id="faq" aria-labelledby="faq-h2">
  <div class="container">
    <div class="section-header">
      <div class="eyebrow-lockup">
        <span class="eyebrow type-mono-eyebrow text-brand">Frequently Asked Questions</span>
        <h2 id="faq-h2" class="type-display-sm section-title">
          CMS Detection & Platform Questions
        </h2>
        <p class="type-subtitle text-ash section-subtitle">
          Clear, technical answers to common questions about finding website platforms, edge signature inspection, and privacy guarantees.
        </p>
      </div>
    </div>

    <div class="faq-accordion">
      {CMS_FAQ_ITEMS.map((item, idx) => (
        <details class="faq-item" id={`faq-${item.id}`}>
          <summary class="faq-trigger">
            <span class="faq-q-text">
              <span class="faq-num type-mono-micro text-mute">{String(idx + 1).padStart(2, '0')}.</span>
              <span>{item.question}</span>
            </span>
            <svg class="faq-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="faq-content">
            <p class="type-body-sm text-ash">{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .cms-faq-section {
    padding-block: var(--spacing-section-lg);
    border-block-start: 1px solid var(--color-hairline-soft);
  }

  .section-header {
    margin-block-end: var(--spacing-xl);
  }

  .section-title {
    color: var(--color-on-primary);
    margin-block: var(--spacing-xs) var(--spacing-xs);
  }

  .section-subtitle {
    margin: 0;
    max-inline-size: 680px;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    max-inline-size: 960px;
  }

  .faq-item {
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-app-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .faq-item:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .faq-item[open] {
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(33, 33, 33, 0.9);
  }

  .faq-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg);
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-on-primary);
    list-style: none;
    user-select: none;
  }

  .faq-trigger::-webkit-details-marker {
    display: none;
  }

  .faq-q-text {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
    padding-inline-end: var(--spacing-md);
  }

  .faq-num {
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  .faq-chevron {
    inline-size: 18px;
    block-size: 18px;
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-brand);
  }

  .faq-content {
    padding: 0 var(--spacing-lg) var(--spacing-lg) calc(var(--spacing-lg) + 32px);
  }

  .faq-content p {
    margin: 0;
    line-height: 1.6;
    font-size: 14.5px;
  }
</style>
