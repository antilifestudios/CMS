---
/**
 * StatsStrip.astro — Improved, substantiated statistics section.
 * Balanced 4-column desktop layout that collapses gracefully to 2 columns on tablet/mobile,
 * with substantiated descriptions for every metric.
 */
---

<section class="stat-strip-section" aria-label="Engine Statistics and Capabilities">
  <div class="container">
    <div class="stat-strip card-dark">
      <div class="stat-item">
        <div class="stat-num-row">
          <span class="stat-number">100+</span>
        </div>
        <span class="stat-label">Supported Technologies</span>
        <p class="stat-desc text-mute">
          25+ CMS & website builders, plus frontend frameworks and CDN providers.
        </p>
      </div>

      <div class="stat-divider" aria-hidden="true"></div>

      <div class="stat-item">
        <div class="stat-num-row">
          <span class="stat-number">&lt; 3s</span>
        </div>
        <span class="stat-label">Average Edge Scan</span>
        <p class="stat-desc text-mute">
          Parallel subrequest fetching and signature parsing on global edge workers.
        </p>
      </div>

      <div class="stat-divider" aria-hidden="true"></div>

      <div class="stat-item">
        <div class="stat-num-row">
          <span class="stat-number">100%</span>
        </div>
        <span class="stat-label">Deterministic Evidence</span>
        <p class="stat-desc text-mute">
          Backed by observable headers, meta tags, and script paths—never AI guesses.
        </p>
      </div>

      <div class="stat-divider" aria-hidden="true"></div>

      <div class="stat-item">
        <div class="stat-num-row">
          <span class="stat-number">0</span>
        </div>
        <span class="stat-label">Stored Target URLs</span>
        <p class="stat-desc text-mute">
          Ephemeral in-memory analysis; zero submitted queries or logs stored in databases.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .stat-strip-section {
    padding-block: var(--spacing-lg);
  }

  .stat-strip {
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-marketing);
    padding: var(--spacing-xl);
    gap: var(--spacing-lg);
  }

  @media (min-width: 640px) {
    .stat-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-xl);
    }
  }

  @media (min-width: 1024px) {
    .stat-strip {
      grid-template-columns: repeat(4, 1fr);
      padding: var(--spacing-xxl) var(--spacing-xl);
      gap: var(--spacing-xl);
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-inline-size: 0;
  }

  .stat-num-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .stat-number {
    font-size: clamp(32px, 3.5vw, 44px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -1.5px;
    color: var(--color-on-primary);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-on-primary);
    line-height: 1.3;
  }

  .stat-desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
  }

  .stat-divider {
    display: none;
  }

  @media (max-width: 639px) {
    .stat-item:not(:last-child) {
      border-block-end: 1px solid rgba(255, 255, 255, 0.05);
      padding-block-end: var(--spacing-md);
    }
  }
</style>
