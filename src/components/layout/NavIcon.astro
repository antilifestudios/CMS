---
/**
 * NavIcon — reusable monochrome nav/tool icon.
 *
 * Sources (paths copied directly, no dependencies):
 * - WordPress logo mark: Simple Icons, CC0 1.0 (https://simpleicons.org/icons/wordpress.svg)
 * - Shopify bag mark: Simple Icons, CC0 1.0 (https://simpleicons.org/icons/shopify.svg)
 * - Hosting server rack: Lucide "server", ISC licence (https://lucide.dev/icons/server)
 *
 * Monochrome by design: fill="currentColor" (brands) / stroke="currentColor"
 * (Lucide) so icons inherit label color on hover / active / focus + themes.
 * Decorative only: always aria-hidden="true" focusable="false".
 */
interface Props {
  /** Which mark to render. */
  name: 'wordpress' | 'shopify' | 'hosting';
  /** Pixel size (width + height). Defaults to 16 per nav spec. */
  size?: number;
}

const { name, size = 16 } = Astro.props;
const px = `${size}px`;
---
