---
/**
 * Footer — modern dark terminal surface per DESIGN.md & Vercel aesthetics.
 * Provides accessible navigation to all tools, documentation, company, and legal pages.
 */
import en from '../../i18n/en.json';

const year = new Date().getFullYear();

const columns = [
  {
    eyebrow: 'Detection Tools',
    links: [
      { href: '/', label: 'Technology Detector' },
      { href: '/wordpress-theme-detector', label: 'WordPress Theme Detector' },
      { href: '/shopify-theme-detector',   label: 'Shopify Theme Detector' },
      { href: '/growth-marketing-detector', label: 'Growth & Marketing Detector' },
      { href: '/security-privacy-detector', label: 'Security & Privacy Detector' },
    ],
  },
  {
    eyebrow: 'Blog & Guides',
    links: [
      { href: '/blog',                                label: 'All Blog Articles' },
      { href: '/blog/how-it-works',                   label: 'How It Works (Engine)' },
      { href: '/blog/how-to-find-a-cms',              label: 'How to Find a CMS' },
      { href: '/blog/what-is-a-cms',                  label: 'What Is a CMS?' },
      { href: '/blog/wordpress-signatures',          label: 'WordPress Signatures' },
      { href: '/blog/shopify-signatures',            label: 'Shopify Signatures' },
    ],
  },
  {
    eyebrow: 'More',
    links: [
      { href: '/faq',                                 label: 'Frequently Asked Questions (FAQ)' },
      { href: '/about',                               label: 'About Us' },
      { href: '/contact',                             label: 'Contact Us' },
      { href: '/terms',                               label: 'Terms of Service' },
      { href: '/privacy',                             label: 'Privacy Policy' },
      { href: '#cookie-preferences',                  label: 'Cookie Preferences', isCookieTrigger: true },
    ],
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <!-- Link grid -->
    <div class="footer-grid">
      {columns.map(({ eyebrow, links }) => (
        <div class="footer-col">
          <p class="type-mono-caps footer-eyebrow">{eyebrow}</p>
          <ul role="list" class="footer-link-list">
            {links.map((link) => (
              <li>
                {link.isCookieTrigger ? (
                  <button type="button" class="footer-link-btn" data-open-cookie-settings>
                    {link.label}
                  </button>
                ) : (
                  <a href={link.href} class="footer-link">{link.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <hr class="divider" style="margin-block: 0 24px;" />

    <!-- Bottom strip -->
    <div class="footer-bottom">
      <div class="footer-bottom-info">
        <p class="type-meta text-mute" style="margin: 0;">
          © {year} CMS Detector AI. All rights reserved. Free, evidence-based CMS detection powered by Cloudflare edge workers.
        </p>
        <p class="type-meta text-mute" style="margin: 4px 0 0 0;">
          Compliant with Google AdSense, Search Console & GDPR. No personal URL tracking.
        </p>
      </div>

      <a href="/" class="wordmark-footer" aria-label="CMS Detector AI home">
        <span class="brand-dot-glow" aria-hidden="true"></span>
        <span style="font-size:14px; font-weight:600; color:var(--color-ash); letter-spacing: -0.01em;">
          CMS Detector AI
        </span>
      </a>
    </div>
  </div>
</footer>

<!-- Reserved collapsed ad container — zero layout shift until ads are active -->
<div id="ad-footer-container" aria-hidden="true" style="display:none; overflow:hidden; block-size:0;"></div>

<style>
  .footer {
    background-color: #08080a;
    color: var(--color-on-primary);
    padding-block: var(--spacing-section-lg) var(--spacing-section);
    border-block-start: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-xl);
    margin-block-end: var(--spacing-section);
  }

  .footer-eyebrow {
    color: var(--color-mute);
    margin: 0 0 16px 0;
    letter-spacing: 0.08em;
  }

  .footer-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-size: 13.5px;
    color: var(--color-ash);
    transition: color 0.15s ease;
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-on-primary);
  }

  .footer-link-btn {
    background: transparent;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 13.5px;
    color: var(--color-ash);
    cursor: pointer;
    text-align: left;
    transition: color 0.15s ease;
  }

  .footer-link-btn:hover {
    color: var(--color-on-primary);
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .footer-bottom-info {
    max-width: 680px;
  }

  .wordmark-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    padding: 6px 12px;
    border-radius: var(--radius-app-md);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: border-color 0.15s ease;
  }

  .wordmark-footer:hover {
    border-color: rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
