---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import NavIcon from '../components/layout/NavIcon.astro';
import ThemeCard from '../components/ThemeCard.astro';

const faqs = [
  {
    q: 'What is a Shopify theme detector?',
    a: 'A Shopify theme detector is a free online tool that scans any Shopify store\'s publicly accessible storefront code in real time to identify the active theme, official Shopify Theme Store template, storefront theme ID, version, and custom modifications powering the store.',
  },
  {
    q: 'How does this Shopify theme detector work?',
    a: 'Our Shopify theme detector uses an automated Cloudflare edge inspector to fetch and analyze the store\'s HTML DOM and storefront scripts. It extracts the global Shopify.theme configuration object, BOOMR analytics markers, and asset links (e.g. cdn.shopify.com), then matches the theme ID and fingerprint against the official Shopify Theme Store catalog.',
  },
  {
    q: 'Can this Shopify theme detector identify custom or renamed themes?',
    a: 'Yes. Merchants frequently rename their active theme (for example, naming it after their brand). Our detector extracts both the merchant\'s custom name and the underlying base theme (such as Dawn, Prestige, or Impulse) by inspecting theme_store_id and core asset signatures.',
  },
  {
    q: 'What does it mean if the detector says "Headless Shopify" or "Theme Data Undetected"?',
    a: 'When an e-commerce brand builds a headless Shopify store (using technologies like Shopify Hydrogen, Next.js, or Remix via the Shopify Storefront API), standard Liquid templates and Shopify.theme objects are absent from the browser DOM. Our detector confirms that Shopify powers the e-commerce backend while indicating that a custom headless frontend is deployed.',
  },
  {
    q: 'How do I manually check what Shopify theme a website is using?',
    a: 'To check manually: right-click any page and select "View Page Source" (Ctrl+U or Cmd+Option+U). Press Ctrl+F and search for "Shopify.theme". Look for the JSON object with "name" and "theme_store_id". If theme_store_id is null, it is a custom theme; if an ID is present, it corresponds to an official theme in the Shopify Theme Store.',
  },
  {
    q: 'Can I find out what theme version a Shopify store is running?',
    a: 'Yes. When the theme developer or merchant includes version metadata in theme schema settings or asset headers, our Shopify theme detector displays the exact release version or confirms Online Store 2.0 architecture.',
  },
  {
    q: 'Is this Shopify theme detector completely free to use?',
    a: 'Yes. Our Shopify theme detector is 100% free with unlimited store lookups. No sign-up, email registration, or browser extensions are required.',
  },
];
---
<Base
  title="Shopify Theme Detector — Free Tool to Find Any Shopify Theme | CMS Detector AI"
  description="Free Shopify theme detector to find what Shopify theme any store is using. Reveal theme name, official Theme Store link, custom modifications, and store ID."
  pagePath="/shopify-theme-detector"
  canonical="https://cmsdetectorai.com/shopify-theme-detector"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Shopify Theme Detector',
      url: 'https://cmsdetectorai.com/shopify-theme-detector',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'All',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'Free Shopify theme detector to identify any Shopify store\'s theme, parent template, version, and storefront theme ID in real time.',
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://cmsdetectorai.com',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Shopify Theme Detector',
          item: 'https://cmsdetectorai.com/shopify-theme-detector',
        },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: 'How to detect what Shopify theme a store is using',
      description: 'Step-by-step instructions for finding the Shopify theme powering any e-commerce storefront.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Copy the Shopify store URL',
          text: 'Copy the URL of the Shopify store or product page you want to inspect (e.g. allbirds.com or gymshark.com).',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Paste into the Shopify Theme Detector',
          text: 'Paste the store address into the search box of the Shopify theme detector.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Click Find Theme',
          text: 'Click Find Theme to initiate the real-time edge analysis.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Inspect theme name, base theme, and ID',
          text: 'Review the active theme name, base Theme Store identity, storefront theme ID, and direct link to the Shopify Theme Store.',
        },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Popular Shopify themes',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Dawn',
          url: 'https://themes.shopify.com/themes/dawn',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Prestige',
          url: 'https://themes.shopify.com/themes/prestige',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Impulse',
          url: 'https://themes.shopify.com/themes/impulse',
        },
      ],
    },
  ]}
>
  <Section theme="dark" class="hero" ariaLabelledby="shopify-h1">
    <div class="container">
      <div style="max-inline-size: 880px;">
        <div class="eyebrow-lockup">
          <div class="badge-glow" style="margin-block-end: 2px; align-self: flex-start;">
            <span class="dot"></span>
            <span>Free Storefront Intelligence · Cloudflare Edge</span>
          </div>
          <span class="eyebrow type-mono-eyebrow eyebrow-with-icon">
            <NavIcon name="shopify" size={16} />Shopify Theme Detector
          </span>
          <h1 id="shopify-h1" class="type-display-xl hero-main-title">
            Shopify Theme Detector<br />
            <span class="hero-h1-sub">Find What Theme Any Shopify Store Is Using</span>
          </h1>
          <p class="type-subtitle text-ash" style="margin: 0; max-inline-size: 640px;">
            Our free <strong>Shopify theme detector</strong> identifies the active theme powering any Shopify store —
            revealing the official Theme Store template, active theme name, storefront theme ID, and version directly from live storefront data.
          </p>
        </div>

        <div style="margin-block-start: var(--spacing-xxl);">
          <form id="shopify-form" class="detect-form" aria-label="Shopify theme detection" novalidate>
            <div class="search-bar">
              <div class="search-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
              </div>
              <label for="shopify-input" class="sr-only">Shopify store URL</label>
              <input
                id="shopify-input"
                type="url"
                inputmode="url"
                autocomplete="url"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                class="search-input"
                placeholder="https://store.myshopify.com or domain.com"
                required
              />
              <button type="button" id="shopify-clear-btn" class="search-clear-btn" aria-label="Clear input" hidden>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
              <button type="submit" class="btn btn-primary search-btn" id="shopify-submit">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <span>Find Theme</span>
              </button>
            </div>

            <!-- Quick presets -->
            <div class="preset-bar">
              <span class="type-mono-caps text-mute preset-lbl">Try:</span>
              <div class="preset-chips">
                <button type="button" class="preset-chip" data-shopify-example="allbirds.com">allbirds.com</button>
                <button type="button" class="preset-chip" data-shopify-example="gymshark.com">gymshark.com</button>
                <button type="button" class="preset-chip" data-shopify-example="kyliecosmetics.com">kyliecosmetics.com</button>
              </div>
            </div>

            <div class="search-note type-caption text-mute">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span>Automated &amp; private theme audit. Submitted stores are evaluated in real time without storing browsing history.</span>
            </div>
          </form>

          {/* Progress / Loading steps */}
          <div id="shopify-loading" hidden aria-live="polite" aria-busy="true" style="margin-block-start: var(--spacing-xl);">
            <div class="card-dark shopify-loading-card">
              <div class="shopify-loading-head">
                <div class="shopify-loading-spinner" aria-hidden="true"></div>
                <div>
                  <p class="type-mono-caps text-mute" style="margin: 0;">Edge Inspector</p>
                  <p class="type-heading-sm" style="color: var(--color-on-primary); margin: 2px 0 0 0;" id="shopify-loading-status">Analyzing Shopify storefront...</p>
                </div>
              </div>
              <div class="shopify-scan-steps">
                <div class="shopify-scan-step active" id="shopify-step-1">
                  <span class="shopify-step-dot"></span>
                  <span>Connecting to store domain &amp; verifying SSL handshake</span>
                </div>
                <div class="shopify-scan-step" id="shopify-step-2">
                  <span class="shopify-step-dot"></span>
                  <span>Scanning HTML DOM for Shopify storefront indicators</span>
                </div>
                <div class="shopify-scan-step" id="shopify-step-3">
                  <span class="shopify-step-dot"></span>
                  <span>Extracting Shopify.theme configuration &amp; BOOMR analytics</span>
                </div>
                <div class="shopify-scan-step" id="shopify-step-4">
                  <span class="shopify-step-dot"></span>
                  <span>Matching Shopify Theme Store catalog &amp; resolving custom names</span>
                </div>
              </div>
            </div>
          </div>

          {/* Result Output */}
          <div id="shopify-result" hidden aria-live="polite" style="margin-block-start: var(--spacing-xl);"></div>

          {/* Error Message */}
          <div id="shopify-error" hidden aria-live="assertive" role="alert" style="margin-block-start: var(--spacing-xl);"></div>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 1: How it works */}
  <Section theme="light" ariaLabelledby="shopify-how-to" class="seo-content-section">
    <div class="container">
      <div style="max-inline-size: 880px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xl);">
          <span class="eyebrow" style="color: var(--color-mute);">Edge Inspection Workflow</span>
          <h2 id="shopify-how-to" class="type-display-sm" style="color: var(--color-ink);">
            How Our Shopify Theme Detector Works
          </h2>
          <p class="type-subtitle" style="color: var(--color-slate);">
            Every Shopify storefront serves public assets and runtime configurations that declare the active theme architecture. Here is how our detector audits any store in seconds:
          </p>
        </div>

        <div class="guide-steps-grid">
          <div class="guide-step-card">
            <div class="guide-step-num">01</div>
            <h3 class="guide-step-title">Submit Store Domain or URL</h3>
            <p class="guide-step-text">
              Enter any Shopify storefront domain or product URL. Our edge inspector initiates an isolated HTTPS handshake with the origin server without downloading tracking pixels or executing client cookies in your browser.
            </p>
          </div>
          <div class="guide-step-card">
            <div class="guide-step-num">02</div>
            <h3 class="guide-step-title">Extract Storefront Theme Objects</h3>
            <p class="guide-step-text">
              The detector scans HTML markup for global JavaScript configurations like <code>window.Shopify.theme</code>, storefront analytics beacons, and CDN paths (<code>cdn.shopify.com</code>) that reveal the theme slug and store ID.
            </p>
          </div>
          <div class="guide-step-card">
            <div class="guide-step-num">03</div>
            <h3 class="guide-step-title">Match Official Theme Store Catalog</h3>
            <p class="guide-step-text">
              We cross-reference the extracted <code>theme_store_id</code> against the official Shopify Theme Store database. If the merchant renamed an official theme (like Dawn or Prestige), we unmask both the custom name and the official base theme.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 2: Why Use This Tool */}
  <Section theme="dark" ariaLabelledby="shopify-features-h2" class="seo-content-section">
    <div class="container">
      <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
        <span class="eyebrow type-mono-eyebrow">Key Capabilities</span>
        <h2 id="shopify-features-h2" class="type-display-sm" style="color: var(--color-on-primary);">
          Why Use Our Free Shopify Theme Detector?
        </h2>
        <p class="type-subtitle text-ash" style="max-inline-size: 680px;">
          Built for e-commerce developers, store owners, and competitive researchers who need accurate theme intelligence without digging through source code:
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <h3 class="feature-title">Official Base Theme Resolution</h3>
          <p class="feature-desc">
            Many merchants rename their themes to disguise their starting point. Our detector peers through merchant renaming to show you the exact commercial theme base purchased from Shopify.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3 class="feature-title">Shopify Theme Store Direct Link</h3>
          <p class="feature-desc">
            Get instant, one-click access to the official Shopify Theme Store page where you can preview demos, check current pricing, explore reviews, and buy the theme for your own store.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h3 class="feature-title">Storefront &amp; Theme IDs</h3>
          <p class="feature-desc">
            Extract internal Shopify theme IDs (<code>theme_id</code> and <code>theme_store_id</code>) with one-click copying for developer audits, theme migrations, and technical QA.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3 class="feature-title">Online Store 2.0 &amp; Headless Check</h3>
          <p class="feature-desc">
            Easily discover if an e-commerce brand is using standard Online Store 2.0 Liquid sections, custom theme extensions, or a custom headless setup powered by Shopify Hydrogen and Next.js.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3 class="feature-title">100% Free &amp; Instant Edge Audit</h3>
          <p class="feature-desc">
            Zero subscription fees, no rate limits, and no browser extensions to install. Audits complete in under 2 seconds via distributed Cloudflare edge workers.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="feature-title">Completely Private &amp; Anonymous</h3>
          <p class="feature-desc">
            We respect merchant privacy. Queries are processed in ephemeral memory without recording user histories, logging IP addresses, or storing sensitive checkout session cookies.
          </p>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 3: Manual Detection Guide */}
  <Section theme="light" ariaLabelledby="shopify-manual-h2" class="seo-content-section">
    <div class="container">
      <div style="max-inline-size: 880px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xl);">
          <span class="eyebrow" style="color: var(--color-mute);">Developer Guide</span>
          <h2 id="shopify-manual-h2" class="type-display-sm" style="color: var(--color-ink);">
            How to Find a Shopify Theme Manually (in Page Source)
          </h2>
          <p class="type-subtitle" style="color: var(--color-slate);">
            If you want to manually verify the theme code without using an automated tool, follow this 4-step browser inspection process:
          </p>
        </div>

        <div class="manual-guide-box">
          <ol class="manual-steps-list">
            <li>
              <strong>Open Page Source:</strong> Visit the Shopify store in Google Chrome, Safari, or Firefox. Right-click anywhere on the page and select <em>View Page Source</em>, or press <kbd>Ctrl + U</kbd> (<kbd>Cmd + Option + U</kbd> on macOS).
            </li>
            <li>
              <strong>Search for the Theme Object:</strong> Press <kbd>Ctrl + F</kbd> (<kbd>Cmd + F</kbd>) to open the search bar, then search for <code>Shopify.theme</code>.
            </li>
            <li>
              <strong>Inspect the JSON Config:</strong> Locate the inline script containing the theme declaration. It typically looks like:
              <div class="code-preview">
                <pre><code>Shopify.theme = &#123;
  "name": "Prestige Custom v7.1",
  "id": 142839218394,
  "theme_store_id": 887,
  "role": "main"
&#125;;</code></pre>
              </div>
            </li>
            <li>
              <strong>Understand the Properties:</strong>
              <ul class="sub-bullets">
                <li><code>name</code>: The name the store owner gave the theme inside their Shopify admin.</li>
                <li><code>theme_store_id</code>: If this is an integer (e.g. <code>887</code> or <code>796</code>), the theme originated from the official Shopify Theme Store. If it is <code>null</code>, the theme is a 100% custom-coded theme built from scratch.</li>
                <li><code>id</code>: The unique numerical ID assigned to this published theme in the merchant's store files.</li>
              </ul>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </Section>

  {/* Popular Themes Section */}
  <Section theme="light" ariaLabelledby="shopify-popular-h2">
    <div class="container">
      <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-lg);">
        <span class="eyebrow type-mono-eyebrow">Popular Themes</span>
        <h2 id="shopify-popular-h2" class="type-display-sm" style="color: var(--color-ink); margin: 0;">
          Widely Used Shopify Themes Detected by Our Tool
        </h2>
        <p class="type-body" style="color: var(--color-slate); margin: 0; max-inline-size: 680px;">
          These top-ranking official Shopify themes power millions of successful e-commerce stores worldwide.
          Paste any store URL in our <strong>Shopify theme detector</strong> above to see if it is running one of these templates or a custom variation.
        </p>
      </div>
      <div class="theme-grid">
        <ThemeCard
          name="Dawn"
          maker="Shopify"
          category="Free · Online Store 2.0"
          availability="Free"
          description="Shopify's free, open-source reference theme for Online Store 2.0. Minimalist and media-forward, with JSON templates and app blocks on every page — the default starting point for lean catalogs and custom builds."
          features={[
            'Free with JSON templates and app blocks',
            'Media-forward product pages and filtering',
            'Performance-focused, HTML-first codebase',
          ]}
          href="https://themes.shopify.com/themes/dawn"
          linkLabel="View Dawn in the Theme Store"
          previewLabel="themes.shopify.com/themes/dawn"
          imageSrc="/themes/dawn.webp"
          imageWidth={800}
          imageHeight={999}
          imageAlt="Preview of the Dawn theme demo storefront with a fashion hero image and product grid"
        />
        <ThemeCard
          name="Prestige"
          maker="Maestrooo"
          category="Premium · Editorial luxury"
          availability="Premium — paid theme"
          description="Premium theme aimed at high-end brands, built around editorial storytelling: lookbooks, collection navigation, and product discovery features that support larger catalogs without losing a luxury feel."
          features={[
            'Editorial sections for brand storytelling',
            'Collection navigation, filtering, and mega menu',
            'Product discovery: search, swatches, recently viewed',
          ]}
          href="https://themes.shopify.com/themes/prestige"
          linkLabel="View Prestige in the Theme Store"
          previewLabel="themes.shopify.com/themes/prestige"
          imageSrc="/themes/prestige.webp"
          imageWidth={800}
          imageHeight={999}
          imageAlt="Preview of the Prestige theme demo store with an editorial hero and best-sellers row"
        />
        <ThemeCard
          name="Impulse"
          maker="Archetype Themes"
          category="Premium · Promotions"
          availability="Premium — paid theme"
          description="Promotion-led premium theme for fashion and high-traffic stores. Combines a shoppable hero with sale banners and conversion-oriented sections, backed by catalog tooling for stores running frequent campaigns."
          features={[
            'Shoppable hero and promo banners',
            'Mega menu and collection-page navigation',
            'Built for frequent sales and campaign turnover',
          ]}
          href="https://themes.shopify.com/themes/impulse"
          linkLabel="View Impulse in the Theme Store"
          previewLabel="themes.shopify.com/themes/impulse"
          imageSrc="/themes/impulse.webp"
          imageWidth={800}
          imageHeight={999}
          imageAlt="Preview of the Impulse theme demo store with a shoppable fashion hero and collection tiles"
        />
      </div>
      <p class="type-caption" style="color: var(--color-mute); margin: var(--spacing-lg) 0 0 0;">
        Premium themes are paid — see the Shopify Theme Store for current pricing.
      </p>
    </div>
  </Section>

  {/* Frequently Asked Questions */}
  <Section theme="light" ariaLabelledby="shopify-faq-h2" class="seo-content-section">
    <div class="container">
      <div style="max-inline-size: 880px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
          <span class="eyebrow" style="color: var(--color-mute);">Frequently Asked Questions</span>
          <h2 id="shopify-faq-h2" class="type-display-sm" style="color: var(--color-ink);">
            Shopify Theme Detector FAQ
