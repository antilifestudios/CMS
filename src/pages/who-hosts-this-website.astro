---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import NavIcon from '../components/layout/NavIcon.astro';
---
<Base
  title="Who Hosts This Website? — Free Hosting & CDN Detector"
  description="Find out who hosts any website — including CDN, server software, and cloud provider — in seconds. Free, evidence-based."
  pagePath="/who-hosts-this-website"
>
  <Section theme="dark" style="min-block-size: 60vh; display: flex; align-items: center;" ariaLabelledby="hosting-h1">
    <div class="container">
      <div style="max-inline-size: 860px;">
        <div class="eyebrow-lockup">
          <span class="eyebrow type-mono-eyebrow eyebrow-with-icon"><NavIcon name="hosting" size={16} />Hosting & CDN Detector</span>
          <h1 id="hosting-h1" class="type-display-xl" style="color: var(--color-on-primary); margin: 0;">
            Who Hosts This Website?
          </h1>
          <p class="type-subtitle text-ash" style="margin: 0; max-inline-size: 540px;">
            Find out which hosting provider and CDN any website uses — Vercel, Netlify,
            Cloudflare, AWS CloudFront, and more — from HTTP response headers.
          </p>
        </div>
        <div style="margin-block-start: var(--spacing-xxl);">
          <form id="hosting-form" novalidate>
            <div style="display: flex; gap: 8px;">
              <label for="hosting-input" class="sr-only">Website URL</label>
              <input id="hosting-input" type="url" class="input url-input" placeholder="https://example.com" required />
              <button type="submit" class="btn btn-primary detect-btn" id="hosting-submit">Find Host</button>
            </div>
          </form>
          <div id="hosting-loading" hidden style="margin-block-start: 24px;"><div class="skeleton-card"><div class="skeleton" style="block-size:32px;inline-size:50%;border-radius:4px;"></div><div class="skeleton" style="block-size:20px;inline-size:70%;border-radius:4px;margin-block-start:8px;"></div></div></div>
          <div id="hosting-result" hidden style="margin-block-start: 24px;"></div>
          <div id="hosting-error"  hidden style="margin-block-start: 24px;"></div>
        </div>
      </div>
    </div>
  </Section>
</Base>
<style>
  .eyebrow-with-icon { display: inline-flex; align-items: center; gap: 8px; }
  .eyebrow-with-icon svg { flex-shrink: 0; display: block; }
  .url-input { flex: 1; block-size: 56px; font-size: 17px; border-radius: var(--radius-app-lg); padding-inline: var(--spacing-lg); background-color: rgba(255,255,255,0.06); border: 1px solid var(--color-hairline-soft); color: var(--color-on-primary); }
  .url-input:focus { outline: none; border-color: rgba(255,255,255,0.5); }
  .url-input::placeholder { color: var(--color-slate-soft); }
  .detect-btn { block-size: 56px; }
  .skeleton-card { background: var(--color-canvas-soft); border-radius: var(--radius-marketing); padding: var(--spacing-xl); border: 1px solid var(--color-hairline-soft); display: flex; flex-direction: column; gap: 12px; }
</style>
<script>
const form   = document.getElementById('hosting-form')   as HTMLFormElement | null;
const input  = document.getElementById('hosting-input')  as HTMLInputElement | null;
const btn    = document.getElementById('hosting-submit') as HTMLButtonElement | null;
const loadEl = document.getElementById('hosting-loading') as HTMLElement | null;
const resEl  = document.getElementById('hosting-result') as HTMLElement | null;
const errEl  = document.getElementById('hosting-error')  as HTMLElement | null;
function esc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
input?.focus();
form?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const url = input?.value.trim() ?? '';
  if (!url) return;
  if (loadEl) loadEl.hidden = false;
  if (resEl)  resEl.hidden = true;
  if (errEl)  errEl.hidden = true;
  if (btn)    { btn.disabled = true; btn.textContent = 'Detecting…'; }
  try {
    const token = await ((window as any).cmsDetectorToken ? (window as any).cmsDetectorToken() : '');
    const res = await fetch('/api/detect', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ url, token }) });
    const data = await res.json() as any;
    if (loadEl) loadEl.hidden = true;
    if (btn) { btn.disabled = false; btn.textContent = 'Find Host'; }
    if (data.ok) {
      const hosting = (data.data.results ?? []).filter((r: any) => r.category === 'hosting' && (r.confidenceLabel === 'confirmed' || r.confidenceLabel === 'likely'));
      if (hosting.length === 0) {
        if (resEl) { resEl.innerHTML = `<div class="card-dark"><p class="type-body-sm text-ash">Hosting provider couldn't be determined from available signals. The site may use a custom or unlisted provider.</p></div>`; resEl.hidden = false; }
      } else {
        if (resEl) {
          resEl.innerHTML = `<div class="card-dark">
            <p class="type-mono-caps text-mute" style="margin:0 0 12px 0;">Hosting & CDN detected</p>
            ${hosting.map((h: any) => `
              <div style="display:flex;align-items:center;gap:8px;margin-block-end:8px;">
                <span class="type-heading-sm" style="color:var(--color-on-primary)">${esc(h.name)}</span>
                <span class="badge chip-${h.confidenceLabel}">${h.confidenceLabel}</span>
              </div>`).join('')}
          </div>`;
          resEl.hidden = false;
        }
      }
    } else {
      if (errEl) { errEl.innerHTML = `<div class="card-dark"><p class="type-body-sm text-ash">Detection failed: ${esc(data.error?.code ?? 'UNKNOWN')}</p></div>`; errEl.hidden = false; }
    }
  } catch {
    if (loadEl) loadEl.hidden = true;
    if (btn) { btn.disabled = false; btn.textContent = 'Find Host'; }
    if (errEl) { errEl.innerHTML = `<div class="card-dark"><p class="type-body-sm text-ash">Network error.</p></div>`; errEl.hidden = false; }
  }
});
</script>
