---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CoverageDirectory from '../components/CoverageDirectory.astro';
import NavIcon from '../components/layout/NavIcon.astro';

const groups = [
  {
    label: 'Privacy / Consent',
    blurb: 'Consent managers matched by SDK scripts, JS APIs, and platform cookies.',
    items: ['OneTrust', 'Cookiebot', 'Usercentrics', 'TrustArc', 'iubenda', 'Complianz', 'Didomi', 'Osano', 'CookieYes', 'Termly', 'Quantcast Choice'],
  },
  {
    label: 'Security & Monitoring',
    blurb: 'Bot protection and error tracking matched by SDK, init calls, and cookies.',
    items: ['reCAPTCHA', 'hCaptcha', 'Sentry', 'Cloudflare Turnstile', 'Fingerprint', 'Datadog', 'New Relic', 'Bugsnag', 'Rollbar'],
  },
  {
    label: 'Other technologies',
    blurb: 'Supporting technologies identified from technical evidence.',
    note: 'Controlled fallback — only reported with identifiable integration evidence, never a weak guess.',
    items: ['Cloudinary', 'Algolia', 'Google Maps', 'YouTube', 'Vimeo', 'Font Awesome'],
  },
];

const faqs = [
  {
    q: 'Is this site safe?',
    a: 'A website is considered safe to visit when it has no listings in active threat-intelligence feeds (such as malware distribution, phishing, or scam databases), enforces modern HTTPS encryption, maintains secure HTTP response headers, does not engage in deceptive redirects or homograph attacks, and protects user data.',
  },
  {
    q: 'How can I check if a website is safe?',
    a: 'Enter the full domain or URL into the safety checker above and click "Check Website Safety". Our tool analyzes the site in real time across multiple dimensions: threat intelligence databases, SSL/TLS transport encryption, HTTP to HTTPS redirect enforcement, browser security headers (CSP, HSTS, X-Frame-Options), URL structure heuristics, and DNS infrastructure signals.',
  },
  {
    q: 'How can I tell if a website is a scam?',
    a: 'Common indicators of scam websites include deceptive domain names (like subtle misspellings of popular brands), requests for sensitive login or credit card data over unverified connections, excessive or misleading cross-domain redirects, absence of authentic company identity or verifiable contact details, and newly registered domains using suspicious subdomain chains.',
  },
  {
    q: 'Can a website have HTTPS and still be dangerous?',
    a: 'Yes. Modern SSL/TLS certificates only verify that the connection between your browser and the website server is encrypted. Anyone, including phishers and scam artists, can obtain a free SSL certificate. HTTPS prevents network eavesdropping, but it does not vouch for the legitimacy or intentions of the website operator.',
  },
  {
    q: 'Does this checker detect malware and phishing?',
    a: 'Yes. The scanner queries live threat-intelligence feeds (including Cloudflare Security Threat Intelligence and available threat databases) for confirmed malicious distribution, sinkholes, and phishing campaigns, alongside heuristic detection for deceptive Punycode/homograph domains and suspicious URL patterns.',
  },
  {
    q: 'What should I do if a website is flagged as dangerous?',
    a: 'If a site is flagged with a confirmed threat or critical security concern, do not enter passwords, credit card numbers, or personal information, and do not download or run any files from it. If you own the website, check your server for compromised files, inspect third-party script integrations, and verify your DNS records.',
  },
  {
    q: 'Why might a scan return incomplete results?',
    a: 'Scans may be incomplete if the target website is temporarily unreachable, blocks automated security scanners via aggressive web application firewalls (WAFs), times out during connection negotiation, or uses a private or restricted network address.',
  },
  {
    q: 'Is this website safety checker free?',
    a: 'Yes, this tool is 100% free with no account registration or payment required. You can run checks on any public website or link at any time.',
  },
  {
    q: 'Does the tool store the URLs I submit?',
    a: 'No. Submitted URLs are processed in real time purely to perform the requested security checks and are cached ephemerally for performance. We do not store your personal browsing history, track user identifiers, or log sensitive authentication query tokens.',
  },
];
---
<Base
  title="Is This Site Safe? Free Website Safety Checker | CMS Detector AI"
  description="Check a website for known malware, phishing threats, suspicious redirects, domain reputation signals, and HTTPS security issues before you visit."
  pagePath="/security-privacy-detector"
  canonical="https://cmsdetectorai.com/security-privacy-detector"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Is This Site Safe? Website Safety Checker',
      url: 'https://cmsdetectorai.com/security-privacy-detector',
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'All',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'Check a website for known malware, phishing threats, suspicious redirects, domain reputation signals, and HTTPS security issues before you visit.',
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
      inLanguage: 'en',
    },
  ]}
>
  {/* Hero / Interactive Checker */}
  <Section theme="dark" class="sp-hero-section" ariaLabelledby="sec-h1">
    <div class="container">
      <div class="sp-hero-shell">
        <div class="eyebrow-lockup">
          <div class="badge-glow" style="margin-block-end: 2px; align-self: flex-start;">
            <span class="dot"></span>
            <span>Real-Time Threat Intelligence · Cloudflare Edge</span>
          </div>
          <div class="sp-eyebrow-row">
            <span class="eyebrow type-mono-eyebrow eyebrow-with-icon">
              <NavIcon name="security" size={16} />Website Safety &amp; Security Checker
            </span>
          </div>
          <h1 id="sec-h1" class="type-display-xl sp-hero-title">
            Is This Site Safe?
          </h1>
          <p class="type-subtitle text-ash sp-hero-sub">
            Inspect any domain for known malware, phishing threats, deceptive redirects, domain reputation signals, and HTTPS security vulnerabilities before you visit.
          </p>
        </div>

        <div class="sp-scanner-container">
          <div class="sp-detector" id="sp-root">
            <form id="sp-form" class="sp-form" novalidate aria-label="Website Safety Checker">
              <div class="sp-search-bar">
                <div class="sp-search-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                </div>
                <label for="sp-input" class="sr-only">Website URL or Domain</label>
                <input
                  id="sp-input"
                  type="url"
                  inputmode="url"
                  autocomplete="url"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  class="sp-url-input"
                  placeholder="https://example.com or domain.com"
                  required
                />
                <button type="button" id="sp-clear-btn" class="sp-clear-btn" aria-label="Clear input" hidden>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </button>
                <button type="submit" class="btn btn-primary sp-detect-btn" id="sp-submit">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                  <span>Check Website Safety</span>
                </button>
              </div>

              {/* Quick Presets */}
              <div class="sp-preset-bar">
                <span class="type-mono-caps text-mute sp-preset-lbl">Try:</span>
                <div class="sp-preset-chips">
                  <button type="button" class="sp-preset-chip" data-preset="stripe.com">stripe.com</button>
                  <button type="button" class="sp-preset-chip" data-preset="cloudflare.com">cloudflare.com</button>
                  <button type="button" class="sp-preset-chip" data-preset="github.com">github.com</button>
                  <button type="button" class="sp-preset-chip" data-preset="wikipedia.org">wikipedia.org</button>
                </div>
              </div>

              {/* Privacy Reassurance Note */}
              <div class="sp-privacy-note type-caption text-mute">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>Automated &amp; private edge scan. Submitted domains are evaluated in real time without storing browsing history.</span>
              </div>
            </form>

            {/* Recent Searches */}
            <div id="sp-recent" class="sp-recent" hidden>
              <span class="type-mono-caps text-mute">Recent:</span>
              <ul id="sp-recent-list" role="list" class="sp-recent-list"></ul>
              <button type="button" id="sp-recent-clear" class="sp-recent-clear type-caption">Clear</button>
            </div>

            {/* High-Tech Animated Radar Loading Card */}
            <div id="sp-loading" class="sp-loading" hidden aria-live="polite" aria-busy="true">
              <div class="sp-loading-card">
                <div class="sp-loading-head">
                  <div class="sp-radar-spinner" aria-hidden="true"></div>
                  <div class="sp-loading-titles">
                    <span class="type-mono-caps text-brand">Running Multi-Vector Security Scan</span>
                    <h3 class="sp-loading-headline" id="sp-loading-status-text">Connecting to destination edge node…</h3>
                  </div>
                </div>
                <div class="sp-scan-progress-bar">
                  <div class="sp-scan-progress-fill"></div>
                </div>
                <div class="sp-scan-steps">
                  <div class="sp-scan-step active" id="sp-step-1">
                    <span class="sp-step-dot"></span>
                    <span>Querying Cloudflare Security Threat Intelligence &amp; malware feeds</span>
                  </div>
                  <div class="sp-scan-step" id="sp-step-2">
                    <span class="sp-step-dot"></span>
                    <span>Auditing SSL/TLS transport encryption &amp; HTTP downgrade redirects</span>
                  </div>
                  <div class="sp-scan-step" id="sp-step-3">
                    <span class="sp-step-dot"></span>
                    <span>Verifying browser security headers (CSP, HSTS, X-Frame-Options)</span>
                  </div>
                  <div class="sp-scan-step" id="sp-step-4">
                    <span class="sp-step-dot"></span>
                    <span>Checking DNSSEC cryptographic records &amp; CAA authority policies</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Result Report Container */}
            <div id="sp-result" class="sp-result" hidden aria-live="polite"></div>

            {/* Error Message Alert */}
            <div id="sp-error" class="sp-error" hidden aria-live="assertive" role="alert"></div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 1: How to check */}
  <Section theme="light" ariaLabelledby="sec-how-to" class="sp-how-to-section">
    <div class="container">
      <div style="max-inline-size: 860px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xl);">
          <span class="eyebrow" style="color: var(--color-mute);">Step-by-step verification</span>
          <h2 id="sec-how-to" class="type-display-sm" style="color: var(--color-ink);">
            How to Check If a Website Is Safe
          </h2>
          <p class="type-subtitle" style="color: var(--color-slate);">
            Before clicking unfamiliar links, downloading attachments, or entering credentials, take these simple verification steps:
          </p>
        </div>

        <div class="sp-guide-grid">
          <div class="sp-guide-card">
            <div class="sp-guide-num">01</div>
            <h3 class="sp-guide-title">Submit the Exact Link or Domain</h3>
            <p class="sp-guide-text">
              Paste the full website URL (e.g. <code>https://example.com</code> or <code>example.com</code>) into the safety checker above. Our tool inspects the destination safely on our edge servers without exposing your local device or IP address.
            </p>
          </div>
          <div class="sp-guide-card">
            <div class="sp-guide-num">02</div>
            <h3 class="sp-guide-title">Examine the Overall Safety Verdict</h3>
            <p class="sp-guide-text">
              Review the primary verdict badge and Safety Score. The verdict highlights whether known threats, phishing patterns, suspicious redirects, or weak transport encryption were discovered.
            </p>
          </div>
          <div class="sp-guide-card">
            <div class="sp-guide-num">03</div>
            <h3 class="sp-guide-title">Review Key Findings &amp; Technical Evidence</h3>
            <p class="sp-guide-text">
              Expand the detailed findings to inspect SSL/TLS certificates, HTTP-to-HTTPS redirect rules, security response headers (CSP, HSTS), and detected consent or privacy technologies.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 2: What we check */}
  <Section theme="dark" ariaLabelledby="sec-what-checked" class="sp-checks-section">
    <div class="container">
      <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
        <span class="eyebrow type-mono-eyebrow">Comprehensive Inspection Engine</span>
        <h2 id="sec-what-checked" class="type-display-sm" style="color: var(--color-on-primary);">
          What Does This Website Safety Checker Check?
        </h2>
        <p class="type-subtitle text-ash" style="max-inline-size: 680px;">
          Rather than relying on superficial guesses, our scanner performs real, evidence-backed security checks across the entire technical stack:
        </p>
      </div>

      <div class="sp-checks-grid">
        <div class="sp-check-box">
          <div class="sp-check-head">
            <span class="sp-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Threat Intel</span>
          </div>
          <h3 class="sp-check-title">Malware &amp; Phishing Reputation</h3>
          <p class="sp-check-desc">
            Cross-references active threat intelligence (including Cloudflare Security Threat DNS) for known malware distribution, sinkholes, and phishing blacklist listings.
          </p>
        </div>

        <div class="sp-check-box">
          <div class="sp-check-head">
            <span class="sp-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Encryption</span>
          </div>
          <h3 class="sp-check-title">HTTPS &amp; Transport Encryption</h3>
          <p class="sp-check-desc">
            Verifies SSL/TLS availability, tests whether plain HTTP automatically redirects to HTTPS, and scans the HTML for dangerous mixed-content resources.
          </p>
        </div>

        <div class="sp-check-box">
          <div class="sp-check-head">
            <span class="sp-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Hardening</span>
          </div>
          <h3 class="sp-check-title">HTTP Security Headers</h3>
          <p class="sp-check-desc">
            Audits vital browser protection headers including Content-Security-Policy (CSP), Strict-Transport-Security (HSTS), X-Content-Type-Options, X-Frame-Options, and Referrer-Policy.
          </p>
        </div>

        <div class="sp-check-box">
          <div class="sp-check-head">
            <span class="sp-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Routing</span>
          </div>
          <h3 class="sp-check-title">Redirect Path &amp; Downgrade Analysis</h3>
          <p class="sp-check-desc">
            Traces the full redirect chain to detect protocol downgrades (HTTPS back to plain HTTP), excessive redirection loops, and unauthorized cross-domain destinations.
          </p>
        </div>

        <div class="sp-check-box">
          <div class="sp-check-head">
            <span class="sp-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Heuristics</span>
          </div>
          <h3 class="sp-check-title">Domain &amp; URL Heuristics</h3>
          <p class="sp-check-desc">
            Evaluates internationalized Punycode homograph risks, direct IP-address formats, misleading subdomain combinations, and deceptive account-verification keywords.
          </p>
        </div>

        <div class="sp-check-box">
          <div class="sp-check-head">
            <span class="sp-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            </span>
            <span class="type-mono-caps text-mute">DNSSEC</span>
          </div>
          <h3 class="sp-check-title">DNSSEC &amp; CAA Infrastructure</h3>
          <p class="sp-check-desc">
            Resolves public A/AAAA records using Cloudflare DoH, verifies DNSSEC cryptographic integrity, and checks CAA records restricting unauthorized certificate authorities.
          </p>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 3: How to tell & What HTTPS means */}
  <Section theme="light" ariaLabelledby="sec-safety-guide" class="sp-safety-guide-section">
    <div class="container">
      <div style="max-inline-size: 860px; display: flex; flex-direction: column; gap: var(--spacing-xxl);">
        <div>
          <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-lg);">
            <span class="eyebrow" style="color: var(--color-mute);">Practical advice</span>
            <h2 id="sec-safety-guide" class="type-display-sm" style="color: var(--color-ink);">
              How to Tell If a Website Is Safe to Visit
            </h2>
          </div>
          <p class="type-body" style="color: var(--color-slate); line-height: 1.7;">
            While automated scanners catch technical vulnerabilities and confirmed threat listings, staying safe also requires observing practical cues:
          </p>
          <ul class="sp-cues-list">
            <li>
              <span class="sp-cue-bullet" aria-hidden="true">01</span>
              <div><strong>Inspect the exact spelling of the domain:</strong> Phishers often create deceptive lookalike domains with subtle typos or extra hyphens (e.g., <code>paypa1.com</code> or <code>apple-support-verify.com</code>).</div>
            </li>
            <li>
              <span class="sp-cue-bullet" aria-hidden="true">02</span>
              <div><strong>Watch for unexpected cross-domain redirects:</strong> If clicking a link for one site immediately redirects you to a totally unfamiliar domain, proceed with high caution.</div>
            </li>
            <li>
              <span class="sp-cue-bullet" aria-hidden="true">03</span>
              <div><strong>Be skeptical of unsolicited download prompts:</strong> Authentic websites rarely trigger immediate software downloads without clear user interaction.</div>
            </li>
            <li>
              <span class="sp-cue-bullet" aria-hidden="true">04</span>
              <div><strong>Verify company details &amp; contact transparency:</strong> Legitimate web services provide valid corporate identities, physical addresses, and clear privacy policies.</div>
            </li>
          </ul>
        </div>

        <div class="sp-callout-card">
          <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-sm);">
            <span class="type-mono-caps text-brand">Critical Security Truth</span>
            <h2 id="sec-https-truth" class="type-heading-sm" style="color: var(--color-ink); margin: 0;">
              Is HTTPS Enough to Know If a Website Is Safe?
            </h2>
          </div>
          <p class="type-body" style="color: var(--color-slate); line-height: 1.7; margin: 0;">
            <strong>No, HTTPS alone does not guarantee a website is safe or legitimate.</strong> A common misconception is that the padlock icon or an <code>https://</code> URL proves that a site is safe from fraud or malware.
          </p>
          <p class="type-body" style="color: var(--color-slate); line-height: 1.7; margin: 0;">
            In reality, HTTPS simply encrypts communication between your browser and the server, preventing intermediate eavesdropping on Wi-Fi or local networks. Because free automated certificates are available to anyone in seconds, malicious phishing operators frequently secure their fake websites with HTTPS. A safe website requires both encryption <em>and</em> a clean reputation, genuine ownership, and secure web application configurations.
          </p>
        </div>

        <div style="border-block-start: 1px solid var(--color-hairline); padding-block-start: var(--spacing-xxl);">
          <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-lg);">
            <span class="eyebrow" style="color: var(--color-mute);">Interpreting results</span>
            <h2 id="sec-verdicts-explained" class="type-display-sm" style="color: var(--color-ink);">
              What Do the Website Safety Results Mean?
            </h2>
          </div>
          <div class="sp-verdict-grid">
            <div class="sp-verdict-card-light">
              <div class="sp-verdict-card-top">
                <span class="sp-status-dot-glow dot-green"></span>
                <span class="sp-status-title-clean">No Known Threats Detected</span>
              </div>
              <p class="sp-verdict-card-desc">The site has valid HTTPS encryption, active security configurations, and no current malicious reports in active threat feeds. Exercise normal online vigilance.</p>
            </div>
            <div class="sp-verdict-card-light">
              <div class="sp-verdict-card-top">
                <span class="sp-status-dot-glow dot-amber"></span>
                <span class="sp-status-title-warn">Potential Concerns Detected</span>
              </div>
              <p class="sp-verdict-card-desc">No confirmed malware was reported, but configuration weaknesses (such as missing HTTPS redirection, absent CSP headers, mixed content, or suspicious URL structures) were found.</p>
            </div>
            <div class="sp-verdict-card-light">
              <div class="sp-verdict-card-top">
                <span class="sp-status-dot-glow dot-red"></span>
                <span class="sp-status-title-danger">Known Threat Detected</span>
              </div>
              <p class="sp-verdict-card-desc">The domain is actively listed in malware or phishing threat feeds, or engaged in dangerous insecure protocol downgrades. Do not submit sensitive data.</p>
            </div>
            <div class="sp-verdict-card-light">
              <div class="sp-verdict-card-top">
                <span class="sp-status-dot-glow dot-gray"></span>
                <span class="sp-status-title-info">Scan Incomplete</span>
              </div>
              <p class="sp-verdict-card-desc">The target could not be reached, timed out, or blocked automated security checks. Results are inconclusive due to network or firewall barriers.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Supported Technologies Directory (Consent, Security, Embeds) */}
  <Section theme="dark" ariaLabelledby="sec-coverage">
    <div class="container">
      <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
        <span class="eyebrow type-mono-eyebrow">Consent, Protection &amp; Embeds</span>
        <h2 id="sec-coverage" class="type-display-sm" style="color: var(--color-on-primary);">
          Privacy &amp; Security Stack Detection
        </h2>
        <p class="type-subtitle text-ash" style="max-width: 640px;">
          Our detector also recognizes the underlying privacy consent platforms, bot protections, error tracking, and third-party services running on any target website:
        </p>
      </div>
      <CoverageDirectory groups={groups} />
    </div>
  </Section>

  {/* Frequently Asked Questions */}
  <Section theme="light" ariaLabelledby="sec-faq">
    <div class="container">
      <div style="max-inline-size: 860px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
          <span class="eyebrow" style="color: var(--color-mute);">Common questions</span>
