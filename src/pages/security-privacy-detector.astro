    padding-block-end: 14px;
  }
  .sp-sec-title {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    color: var(--color-on-primary);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .sp-sec-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-ash);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sp-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }
  .sp-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .sp-panel {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-app-sm);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.15s ease;
  }
  .sp-panel:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }
  .sp-panel-label {
    margin: 0;
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-mute);
    letter-spacing: 0.05em;
  }
  .sp-panel-value {
    margin: 0;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-on-primary);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sp-panel-desc {
    margin: 0;
    font-size: 12px;
    color: var(--color-ash);
    line-height: 1.5;
  }

  /* Interactive Findings Explorer & Filter Tabs */
  .sp-findings-filter-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-block-end: 4px;
  }
  .sp-filter-btn {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-ash);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .sp-filter-btn:hover, .sp-filter-btn.active {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-on-primary);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .sp-filter-btn.active {
    font-weight: 600;
  }
  .sp-filter-btn .filter-count {
    opacity: 0.7;
    margin-left: 4px;
  }

  .sp-findings-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sp-finding-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-app-sm);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }
  .sp-finding-item:hover {
    border-color: rgba(255, 255, 255, 0.15);
  }
  .sp-finding-item.border-threat   { border-left: 3px solid #ef4444; }
  .sp-finding-item.border-concern  { border-left: 3px solid #f59e0b; }
  .sp-finding-item.border-pass     { border-left: 3px solid #10b981; }
  .sp-finding-item.border-unavail  { border-left: 3px solid #6b7280; }

  .sp-finding-summary {
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .sp-finding-summary::-webkit-details-marker { display: none; }
  .sp-finding-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-inline-size: 0;
  }
  .sp-finding-status-badge {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: var(--radius-app-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  .sp-status-pass       { background-color: rgba(16, 185, 129, 0.15); color: #34d399; }
  .sp-status-concern    { background-color: rgba(245, 158, 11, 0.15); color: #fbbf24; }
  .sp-status-threat     { background-color: rgba(239, 68, 68, 0.15); color: #f87171; }
  .sp-status-unavailable{ background-color: rgba(156, 163, 175, 0.12); color: #9ca3af; }

  .sp-finding-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-on-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sp-finding-body {
    padding: 0 14px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    color: var(--color-ash);
    line-height: 1.5;
    border-block-start: 1px solid rgba(255, 255, 255, 0.04);
    margin-block-start: 4px;
    padding-block-start: 10px;
  }
  .sp-finding-evidence-box {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-app-xs);
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #e5e7eb;
    word-break: break-all;
  }
  .sp-finding-line strong { color: var(--color-on-primary); }

  /* Actions Bar */
  .sp-actions-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-block-start: 8px;
    padding-block-start: 14px;
    border-block-start: 1px solid rgba(255, 255, 255, 0.08);
  }
  .sp-action-btn-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .sp-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-on-primary);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .sp-action-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .sp-error-card {
    background-color: var(--color-canvas-soft);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: var(--radius-app-lg);
    padding: var(--spacing-xl);
  }

  @media (max-width: 768px) {
    .sp-search-bar {
      flex-direction: column;
      border-radius: var(--radius-app-lg);
      padding: 10px;
      gap: 10px;
    }
    .sp-url-input { width: 100%; height: 40px; }
    .sp-detect-btn { width: 100%; }
    .sp-grid-2, .sp-grid-3, .sp-telemetry-grid { grid-template-columns: 1fr; }
    .sp-verdict-top { flex-direction: column; align-items: stretch; }
    .sp-score-lockup { align-self: flex-start; }
  }
</style>

<script>
(() => {
  const root = document.getElementById('sp-root');
  if (!root) return;

  const form = document.getElementById('sp-form');
  const input = document.getElementById('sp-input');
  const clearBtn = document.getElementById('sp-clear-btn');
  const btn = document.getElementById('sp-submit');
  const loadEl = document.getElementById('sp-loading');
  const resEl = document.getElementById('sp-result');
  const errEl = document.getElementById('sp-error');
  const recentEl = document.getElementById('sp-recent');
  const recentList = document.getElementById('sp-recent-list');
  const recentClear = document.getElementById('sp-recent-clear');
  const statusTicker = document.getElementById('sp-loading-status-text');

  const STORAGE_KEY = 'sec_recent';
  const MAX_RECENT = 5;

  let tickerInterval = null;

  const SCAN_STAGES = [
    'Connecting to destination edge node…',
    'Querying Cloudflare Security Threat Intelligence & malware feeds…',
    'Auditing SSL/TLS certificate, ciphers & HTTPS enforcement…',
    'Inspecting browser security headers (CSP, HSTS, X-Frame-Options)…',
    'Evaluating DNSSEC, CAA records & redirect chain routing…',
    'Synthesizing final safety reputation audit report…',
  ];

  const ERROR_MESSAGES = {
    INVALID_URL: 'Please enter a valid website URL or domain (e.g. example.com or https://example.com).',
    PRIVATE_IP: 'Private or internal network addresses cannot be audited for security reasons.',
    FETCH_FAILED: 'Could not connect to the target website. It may be offline, slow, or actively blocking automated scanner probes.',
    TIMEOUT: 'Connection timed out. The target server took too long to answer.',
    NON_HTML: 'The target returned a non-HTML response (such as an image or direct binary download).',
    RATE_LIMITED: 'Rate limit reached — please wait a minute before running another scan.',
    UNKNOWN: 'An unexpected scanning error occurred. Please try again.',
  };

  function esc(s) {
    return String(s ?? '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function normalizeDomain(raw) {
    let s = String(raw ?? '').trim().toLowerCase();
    if (!s) return '';
    s = s.replace(/^https?:\/\//, '');
    s = s.split(/[/?#]/)[0];
    if (s.startsWith('www.')) s = s.slice(4);
    s = s.replace(/:\d+$/, '').replace(/\.+$/, '');
    if (!/^[\w.-]+\.[a-z]{2,}$/i.test(s)) return '';
    return s;
  }

  function loadRecent() {
    try {
      const p = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]');
      if (!Array.isArray(p)) return [];
      return p.filter((u) => typeof u === 'string' && u.length > 0).slice(0, MAX_RECENT);
    } catch { return []; }
  }

  function saveRecent(rawUrl) {
    const domain = normalizeDomain(rawUrl);
    if (!domain) return;
    const list = [domain, ...loadRecent().filter((u) => normalizeDomain(u) !== domain)].slice(0, MAX_RECENT);
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch { /* noop */ }
  }

  function renderRecent() {
    if (!recentList || !recentEl) return;
    recentList.innerHTML = '';
    const list = loadRecent();
    list.forEach((domain) => {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.className = 'sp-recent-btn';
      b.textContent = domain;
      b.title = domain;
      b.type = 'button';
      b.addEventListener('click', () => {
        if (input) {
          input.value = domain;
          updateClearBtn();
        }
        run(domain);
      });
      li.appendChild(b);
      recentList.appendChild(li);
    });
    recentEl.hidden = list.length === 0;
  }

  function updateClearBtn() {
    if (!clearBtn || !input) return;
    clearBtn.hidden = !input.value.trim();
  }

  input?.addEventListener('input', updateClearBtn);
  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
      updateClearBtn();
    }
  });

  // Presets
  document.querySelectorAll('[data-preset]').forEach((btnEl) => {
    btnEl.addEventListener('click', () => {
      const p = btnEl.getAttribute('data-preset');
      if (p && input) {
        input.value = p;
        updateClearBtn();
        run(p);
      }
    });
  });

  function startTicker() {
    if (tickerInterval) clearInterval(tickerInterval);
    let idx = 0;
    if (statusTicker) statusTicker.textContent = SCAN_STAGES[0];
    tickerInterval = setInterval(() => {
      idx = (idx + 1) % SCAN_STAGES.length;
      if (statusTicker) statusTicker.textContent = SCAN_STAGES[idx];
      const stepIdx = (idx % 4) + 1;
      for (let i = 1; i <= 4; i++) {
        const el = document.getElementById(`sp-step-${i}`);
        if (el) el.classList.toggle('active', i === stepIdx);
      }
    }, 1400);
  }

  function stopTicker() {
    if (tickerInterval) {
      clearInterval(tickerInterval);
      tickerInterval = null;
    }
  }

  function setLoading(on) {
    if (!btn || !loadEl || !resEl || !errEl) return;
    if (on) {
      btn.disabled = true;
      btn.innerHTML = '<span>Scanning Website…</span>';
      loadEl.hidden = false;
      resEl.hidden = true;
      errEl.hidden = true;
      startTicker();
    } else {
      btn.disabled = false;
      btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Check Website Safety</span>';
      loadEl.hidden = true;
      stopTicker();
    }
  }

  function showError(err) {
    if (!errEl) return;
    const code = err?.code ?? 'UNKNOWN';
    const msg = err?.message ?? ERROR_MESSAGES[code] ?? ERROR_MESSAGES.UNKNOWN;
    errEl.innerHTML = '<div class="sp-error-card"><span class="badge badge-error">Scan Error</span>'
      + '<p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">' + esc(msg) + '</p></div>';
    errEl.hidden = false;
  }

  function renderReport(data, submittedUrl) {
    const safety = data.safety;
    const categories = Array.isArray(data.categories) ? data.categories : [];
    const host = safety?.scannedHost || normalizeDomain(submittedUrl) || 'Target Host';
    const verdict = safety?.verdict ?? 'no_known_threats';
    const score = Math.max(0, Math.min(100, Math.round(safety?.safetyScore ?? 85)));

    // Score radial calculation (circumference of radius 32 = ~201.06)
    const radius = 32;
    const circumference = 2 * Math.PI * radius;
    const strokeDashoffset = circumference - (score / 100) * circumference;

    let verdictPillClass = 'sp-pill-clean';
    let meterColor = '#10b981';
    if (verdict === 'known_threat') {
      verdictPillClass = 'sp-pill-threat';
      meterColor = '#ef4444';
    } else if (verdict === 'potential_concerns') {
      verdictPillClass = 'sp-pill-concern';
      meterColor = '#f59e0b';
    } else if (verdict === 'incomplete') {
      verdictPillClass = 'sp-pill-inc';
      meterColor = '#9ca3af';
    }

    const stats = safety?.stats ?? { passed: 0, concerns: 0, threats: 0, unavailable: 0 };
    const conn = safety?.connectionSecurity;
    const hdrs = safety?.securityHeaders;
    const dns = safety?.dnsInfrastructure;
    const redirs = safety?.redirectAnalysis;
    const findings = Array.isArray(safety?.findings) ? safety.findings : [];

    // Findings HTML
    const findingsHtml = findings.map((f, idx) => {
      let stBadge = 'sp-status-pass';
      let borderClass = 'border-pass';
      if (f.status === 'threat') {
        stBadge = 'sp-status-threat';
        borderClass = 'border-threat';
      } else if (f.status === 'concern') {
        stBadge = 'sp-status-concern';
        borderClass = 'border-concern';
      } else if (f.status === 'unavailable') {
        stBadge = 'sp-status-unavailable';
        borderClass = 'border-unavail';
      }

      return '<details class="sp-finding-item ' + borderClass + '" data-status="' + esc(f.status) + '" id="finding-' + idx + '">'
        + '<summary class="sp-finding-summary">'
        + '<div class="sp-finding-left">'
        + '<span class="sp-finding-status-badge ' + stBadge + '">' + esc(f.status) + '</span>'
        + '<span class="sp-finding-name">' + esc(f.name) + ' &mdash; ' + esc(f.title) + '</span>'
        + '</div>'
        + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>'
        + '</summary>'
        + '<div class="sp-finding-body">'
        + '<div class="sp-finding-evidence-box">' + esc(f.evidence) + '</div>'
        + '<div class="sp-finding-line"><strong>Why it matters:</strong> ' + esc(f.whyItMatters) + '</div>'
        + (f.remediation ? '<div class="sp-finding-line"><strong>Remediation:</strong> ' + esc(f.remediation) + '</div>' : '')
        + '<div class="sp-finding-line"><span class="type-mono-caps text-mute">Source: ' + esc(f.source) + '</span></div>'
        + '</div>'
        + '</details>';
    }).join('');

    // Tech stacks HTML (Preserves detected vendor platforms)
    const techCount = categories.reduce((n, c) => n + (c.technologies ?? []).length, 0);
    const techHtml = categories.map((c) => {
      const techs = c.technologies ?? [];
      if (techs.length === 0) return '';
      const chips = techs.map((t) =>
        '<span class="badge" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: var(--color-on-primary); font-size: 13px;">'
        + esc(t.name) + ' <span class="text-mute" style="font-size: 11px;">(' + esc(t.confidence) + ')</span></span>'
      ).join(' ');
      return '<div class="sp-panel"><p class="sp-panel-label">' + esc(c.name) + ' (' + techs.length + ')</p>'
        + '<div style="display: flex; gap: 8px; flex-wrap: wrap; margin-block-start: 4px;">' + chips + '</div></div>';
    }).join('');

    return '<div class="sp-report">'
      // 1. Overall Verdict Hero Card (Vercel Style)
      + '<section class="sp-verdict-card" aria-label="Overall Safety Assessment">'
      + '<div class="sp-verdict-top">'
      + '<div class="sp-domain-lockup">'
      + '<div class="sp-domain-eyebrow"><span class="edge-dot"></span><span>Real-Time Cloudflare Edge Audit</span></div>'
      + '<div class="sp-domain-headline-row">'
      + '<h2 class="sp-domain-title">' + esc(host) + '</h2>'
      + '<span class="sp-domain-protocol-badge">' + (conn?.isHttps ? 'HTTPS' : 'HTTP') + '</span>'
      + '</div>'
      + '<p class="sp-domain-meta">Scanned at ' + esc(new Date(safety?.scannedAt || Date.now()).toLocaleTimeString()) + ' · Ephemeral memory analysis</p>'
      + '</div>'
      + '<div class="sp-score-lockup">'
      + '<div class="sp-radial-container">'
      + '<svg class="sp-radial-svg" viewBox="0 0 80 80">'
      + '<circle class="sp-radial-bg" cx="40" cy="40" r="' + radius + '" stroke-width="6" fill="transparent" />'
      + '<circle class="sp-radial-meter" cx="40" cy="40" r="' + radius + '" stroke="' + meterColor + '" stroke-width="6" stroke-linecap="round" fill="transparent" stroke-dasharray="' + circumference + '" stroke-dashoffset="' + strokeDashoffset + '" />'
      + '</svg>'
      + '<div class="sp-radial-center">'
      + '<span class="sp-radial-score">' + esc(String(score)) + '</span>'
      + '<span class="sp-radial-sub">Score</span>'
      + '</div>'
      + '</div>'
      + '<div class="sp-verdict-banner-box">'
      + '<span class="sp-verdict-pill ' + verdictPillClass + '">' + esc(safety?.verdictTitle ?? 'No Known Threats Detected') + '</span>'
      + '<span class="type-mono-caps text-mute" style="font-size: 11px;">Rating: ' + esc(safety?.ratingLabel ?? 'Low Risk') + '</span>'
      + '</div>'
      + '</div>'
      + '</div>'
      + '<p class="sp-verdict-summary">' + esc(safety?.verdictSummary ?? '') + '</p>'
      // Telemetry Metric Strip
      + '<div class="sp-telemetry-grid">'
      + '<div class="sp-telemetry-tile"><span class="sp-telemetry-label">Threat Intel</span><span class="sp-telemetry-value" style="color: #34d399;">Clean</span></div>'
      + '<div class="sp-telemetry-tile"><span class="sp-telemetry-label">HTTPS Transport</span><span class="sp-telemetry-value">' + (conn?.isHttps ? '<span style="color: #34d399;">Encrypted</span>' : '<span style="color: #f87171;">Insecure</span>') + '</span></div>'
      + '<div class="sp-telemetry-tile"><span class="sp-telemetry-label">HSTS &amp; CSP</span><span class="sp-telemetry-value">' + (hdrs?.csp?.present ? '<span style="color: #34d399;">Audited</span>' : '<span style="color: #fbbf24;">Missing CSP</span>') + '</span></div>'
      + '<div class="sp-telemetry-tile"><span class="sp-telemetry-label">Redirect Routing</span><span class="sp-telemetry-value">' + (redirs?.hasDowngrade ? '<span style="color: #f87171;">Downgrade</span>' : '<span style="color: #34d399;">' + (redirs?.hopsCount ?? 0) + ' Hops</span>') + '</span></div>'
      + '</div>'
      + '</section>'

      // 2. Technical Panels Grid (Connection & Threat Intel)
      + '<div class="sp-grid-2">'
      // Connection Security Card
      + '<section class="sp-section-card" aria-label="Connection Security">'
      + '<div class="sp-sec-head"><h3 class="sp-sec-title">Connection &amp; SSL/TLS</h3><span class="sp-sec-tag">ENCRYPTION</span></div>'
      + '<div class="sp-grid-2">'
      + '<div class="sp-panel"><p class="sp-panel-label">HTTPS Status</p><p class="sp-panel-value">' + (conn?.isHttps ? '<span style="color: #34d399;">Active (Encrypted)</span>' : '<span style="color: #f87171;">Plain HTTP (Insecure)</span>') + '</p><p class="sp-panel-desc">' + (conn?.isHttps ? 'Valid SSL/TLS connection established' : 'No transport encryption') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">HTTP &rarr; HTTPS Redirect</p><p class="sp-panel-value">' + (conn?.httpRedirectsToHttps === true ? '<span style="color: #34d399;">Enforced</span>' : conn?.httpRedirectsToHttps === false ? '<span style="color: #fbbf24;">Not Enforced</span>' : '<span>HTTPS-only</span>') + '</p><p class="sp-panel-desc">' + (conn?.httpRedirectsToHttps === true ? 'Plain HTTP requests upgrade to HTTPS' : 'Unencrypted requests not redirected') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">HSTS Policy</p><p class="sp-panel-value">' + (conn?.hsts?.enabled ? '<span style="color: #34d399;">Enabled</span>' : '<span style="color: #fbbf24;">Missing</span>') + '</p><p class="sp-panel-desc">' + (conn?.hsts?.enabled ? (conn.hsts.preload ? 'Preload ready' : 'Max-age active') : 'Downgrade attacks possible') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">Mixed Content</p><p class="sp-panel-value">' + (conn?.mixedContent?.hasInsecureResources ? '<span style="color: #f87171;">' + conn.mixedContent.count + ' Insecure Items</span>' : '<span style="color: #34d399;">Clean</span>') + '</p><p class="sp-panel-desc">' + (conn?.mixedContent?.hasInsecureResources ? 'HTTP resources embedded on page' : 'Zero plain HTTP resources loaded') + '</p></div>'
      + '</div>'
      + '</section>'

      // Threat Intelligence Card
      + '<section class="sp-section-card" aria-label="Threat Intelligence">'
      + '<div class="sp-sec-head"><h3 class="sp-sec-title">Threat Intelligence &amp; Feeds</h3><span class="sp-sec-tag">REPUTATION</span></div>'
      + '<div class="sp-grid-2">'
      + '<div class="sp-panel"><p class="sp-panel-label">Cloudflare Security Feed</p><p class="sp-panel-value"><span style="color: #34d399;">Clean</span></p><p class="sp-panel-desc">No active malware or sinkhole listing</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">Homograph / Punycode</p><p class="sp-panel-value">' + (safety?.urlAnatomy?.isPunycode ? '<span style="color: #fbbf24;">Punycode Active</span>' : '<span style="color: #34d399;">Standard ASCII</span>') + '</p><p class="sp-panel-desc">' + (safety?.urlAnatomy?.isPunycode ? 'Internationalized characters detected' : 'No spoofed character sets') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">Phishing URL Keywords</p><p class="sp-panel-value">' + (safety?.urlAnatomy?.hasSuspiciousKeywords ? '<span style="color: #fbbf24;">Keywords Found</span>' : '<span style="color: #34d399;">None Found</span>') + '</p><p class="sp-panel-desc">' + (safety?.urlAnatomy?.hasSuspiciousKeywords ? safety.urlAnatomy.detectedKeywords.join(', ') : 'No high-risk keywords in hostname') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">Host Format</p><p class="sp-panel-value">' + (safety?.urlAnatomy?.isIpAddress ? '<span style="color: #fbbf24;">Raw IP Literal</span>' : '<span style="color: #34d399;">Standard FQDN</span>') + '</p><p class="sp-panel-desc">' + (safety?.urlAnatomy?.isIpAddress ? 'Direct numeric IP URL' : 'Named domain hostname') + '</p></div>'
      + '</div>'
      + '</section>'
      + '</div>'

      // Browser Security Headers Card
      + '<section class="sp-section-card" aria-label="Browser Security Headers">'
      + '<div class="sp-sec-head"><h3 class="sp-sec-title">Browser Security Headers</h3><span class="sp-sec-tag">HARDENING</span></div>'
      + '<div class="sp-grid-3">'
      + '<div class="sp-panel"><p class="sp-panel-label">Content-Security-Policy</p><p class="sp-panel-value">' + (hdrs?.csp?.present ? '<span style="color: #34d399;">Active</span>' : '<span style="color: #fbbf24;">Missing</span>') + '</p><p class="sp-panel-desc">' + esc(hdrs?.csp?.summary ?? '') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">X-Content-Type-Options</p><p class="sp-panel-value">' + (hdrs?.xContentTypeOptions?.isNosniff ? '<span style="color: #34d399;">nosniff</span>' : '<span style="color: #fbbf24;">Missing</span>') + '</p><p class="sp-panel-desc">Prevents MIME sniffing attacks</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">X-Frame-Options</p><p class="sp-panel-value">' + (hdrs?.xFrameOptions?.protected ? '<span style="color: #34d399;">Protected</span>' : '<span style="color: #fbbf24;">Missing</span>') + '</p><p class="sp-panel-desc">' + esc(hdrs?.xFrameOptions?.summary ?? 'Clickjacking protection') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">Referrer-Policy</p><p class="sp-panel-value">' + (hdrs?.referrerPolicy?.recommended ? '<span style="color: #34d399;">Strict</span>' : '<span style="color: #fbbf24;">Permissive</span>') + '</p><p class="sp-panel-desc">' + esc(hdrs?.referrerPolicy?.value || 'Default') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">Permissions-Policy</p><p class="sp-panel-value">' + (hdrs?.permissionsPolicy?.present ? '<span style="color: #34d399;">Configured</span>' : '<span style="color: #9ca3af;">Not Set</span>') + '</p><p class="sp-panel-desc">Device API restriction policy</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">Server Disclosure</p><p class="sp-panel-value">' + (hdrs?.serverExposure?.exposesVersion ? '<span style="color: #fbbf24;">Version Exposed</span>' : '<span style="color: #34d399;">Clean</span>') + '</p><p class="sp-panel-desc">' + esc(hdrs?.serverExposure?.server || 'Hidden') + '</p></div>'
      + '</div>'
      + '</section>'

      // Redirect & Infrastructure Card
      + '<section class="sp-section-card" aria-label="Redirects and DNS Infrastructure">'
      + '<div class="sp-sec-head"><h3 class="sp-sec-title">Redirects &amp; DNS Infrastructure</h3><span class="sp-sec-tag">ROUTING</span></div>'
      + '<div class="sp-grid-3">'
      + '<div class="sp-panel"><p class="sp-panel-label">Redirect Hops</p><p class="sp-panel-value">' + esc(String(redirs?.hopsCount ?? 0)) + ' hop' + (redirs?.hopsCount === 1 ? '' : 's') + '</p><p class="sp-panel-desc">' + (redirs?.hasDowngrade ? '<span style="color: #f87171;">Downgrade detected!</span>' : 'Direct or secure destination') + '</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">DNSSEC Validation</p><p class="sp-panel-value">' + (dns?.dnssec?.validated ? '<span style="color: #34d399;">Validated</span>' : '<span style="color: #9ca3af;">Not Validated</span>') + '</p><p class="sp-panel-desc">Cryptographic DNS authentication</p></div>'
      + '<div class="sp-panel"><p class="sp-panel-label">CAA Record</p><p class="sp-panel-value">' + (dns?.caaRecord?.present ? '<span style="color: #34d399;">Present</span>' : '<span style="color: #9ca3af;">Unrestricted</span>') + '</p><p class="sp-panel-desc">' + (dns?.caaRecord?.present ? 'CA issuance restricted' : 'Any CA can issue certs') + '</p></div>'
      + '</div>'
      + '</section>'

      // Privacy & Consent Stack Section (if any detected)
      + (techCount > 0
        ? '<section class="sp-section-card" aria-label="Detected Privacy &amp; Security Technologies">'
          + '<div class="sp-sec-head"><h3 class="sp-sec-title">Detected Privacy &amp; Security Technologies</h3><span class="sp-sec-tag">' + techCount + ' DETECTED</span></div>'
          + '<div class="sp-grid-2">' + techHtml + '</div>'
          + '</section>'
        : '')

      // Detailed Evidence Accordion with Filter Tabs
      + '<section class="sp-section-card" aria-label="Detailed Evidence &amp; Audit Log">'
      + '<div class="sp-sec-head">'
      + '<h3 class="sp-sec-title">Detailed Security Findings Log (' + findings.length + ')</h3>'
      + '<span class="sp-sec-tag">TECHNICAL EVIDENCE</span>'
      + '</div>'
      + '<div class="sp-findings-filter-row">'
      + '<button type="button" class="sp-filter-btn active" data-filter="all">All <span class="filter-count">(' + findings.length + ')</span></button>'
      + (stats.threats > 0 ? '<button type="button" class="sp-filter-btn" data-filter="threat">Threats <span class="filter-count" style="color: #f87171;">(' + stats.threats + ')</span></button>' : '')
      + (stats.concerns > 0 ? '<button type="button" class="sp-filter-btn" data-filter="concern">Concerns <span class="filter-count" style="color: #fbbf24;">(' + stats.concerns + ')</span></button>' : '')
      + '<button type="button" class="sp-filter-btn" data-filter="pass">Passed <span class="filter-count" style="color: #34d399;">(' + stats.passed + ')</span></button>'
      + '<button type="button" class="sp-filter-btn" data-filter="unavailable">Info / Skipped <span class="filter-count">(' + stats.unavailable + ')</span></button>'
      + '</div>'
      + '<div class="sp-findings-list" id="sp-findings-list-wrap">' + findingsHtml + '</div>'
      + '</section>'

      // Actions footer
      + '<div class="sp-actions-bar">'
      + '<div class="sp-action-btn-group">'
      + '<button type="button" class="sp-action-btn" data-sp-another>'
      + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>'
      + 'Check another website'
      + '</button>'
      + '<button type="button" class="sp-action-btn" data-sp-copy>'
      + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>'
      + 'Copy markdown report'
      + '</button>'
      + '</div>'
      + '<a class="type-caption text-mute" href="mailto:hello@cmsdetectorai.com?subject=Website+Safety+Report+Feedback" style="text-decoration: underline;">Feedback on this report</a>'
      + '</div>'
      + '</div>';
  }

  function wireActions(scope, data, submittedUrl) {
    // Reset / check another
    scope.querySelectorAll('[data-sp-another]').forEach((b) => {
      b.addEventListener('click', () => {
        if (resEl) resEl.hidden = true;
        if (errEl) errEl.hidden = true;
        if (input) {
          input.value = '';
          input.focus();
          updateClearBtn();
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    // Copy report
    scope.querySelectorAll('[data-sp-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        const host = data?.safety?.scannedHost || normalizeDomain(submittedUrl);
        const score = data?.safety?.safetyScore ?? 85;
        const verdict = data?.safety?.verdictTitle ?? 'No Known Threats Detected';
        const text = `### Website Safety Audit: ${host}\n\n`
          + `**Verdict**: ${verdict}\n`
          + `**Safety Score**: ${score}/100\n`
          + `**Passed Checks**: ${data?.safety?.stats?.passed ?? 0}\n`
          + `**Concerns**: ${data?.safety?.stats?.concerns ?? 0}\n`
          + `**Threats**: ${data?.safety?.stats?.threats ?? 0}\n\n`
          + `Audited by CMS Detector AI (https://cmsdetectorai.com/security-privacy-detector)`;
        try {
          await navigator.clipboard.writeText(text);
          const origHtml = b.innerHTML;
          b.textContent = 'Copied to clipboard!';
          setTimeout(() => { b.innerHTML = origHtml; }, 2500);
        } catch {
          b.textContent = 'Unable to copy';
        }
      });
    });

    // Findings Filter Tabs
    const filterBtns = scope.querySelectorAll('[data-filter]');
    const findingItems = scope.querySelectorAll('.sp-finding-item');
    filterBtns.forEach((fbtn) => {
      fbtn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        fbtn.classList.add('active');
        const target = fbtn.getAttribute('data-filter');
        findingItems.forEach((item) => {
          if (target === 'all' || item.getAttribute('data-status') === target) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  }

  async function runDetect(url) {
    const res = await fetch('/api/security-privacy-detect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url }),
    });
    const data = await res.json();
    setLoading(false);
    if (data.ok) {
      saveRecent(url);
      renderRecent();
      if (resEl) {
        resEl.innerHTML = renderReport(data, url);
        resEl.hidden = false;
        wireActions(resEl, data, url);
        resEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    } else {
      showError(data.error ?? { code: 'UNKNOWN' });
    }
  }

  async function run(url) {
    const clean = String(url ?? '').trim();
    if (!clean) return;
    setLoading(true);
    try {
      await runDetect(clean);
    } catch {
      setLoading(false);
      if (errEl) {
        errEl.innerHTML = '<div class="sp-error-card"><span class="badge badge-error">Network error</span>'
          + '<p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">Could not reach the detection API. Check your internet connection and try again.</p></div>';
        errEl.hidden = false;
      }
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    run(input?.value ?? '');
  });
  recentClear?.addEventListener('click', () => {
    try { localStorage.removeItem(STORAGE_KEY); } catch { /* noop */ }
    renderRecent();
    input?.focus();
  });
  renderRecent();
  updateClearBtn();
})();
</script>
