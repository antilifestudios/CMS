---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { CONTACT_EMAIL } from '../data/legal.ts';

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact CMS Detector AI',
  description: 'Get in touch with the CMS Detector AI engineering team for feedback, signature requests, and false positive reports.',
  url: 'https://cmsdetectorai.com/contact',
  mainEntity: {
    '@type': 'Organization',
    name: 'CMS Detector AI',
    url: 'https://cmsdetectorai.com',
    contactPoint: {
      '@type': 'ContactPoint',
      email: CONTACT_EMAIL,
      contactType: 'customer support',
      availableLanguage: ['English']
    }
  }
};
---

<Base
  title="Contact Us — CMS Detector AI"
  description="Contact the CMS Detector AI team. Report inaccurate results, request new framework signatures, or inquire about partnerships."
  pagePath="/contact"
  jsonLd={contactJsonLd}
>
  <!-- Hero Section -->
  <Section theme="dark" class="contact-hero" ariaLabelledby="contact-h1">
    <div class="container">
      <div class="hero-inner">
        <div class="eyebrow-lockup">
          <div class="badge-glow">
            <span class="dot"></span>
            <span>Support & Inquiries</span>
          </div>
          <h1 id="contact-h1" class="type-display-lg" style="color: var(--color-on-primary); margin: 0;">
            Get in touch with us
          </h1>
          <p class="type-subtitle text-ash" style="margin: 0; max-inline-size: 600px;">
            Whether you want to report an inaccurate scan, request a new CMS signature, or ask a question — we typically respond within 24–48 hours.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Main Content Grid -->
  <Section theme="dark" style="border-block-start: 1px solid var(--color-hairline-soft); padding-block: var(--spacing-section-lg);">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Form (Left) -->
        <div class="card-glass contact-form-card">
          <h2 class="type-heading-sm" style="color: var(--color-on-primary); margin: 0 0 8px 0;">
            Send us a message
          </h2>
          <p class="type-body-sm text-ash" style="margin: 0 0 24px 0;">
            Fill out the form below and our engineering team will get back to you promptly.
          </p>

          <form id="contact-form" class="contact-form" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="contact-name" class="form-label">
                  Your Name <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  class="form-input"
                  placeholder="e.g. Alex Miller"
                  required
                />
              </div>

              <div class="form-group">
                <label for="contact-email" class="form-label">
                  Email Address <span class="required">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  class="form-input"
                  placeholder="alex@example.com"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label for="contact-topic" class="form-label">
                Topic / Inquiry Type <span class="required">*</span>
              </label>
              <select id="contact-topic" name="topic" class="form-select" required>
                <option value="false-positive">Report Inaccurate / Missed Platform</option>
                <option value="signature-request">Request New CMS or Framework Signature</option>
                <option value="general-inquiry">General Feedback & Suggestions</option>
                <option value="partnership">Partnership & API Inquiry</option>
                <option value="privacy-legal">Privacy & Data Protection Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="contact-url" class="form-label">
                Website URL (if reporting a scan)
              </label>
              <input
                type="url"
                id="contact-url"
                name="url"
                class="form-input"
                placeholder="https://example.com"
              />
            </div>

            <div class="form-group">
              <label for="contact-message" class="form-label">
                Message <span class="required">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                class="form-textarea"
                placeholder="Provide details about your query or the site you analyzed..."
                required
              ></textarea>
            </div>

            <div id="contact-status" class="contact-status" style="display: none;" role="alert"></div>

            <button type="submit" id="contact-submit" class="btn btn-primary" style="width: 100%; margin-block-start: 8px;">
              Send Message
            </button>
          </form>
        </div>

        <!-- Direct Channels & Info (Right) -->
        <div class="contact-sidebar">
          <!-- Single consolidated email card with copy button -->
          <div class="card-glass channel-card">
            <h3 class="type-heading-sm" style="color: var(--color-on-primary); margin: 0 0 12px 0;">
              Direct Email
            </h3>
            <p class="type-body-sm text-ash" style="margin: 0 0 16px 0;">
              Email us for general feedback, false-positive reports, or privacy and data requests.
            </p>

            <div class="email-box">
              <a href={`mailto:${CONTACT_EMAIL}`} class="email-address text-link-dark" id="contact-mailto">
                {CONTACT_EMAIL}
              </a>
              <button
                type="button"
                id="copy-email-btn"
                class="copy-btn"
                aria-label="Copy email address to clipboard"
              >
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="copy-icon">
                  <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M11 5V3a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2" stroke="currentColor" stroke-width="1.3"/>
                </svg>
                <span id="copy-btn-text">Copy</span>
              </button>
            </div>

            <div class="quick-subject-routes">
              <span class="type-caption text-mute" style="display: block; margin-block: 16px 8px;">
                Routing shortcuts (click to open mail app):
              </span>
              <ul class="subject-link-list">
                <li>
                  <a href={`mailto:${CONTACT_EMAIL}?subject=General%20feedback`} class="subject-link">
                    General feedback & inquiries →
                  </a>
                </li>
                <li>
                  <a href={`mailto:${CONTACT_EMAIL}?subject=False%20positive%20report`} class="subject-link">
                    False-positive or missed detection report →
                  </a>
                </li>
                <li>
                  <a href={`mailto:${CONTACT_EMAIL}?subject=Privacy%20data%20request`} class="subject-link">
                    Privacy, CCPA & GDPR data request →
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <div class="card-glass info-card">
            <h3 class="type-heading-sm" style="color: var(--color-on-primary); margin: 0 0 12px 0;">
              Common Questions
            </h3>
            <div class="quick-qa">
              <p class="qa-q"><strong>Result looks wrong?</strong></p>
              <p class="qa-a">Include the inspected URL, what we reported, and what you expected. We review live traces and update our edge signature heuristics weekly.</p>

              <p class="qa-q"><strong>Do you offer an automated API?</strong></p>
              <p class="qa-a">CMS Detector AI is optimized for interactive edge scanning. For custom enterprise volume requirements, send an inquiry via the form.</p>
            </div>
            <a href="/faq" class="btn btn-secondary-dark" style="margin-block-start: 16px; width: 100%;">
              View Full FAQ →
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>
</Base>

<style>
  .contact-hero {
    padding-block: var(--spacing-section-lg) var(--spacing-section);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 32px;
    align-items: start;
  }

  .contact-form-card {
    padding: 36px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .channel-card,
  .info-card {
    padding: 28px;
  }

  .email-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-app-lg);
  }

  .email-address {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-on-primary);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-on-primary);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-app-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-sans);
  }

  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .quick-subject-routes {
    border-block-start: 1px solid rgba(255, 255, 255, 0.06);
    margin-block-start: 16px;
  }

  .subject-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .subject-link {
    font-size: 13px;
    color: var(--color-ash);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .subject-link:hover {
    color: var(--color-brand);
  }

  .quick-qa {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .qa-q {
    margin: 0;
    font-size: 14px;
    color: var(--color-on-primary);
  }

  .qa-a {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ash);
  }

  .contact-status {
    padding: 12px 16px;
    border-radius: var(--radius-app-md);
    font-size: 14px;
    margin-block-end: 16px;
    line-height: 1.4;
  }

  .contact-status--success {
    background: rgba(55, 205, 132, 0.15);
    border: 1px solid rgba(55, 205, 132, 0.3);
    color: var(--color-success);
  }

  .contact-status--error {
    background: rgba(221, 0, 0, 0.15);
    border: 1px solid rgba(221, 0, 0, 0.3);
    color: #ff7878;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Contact form submission simulation
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (form && statusEl && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value.trim();

      if (!name || !email || !message) {
        statusEl.className = 'contact-status contact-status--error';
        statusEl.textContent = 'Please fill out all required fields marked with an asterisk (*).';
        statusEl.style.display = 'block';
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        statusEl.className = 'contact-status contact-status--error';
        statusEl.textContent = 'Please enter a valid email address.';
        statusEl.style.display = 'block';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending message…';

      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
        form.reset();

        statusEl.className = 'contact-status contact-status--success';
        statusEl.textContent = 'Thank you! Your message has been received. Our team will review your inquiry and follow up within 24–48 hours.';
        statusEl.style.display = 'block';
      }, 600);
    });
  }

  // Copy email to clipboard
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-btn-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('hello@cmsdetectorai.com');
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy';
        }, 2000);
      } catch {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = 'hello@cmsdetectorai.com';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy';
        }, 2000);
      }
    });
  }
</script>
