---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
---

<Base
  title="Contact — CMS Detector AI"
  description="Get in touch with the CMS Detector AI team: wrong results, missed platforms, or general feedback."
  pagePath="/contact"
>
  <Section theme="dark" style="padding-block: var(--spacing-section);" ariaLabelledby="c-h1">
    <div class="container">
      <div class="eyebrow-lockup">
        <span class="eyebrow type-mono-eyebrow">Contact</span>
        <h1 id="c-h1" class="type-display-md" style="color: var(--color-on-primary); margin: 0;">
          Get in touch
        </h1>
        <p class="type-subtitle text-ash" style="margin: 0; max-inline-size: 560px;">
          Wrong result, missed platform, or general feedback — email works best.
        </p>
      </div>
    </div>
  </Section>
  <Section theme="light">
    <div class="container">
      <div class="narrow card-light">
        <p class="type-body" style="color: var(--color-slate); margin: 0 0 12px 0;">Email us at:</p>
        <p class="type-heading-sm" style="margin: 0 0 16px 0;"><a href="mailto:hello@cmsdetectorai.com" class="text-link-light">hello@cmsdetectorai.com</a></p>
        <p class="type-body-sm" style="color: var(--color-slate); margin: 0;">Reporting a wrong result? Include the checked domain, what we detected, and what you expected — the “Result looks wrong?” link on every answer pre-fills this for you. There are no accounts or contact forms; email keeps it simple and private.</p>
      </div>
    </div>
  </Section>
</Base>
<style>
  .narrow { max-inline-size: 720px; }
</style>
