---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import NavIcon from '../components/layout/NavIcon.astro';
import ThemeCard from '../components/ThemeCard.astro';

const faqs = [
  {
    q: 'What is a WordPress theme detector?',
    a: 'A WordPress theme detector is a free online tool that inspects any WordPress site\'s public assets in real time to reveal the active theme name, author, version, parent/child hierarchy, and installed plugins.',
  },
  {
    q: 'How does this WordPress theme detector work?',
    a: 'Our WordPress theme detector uses automated edge workers to scan the target page\'s HTML for theme asset paths (under /wp-content/themes/[slug]/). It then requests the active theme\'s stylesheet (style.css) and parses the standardized header comment block for metadata like Theme Name, Author, Version, and Template.',
  },
  {
    q: 'Can this tool detect child themes and parent themes?',
    a: 'Yes. When a site uses a child theme (a best practice for custom styling and template modifications), the style.css file contains a "Template:" header referencing the parent theme directory. Our detector identifies both the child theme and the parent theme (such as Astra, GeneratePress, Kadence, or Genesis).',
  },
  {
    q: 'Can the WordPress theme detector detect active plugins?',
    a: 'Yes. The detector scans script tags, stylesheets, and DOM element identifiers pointing to /wp-content/plugins/ to identify active plugins such as WooCommerce, Elementor, Yoast SEO, Contact Form 7, Advanced Custom Fields (ACF), and more.',
  },
  {
    q: 'Why can\'t the detector find the theme on some WordPress sites?',
    a: 'Sites running headless WordPress (using Next.js, Gatsby, or Astro on the frontend), heavily obfuscated caching plugins, security firewalls that block CSS inspection, or custom proprietary white-label themes may not expose standard style.css comment blocks. In those situations, our tool indicates that theme data is not publicly exposed.',
  },
  {
    q: 'What is the difference between a WordPress theme and a page builder like Elementor?',
    a: 'A WordPress theme provides the foundational design framework, template files, and default CSS for your entire site (e.g. Astra or Hello Elementor). A page builder (like Elementor, Beaver Builder, or Divi Builder) is a plugin that provides visual drag-and-drop page editing inside individual posts and pages.',
  },
  {
    q: 'Is this WordPress theme detector completely free to use?',
    a: 'Yes. Our WordPress theme detector is 100% free with unlimited domain scans. No account registration, email submission, or browser extensions are required.',
  },
];
---
<Base
  title="WordPress Theme Detector — Free Tool to Find Any WordPress Theme | CMS Detector AI"
  description="Free WordPress theme detector to instantly find what WordPress theme, child theme, author, and plugins any site is using. 100% free with no sign-up."
  pagePath="/wordpress-theme-detector"
  canonical="https://cmsdetectorai.com/wordpress-theme-detector"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'WordPress Theme Detector',
      url: 'https://cmsdetectorai.com/wordpress-theme-detector',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'All',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'Free WordPress theme detector tool to identify any site\'s WordPress theme, parent theme, child theme, author, version, and active plugins.',
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://cmsdetectorai.com',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'WordPress Theme Detector',
          item: 'https://cmsdetectorai.com/wordpress-theme-detector',
        },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: 'How to detect what WordPress theme a website is using',
      description: 'Step-by-step instructions for finding the WordPress theme, child theme, and plugins powering any website.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Copy the WordPress website URL',
          text: 'Copy the web address of the WordPress site or blog you wish to inspect (e.g. woocommerce.com).',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Paste into the WordPress Theme Detector',
          text: 'Paste the target URL into the search box of the WordPress theme detector.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Click Find Theme',
          text: 'Click Find Theme to initiate stylesheet and asset inspection.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Inspect theme name, author, child hierarchy, and plugins',
          text: 'Review the active theme name, author link, stylesheet version, child/parent relationships, and detected WordPress plugins.',
        },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Popular WordPress themes',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Astra',
          url: 'https://wordpress.org/themes/astra/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Hello Elementor',
          url: 'https://wordpress.org/themes/hello-elementor/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Kadence',
          url: 'https://wordpress.org/themes/kadence/',
        },
      ],
    },
  ]}
>
  <Section theme="dark" class="hero" ariaLabelledby="wp-h1">
    <div class="container">
      <div style="max-inline-size: 880px;">
        <div class="eyebrow-lockup">
          <div class="badge-glow" style="margin-block-end: 2px; align-self: flex-start;">
            <span class="dot"></span>
            <span>Free WordPress Intelligence · Cloudflare Edge</span>
          </div>
          <span class="eyebrow type-mono-eyebrow eyebrow-with-icon">
            <NavIcon name="wordpress" size={16} />WordPress Theme Detector
          </span>
          <h1 id="wp-h1" class="type-display-xl hero-main-title">
            WordPress Theme Detector<br />
            <span class="hero-h1-sub">Find What Theme Any WordPress Site Is Using</span>
          </h1>
          <p class="type-subtitle text-ash" style="margin: 0; max-inline-size: 640px;">
            Our free <strong>WordPress theme detector</strong> inspects page stylesheets and assets in real time to reveal
            the active theme, author, version, parent/child hierarchy, and active plugins without downloading untrusted code.
          </p>
        </div>

        <div style="margin-block-start: var(--spacing-xxl);">
          <form id="wp-detect-form" class="detect-form" aria-label="WordPress theme detection" novalidate>
            <div class="search-bar">
              <div class="search-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
              </div>
              <label for="wp-url-input" class="sr-only">WordPress site URL</label>
              <input
                id="wp-url-input"
                type="url"
                inputmode="url"
                autocomplete="url"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                class="search-input"
                placeholder="https://example.com or domain.com"
                required
              />
              <button type="button" id="wp-clear-btn" class="search-clear-btn" aria-label="Clear input" hidden>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
              <button type="submit" class="btn btn-primary search-btn" id="wp-detect-submit">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <span>Find Theme</span>
              </button>
            </div>

            <!-- Quick presets -->
            <div class="preset-bar">
              <span class="type-mono-caps text-mute preset-lbl">Try:</span>
              <div class="preset-chips">
                <button type="button" class="preset-chip" data-wp-example="woocommerce.com">woocommerce.com</button>
                <button type="button" class="preset-chip" data-wp-example="pallion.com">pallion.com</button>
                <button type="button" class="preset-chip" data-wp-example="getifinity.com">getifinity.com</button>
              </div>
            </div>

            <div class="search-note type-caption text-mute">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span>Automated &amp; private theme audit. Submitted domains are evaluated in real time without storing browsing history.</span>
            </div>
          </form>

          {/* Progress / Loading steps */}
          <div id="wp-loading" hidden aria-live="polite" aria-busy="true" style="margin-block-start: var(--spacing-xl);">
            <div class="card-dark wp-loading-card">
              <div class="wp-loading-head">
                <div class="wp-loading-spinner" aria-hidden="true"></div>
                <div>
                  <p class="type-mono-caps text-mute" style="margin: 0;">Edge Inspector</p>
                  <p class="type-heading-sm" style="color: var(--color-on-primary); margin: 2px 0 0 0;" id="wp-loading-status">Analyzing WordPress theme...</p>
                </div>
              </div>
              <div class="wp-scan-steps">
                <div class="wp-scan-step active" id="wp-step-1">
                  <span class="wp-step-dot"></span>
                  <span>Connecting to domain &amp; verifying SSL handshake</span>
                </div>
                <div class="wp-scan-step" id="wp-step-2">
                  <span class="wp-step-dot"></span>
                  <span>Scanning HTML DOM for WordPress core signatures</span>
                </div>
                <div class="wp-scan-step" id="wp-step-3">
                  <span class="wp-step-dot"></span>
                  <span>Inspecting active theme stylesheet (style.css)</span>
                </div>
                <div class="wp-scan-step" id="wp-step-4">
                  <span class="wp-step-dot"></span>
                  <span>Resolving parent/child hierarchy &amp; active plugins</span>
                </div>
              </div>
            </div>
          </div>

          {/* Result Output */}
          <div id="wp-result" hidden aria-live="polite" style="margin-block-start: var(--spacing-xl);"></div>

          {/* Error Message */}
          <div id="wp-error" hidden aria-live="assertive" role="alert" style="margin-block-start: var(--spacing-xl);"></div>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 1: How it works */}
  <Section theme="light" ariaLabelledby="wp-how-to" class="seo-content-section">
    <div class="container">
      <div style="max-inline-size: 880px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xl);">
          <span class="eyebrow" style="color: var(--color-mute);">Edge Inspection Workflow</span>
          <h2 id="wp-how-to" class="type-display-sm" style="color: var(--color-ink);">
            How Our WordPress Theme Detector Works
          </h2>
          <p class="type-subtitle" style="color: var(--color-slate);">
            Every standard WordPress installation follows the core theme architecture defined by WordPress.org. Here is how our automated detector finds the theme and active plugins:
          </p>
        </div>

        <div class="guide-steps-grid">
          <div class="guide-step-card">
            <div class="guide-step-num">01</div>
            <h3 class="guide-step-title">Submit Website or Blog URL</h3>
            <p class="guide-step-text">
              Enter any WordPress URL into the detector. Our edge worker retrieves the rendered HTML document safely in an isolated Cloudflare container without executing client-side tracking scripts.
            </p>
          </div>
          <div class="guide-step-card">
            <div class="guide-step-num">02</div>
            <h3 class="guide-step-title">Fetch Active Theme Stylesheet</h3>
            <p class="guide-step-text">
              The engine parses <code>&lt;link rel="stylesheet"&gt;</code> tags and asset paths for <code>/wp-content/themes/[slug]/</code>. It downloads the theme's <code>style.css</code> file to read the standard WordPress metadata comment header.
            </p>
          </div>
          <div class="guide-step-card">
            <div class="guide-step-num">03</div>
            <h3 class="guide-step-title">Unmask Child Themes &amp; Plugins</h3>
            <p class="guide-step-text">
              If the stylesheet declares a <code>Template:</code> parameter, our detector recognizes it as a child theme and fetches the parent theme details. It also scans <code>/wp-content/plugins/</code> paths to list active plugins.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 2: Why Use This Tool */}
  <Section theme="dark" ariaLabelledby="wp-features-h2" class="seo-content-section">
    <div class="container">
      <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
        <span class="eyebrow type-mono-eyebrow">Key Capabilities</span>
        <h2 id="wp-features-h2" class="type-display-sm" style="color: var(--color-on-primary);">
          Why Use Our Free WordPress Theme Detector?
        </h2>
        <p class="type-subtitle text-ash" style="max-inline-size: 680px;">
          Built for WordPress developers, agency designers, and site builders who want deep, reliable theme forensics:
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h3 class="feature-title">Deep style.css Comment Parsing</h3>
          <p class="feature-desc">
            Extracts Theme Name, Theme URI, Author, Author URI, Description, Version, and License directly from the official WordPress stylesheet comment block.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3 class="feature-title">Child Theme &amp; Parent Hierarchy</h3>
          <p class="feature-desc">
            Identifies when a website is running a child theme (e.g., an Astra Child or GeneratePress Child) and highlights both the custom child theme and the core parent theme framework.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </div>
          <h3 class="feature-title">Active WordPress Plugin Detection</h3>
          <p class="feature-desc">
            Discovers active plugins including WooCommerce, Elementor, Yoast SEO, Contact Form 7, W3 Total Cache, Wordfence, and Advanced Custom Fields from page asset evidence.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3 class="feature-title">WordPress.org &amp; Author Links</h3>
          <p class="feature-desc">
            Provides verified links to the official WordPress.org theme directory or theme marketplace page where you can view documentation, install instructions, and ratings.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3 class="feature-title">100% Free &amp; Lightning Fast</h3>
          <p class="feature-desc">
            Zero sign-up required, no daily search quotas, and no extensions needed. Audits run at cloud edge speed in less than 2 seconds.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="feature-title">Anonymous &amp; Secure</h3>
          <p class="feature-desc">
            Submitted domains are audited strictly to generate the requested theme report. We never store browsing logs, track personal information, or sell search histories.
          </p>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 3: Manual Detection Guide */}
  <Section theme="light" ariaLabelledby="wp-manual-h2" class="seo-content-section">
    <div class="container">
      <div style="max-inline-size: 880px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xl);">
          <span class="eyebrow" style="color: var(--color-mute);">Developer Guide</span>
          <h2 id="wp-manual-h2" class="type-display-sm" style="color: var(--color-ink);">
            How to Find a WordPress Theme Manually (in Page Source)
          </h2>
          <p class="type-subtitle" style="color: var(--color-slate);">
            If you want to manually locate what WordPress theme a website is running, follow these 5 steps in your browser:
          </p>
        </div>

        <div class="manual-guide-box">
          <ol class="manual-steps-list">
            <li>
              <strong>Open Page Source:</strong> Navigate to the website in Google Chrome, Firefox, or Safari. Right-click and choose <em>View Page Source</em>, or press <kbd>Ctrl + U</kbd> (<kbd>Cmd + Option + U</kbd> on Mac).
            </li>
            <li>
              <strong>Search for the Themes Directory:</strong> Press <kbd>Ctrl + F</kbd> (<kbd>Cmd + F</kbd>) and type <code>/wp-content/themes/</code> into the search bar.
            </li>
            <li>
              <strong>Locate the Stylesheet Link:</strong> Look for a link to <code>style.css</code>. It typically appears as:
              <div class="code-preview">
                <pre><code>&lt;link rel="stylesheet" href="https://example.com/wp-content/themes/astra/style.css" /&gt;</code></pre>
              </div>
            </li>
            <li>
              <strong>Open style.css in a New Tab:</strong> Click the URL to open the stylesheet directly. At the very top, you will see a standardized comment block:
              <div class="code-preview">
                <pre><code>/*
Theme Name: Astra
Theme URI: https://wpastra.com/
Author: Brainstorm Force
Author URI: https://brainstormforce.com
Description: Astra is fast, fully customizable &amp; beautiful WordPress theme...
Version: 4.6.5
Template: (present only if this is a child theme)
*/</code></pre>
              </div>
            </li>
            <li>
              <strong>Check for Parent Themes:</strong> If the comment contains a <code>Template:</code> line, the current theme is a child theme, and the value after <code>Template:</code> is the folder name of the parent theme.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </Section>

  {/* Popular Themes Section */}
  <Section theme="light" ariaLabelledby="wp-popular-h2">
    <div class="container">
      <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-lg);">
        <span class="eyebrow type-mono-eyebrow">Popular Themes</span>
        <h2 id="wp-popular-h2" class="type-display-sm" style="color: var(--color-ink); margin: 0;">
          Widely Used WordPress Themes Detected by Our Tool
        </h2>
        <p class="type-body" style="color: var(--color-slate); margin: 0; max-inline-size: 680px;">
          These three themes consistently rank among the most popular on WordPress.org and power tens of millions of websites.
          Paste any website URL in our <strong>WordPress theme detector</strong> above to check whether it runs one of them or a custom child theme.
        </p>
      </div>
      <div class="theme-grid">
        <ThemeCard
          name="Astra"
          maker="Brainstorm Force"
          category="Multipurpose · Customizer"
          availability="Free · optional paid upgrades"
          description="Performance-focused multipurpose theme with extensive Customizer controls. A common choice for business sites and WooCommerce stores that need fine-grained header, layout, and typography settings without a page builder lock-in."
          features={[
            'Lightweight base with modular Customizer options',
            'Works with Spectra, Elementor, and Beaver Builder',
            'WooCommerce-compatible store layouts',
          ]}
          href="https://wordpress.org/themes/astra/"
          linkLabel="View Astra on WordPress.org"
          previewLabel="wordpress.org/themes/astra"
          imageSrc="/themes/astra.webp"
          imageWidth={800}
          imageHeight={600}
          imageAlt="Preview of the Astra theme demo homepage with a purple hero section and service columns"
        />
        <ThemeCard
          name="Hello Elementor"
          maker="Elementor"
          category="Page-builder canvas"
          availability="Free"
          description="Minimal canvas theme built by the Elementor team as a starting point for Elementor-built pages. Ships with almost no styling of its own, so the page-builder design controls the output — including WooCommerce pages."
          features={[
            'Bare-bones base designed for Elementor',
            'Minimal CSS and scripts for fast loads',
            'WooCommerce support for Elementor-built stores',
          ]}
          href="https://wordpress.org/themes/hello-elementor/"
          linkLabel="View Hello Elementor on WordPress.org"
          previewLabel="wordpress.org/themes/hello-elementor"
          imageSrc="/themes/hello-elementor.webp"
          imageWidth={800}
          imageHeight={600}
          imageAlt="Preview of the Hello Elementor theme demo page with a large Hello headline and hero image"
        />
        <ThemeCard
          name="Kadence"
          maker="Nexcess (Kadence WP)"
          category="Multipurpose · Block editor"
          availability="Free · optional paid upgrades"
          description="Lightweight theme pairing a visual header and footer builder with global design controls. Often chosen with its companion Kadence Blocks plugin for content-rich Gutenberg sites that still want fast load times."
          features={[
            'Drag-and-drop header and footer builder',
            'Global palette, typography, and layout controls',
            'Pairs with Kadence Blocks for Gutenberg',
          ]}
          href="https://wordpress.org/themes/kadence/"
          linkLabel="View Kadence on WordPress.org"
          previewLabel="wordpress.org/themes/kadence"
          imageSrc="/themes/kadence.webp"
          imageWidth={800}
          imageHeight={600}
          imageAlt="Preview of the Kadence theme demo homepage with a hero banner and product columns"
        />
      </div>
    </div>
  </Section>

  {/* Frequently Asked Questions */}
  <Section theme="light" ariaLabelledby="wp-faq-h2" class="seo-content-section">
    <div class="container">
      <div style="max-inline-size: 880px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
          <span class="eyebrow" style="color: var(--color-mute);">Frequently Asked Questions</span>
          <h2 id="wp-faq-h2" class="type-display-sm" style="color: var(--color-ink);">
            WordPress Theme Detector FAQ
          </h2>
          <p class="type-subtitle" style="color: var(--color-slate);">
            Clear answers about WordPress theme detection, child theme mechanics, stylesheet headers, and plugin discovery.
          </p>
        </div>

        <div class="faq-list">
          {faqs.map((f, i) => (
            <details class="faq-item" id={`wp-faq-${i}`}>
              <summary class="faq-summary">
                <span class="faq-question">{f.q}</span>
