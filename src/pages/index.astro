function initLimitInfo(scope: ParentNode = document): void {
  const hoverOK = window.matchMedia('(hover: hover)').matches;
  scope.querySelectorAll('.limit-info-wrap').forEach((wrap) => {
    const w = wrap as HTMLElement;
    if (w.dataset.wired) return;
    w.dataset.wired = 'true';
    const btn = w.querySelector('.limit-info-btn') as HTMLButtonElement | null;
    const pop = w.querySelector('.limit-pop') as HTMLElement | null;
    if (!btn || !pop) return;
    // Clamp the popover inside the viewport (375px safe): it is
    // position:absolute under the icon, so nudge it when it would overflow.
    const fit = (): void => {
      pop.style.marginLeft = '0px';
      const r = pop.getBoundingClientRect();
      const overRight = r.right - (window.innerWidth - 8);
      const overLeft = 8 - r.left;
      if (overRight > 0) pop.style.marginLeft = `${-overRight}px`;
      else if (overLeft > 0) pop.style.marginLeft = `${overLeft}px`;
    };
    const open = (): void => { pop.hidden = false; btn.setAttribute('aria-expanded', 'true'); fit(); };
    const close = (): void => { pop.hidden = true; btn.setAttribute('aria-expanded', 'false'); pop.style.marginLeft = '0px'; };
    let pinned = false;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (pop.hidden) { open(); pinned = true; } else { close(); pinned = false; }
    });
    if (hoverOK) {
      w.addEventListener('mouseenter', () => { if (!pinned) open(); });
      w.addEventListener('mouseleave', () => { if (!pinned) close(); });
    }
    window.addEventListener('resize', () => { if (!pop.hidden) fit(); });
    document.addEventListener('pointerdown', (e) => {
      if (!pop.hidden && !w.contains(e.target as Node)) { close(); pinned = false; }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !pop.hidden) { close(); pinned = false; btn.focus(); }
    });
  });
}

function renderScanSummary(data: {
  rootHost: string;
  verdict: string;
  verdictLine: string;
  baselineFramework: string;
  baselineProvider: string;
  coverage: { checked: number; foundApprox: number; truncated: boolean };
  frontDoorNote: boolean;
  techs?: Array<{
    techId: string; name: string; kind: string; confidence: string;
    detectedOn: number; checkedPages: number; pageSlug?: string;
    evidence: Array<{ signalType: string; name: string; sampleValue: string; pagesSeen: number; strength?: string }>;
  }>;
  pages: Array<{
    url: string; framework: string; provider: string; confidence: string;
    evidence?: string[];
    differsFramework?: boolean; differsProvider?: boolean; isOddOneOut?: boolean;
    crossDomainRedirect?: boolean; error?: string;
  }>;
  unscannedUrls?: string[];
}): string {
  const t = getScanCopy();
  const isMixed = data.verdict !== 'consistent';
  const total = data.pages.length;
  const oddCount = data.pages.filter((p) => p.isOddOneOut).length;
  // Label appears exactly once: templates carry the full sentence.
  const verdictText = isMixed
    ? fill(t.verdictMixedLine, { odd: String(oddCount), total: String(total) })
    : fill(t.verdictConsistentLine, {
        checked: String(data.coverage.checked),
        framework: data.baselineFramework,
        provider: data.baselineProvider,
      });
  const coverageText = fill(t.coverageShort, {
    checked: String(data.coverage.checked),
    found: String(data.coverage.foundApprox),
  });
  const frontDoorText = data.frontDoorNote
    ? fill(t.frontDoorShort, { provider: data.baselineProvider })
    : '';

  // Confidence shown once in the summary when uniform across rows.
  const confValues = data.pages.filter((p) => !p.error).map((p) => p.confidence);
  const uniformConf = confValues.length > 0 && new Set(confValues).size === 1 ? confValues[0] : null;

  // Mode confidence for the summary badges (detection unchanged — display only).
  const modeOf = (vals: string[]): string => {
    const counts = new Map<string, number>();
    for (const v of vals) counts.set(v, (counts.get(v) ?? 0) + 1);
    let best = vals[0] ?? '—';
    let bestN = -1;
    for (const [v, n] of counts) { if (n > bestN) { best = v; bestN = n; } }
    return best;
  };
  const summaryConf = uniformConf ?? modeOf(confValues);

  const collectEvidence = (match: (p: (typeof data.pages)[number]) => boolean): string[] => {
    const seen = new Set<string>();
    const out: string[] = [];
    for (const p of data.pages) {
      if (!match(p) || !p.evidence) continue;
      for (const e of p.evidence) {
        if (!seen.has(e) && out.length < 6) { seen.add(e); out.push(e); }
      }
    }
    return out;
  };
  const evList = (items: string[]): string => items.length > 0
    ? `<ul class="evidence-list" role="list">${items.map((e) => `<li class="evidence-item"><code class="evidence-artifact">${esc(e)}</code></li>`).join('')}</ul>`
    : '';

  // One card template for every category. Top to bottom, always:
  //   1. category eyebrow (above the name),
  //   2. name + confidence badge row,
  //   3. one muted summary line ("Detected on 15/15 pages · 3 signals"),
  //   4. the "Why we think this" disclosure (collapsed by default).
  // Each card shows ONLY its own techId's evidence, grouped by display
  // group (strongest first) with its OWN confidence. Page coverage is a
  // union across pages — one weak page never downgrades the tech.
  type ScanTech = NonNullable<typeof data.techs>[number];
  type ScanEvidence = ScanTech['evidence'][number];

  // Display groups: Headers (header + cookie, both travel over HTTP),
  // HTML markers (html-regex + generator tag), Asset paths (html-path
  // + script URLs), Probes. Server pre-sorts evidence strongest-first,
  // so groups below form in strongest-first order automatically.
  const displayGroup = (signalType: string): 'headers' | 'markers' | 'paths' | 'probes' => {
    if (signalType === 'header' || signalType === 'cookie-name') return 'headers';
    if (signalType === 'html-regex' || signalType === 'meta-generator') return 'markers';
    if (signalType === 'html-path' || signalType === 'script-host') return 'paths';
    return 'probes';
  };
  const GROUP_LABELS: Record<string, string> = {
    headers: t.grpHeaders,
    markers: t.grpMarkers,
    paths: t.grpPaths,
    probes: t.probeType,
  };

  const techEvList = (tech: ScanTech): string => {
    if (tech.evidence.length === 0) return '';
    const groups = new Map<string, ScanEvidence[]>();
    for (const e of tech.evidence) {
      const g = displayGroup(e.signalType);
      if (!groups.has(g)) groups.set(g, []);
      groups.get(g)!.push(e);
    }
    return [...groups.entries()].map(([group, items]) => {
      const lines = items.map((e) => `
        <li class="evidence-row">
          <span class="evidence-name" title="${esc(e.name)}">${esc(e.name)}</span>
          <span class="evidence-value" title="${esc(e.sampleValue)}">${esc(e.sampleValue)}</span>
          <span class="evidence-count">${esc(String(e.pagesSeen))}/${esc(String(tech.checkedPages))}</span>
        </li>`).join('');
      return `<li class="evidence-group"><span class="evidence-group-label type-mono-caps text-mute">${esc(GROUP_LABELS[group] ?? group)}</span><ul class="evidence-rows" role="list">${lines}</ul></li>`;
    }).join('');
  };

  const cardName = (name: string, _pageSlug?: string): string =>
    esc(name);

  const catLabel = (kind: string): string =>
    kind === 'hosting' ? t.hostingCat : t.frameworkCat;

  const summaryLine = (tech: { detectedOn: number; checkedPages: number; evidence: { length: number } }): string => {
    const signals = tech.evidence.length === 1
      ? t.signalOne
      : fill(t.signalCount, { count: String(tech.evidence.length) });
    return `${esc(fill(t.detectedOnPages, { seen: String(tech.detectedOn), checked: String(tech.checkedPages) }))} · ${esc(signals)}`;
  };

  const disclosure = (body: string): string => `
      <details class="evidence-section">
        <summary class="evidence-toggle type-caption-tight">
          <span>${esc(t.evidenceLabel)}</span>
          <svg class="toggle-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        ${body}
      </details>`;

  const techStackCard = (kind: 'framework' | 'hosting', tech: ScanTech): string => `
    <div class="detection-card stack-card">
      <p class="card-eyebrow type-mono-caps text-mute">${esc(catLabel(tech.kind))}</p>
      <div class="detection-name-row">
        <span class="type-heading-sm detection-name">${cardName(tech.name, tech.pageSlug)}</span>
        ${confBadge(tech.confidence, `conf-tip-${esc(tech.techId)}`)}
      </div>
      <p class="type-caption text-mute card-summary">${summaryLine(tech)}</p>
      ${disclosure(`<ul class="evidence-groups" role="list">${techEvList(tech)}</ul>`)}
    </div>`;

  // Legacy fallback for payloads that predate the per-technology
  // rollup (e.g. a cached API response): same card anatomy, pooled
  // evidence list, no per-signal page counts.
  const stackCard = (kind: 'framework' | 'hosting', name: string, evidence: string[]): string => `
    <div class="detection-card stack-card">
      <p class="card-eyebrow type-mono-caps text-mute">${esc(catLabel(kind))}</p>
      <div class="detection-name-row">
        <span class="type-heading-sm detection-name">${esc(name)}</span>
        ${confBadge(summaryConf, `conf-tip-legacy-${kind}`)}
      </div>
      ${disclosure(evList(evidence))}
    </div>`;

  // Prefer the per-technology rollup (evidence strictly separated by
  // techId). Fall back to the legacy pooled list only for payloads
  // that predate it (e.g. a cached API response).
  const findTech = (name: string): ScanTech | undefined =>
    (data.techs ?? []).find((x) => x.name === name);
  const fwTech = findTech(data.baselineFramework);
  const pvTech = findTech(data.baselineProvider);

  // Mixed: differing rows pinned to the top and highlighted.
  const ordered = [...data.pages].sort((a, b) => Number(b.isOddOneOut ?? false) - Number(a.isOddOneOut ?? false));
  const differsWhat = (p: (typeof ordered)[number]): string => {
    const parts: string[] = [];
    if (p.differsFramework) parts.push(t.differsFw);
    if (p.differsProvider || p.crossDomainRedirect) parts.push(t.differsPv);
    if (parts.length === 0) return '';
    return fill(t.differsLabel, { what: parts.join(' + ') });
  };
  const showConfCol = uniformConf === null;
  const scannedItems = ordered.map((p, i) => {
    const shortUrl = p.url.replace(/^https?:\/\//, '');
    const diffNote = p.isOddOneOut ? differsWhat(p) : '';
    return `
    <li class="unscanned-url-item scanned-url-item ${p.isOddOneOut ? 'scan-odd' : ''}">
      <span class="unscanned-idx type-mono">${i + 1}</span>
      <div class="scanned-main">
        <span class="scanned-url type-mono" title="${esc(p.url)}">${esc(shortUrl)}</span>
        ${p.crossDomainRedirect ? `<span class="scanned-redirect-tag type-caption text-mute">${esc(t.crossDomain)}</span>` : ''}
        ${diffNote ? `<span class="scan-diff-note">${esc(diffNote)}</span>` : ''}
      </div>
      <div class="scanned-meta">
        <span class="scanned-tag scanned-tag-fw"><span class="scanned-tag-dim">CMS:</span> <strong>${esc(p.framework)}</strong></span>
        <span class="scanned-tag scanned-tag-pv"><span class="scanned-tag-dim">Host:</span> <strong>${esc(p.provider)}</strong></span>
        ${showConfCol ? `<span class="badge conf-badge ${confClass(p.confidence)}">${esc(p.error ? '—' : p.confidence)}</span>` : ''}
      </div>
      <button type="button" class="unscanned-item-copy-btn" title="Copy URL" data-single-url="${esc(p.url)}" aria-label="Copy ${esc(p.url)}">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
        </svg>
      </button>
    </li>`;
  }).join('');
  const viewLabel = fill(t.viewUrls, { count: String(total) });
  const shareUrl = `/result/${encodeURIComponent(data.rootHost)}`;
  const mailtoBody = encodeURIComponent(`URL: ${data.rootHost}\nDetected: ${data.baselineFramework} + ${data.baselineProvider}\nExpected: `);

  const unscannedUrls = data.unscannedUrls ?? [];
  const unscannedDropdownHtml = unscannedUrls.length > 0
    ? `
      <details class="unscanned-dropdown">
        <summary class="unscanned-summary type-caption-tight">
          <div class="unscanned-summary-left">
            <svg class="toggle-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="unscanned-title">Preview: Discovered Unscanned URLs</span>
            <span class="unscanned-count-badge">${unscannedUrls.length} Discovered</span>
          </div>
          <span class="type-caption text-mute unscanned-note">Discovered via sitemap &amp; homepage links</span>
        </summary>
        <div class="unscanned-panel">
          <div class="unscanned-panel-bar">
            <p class="type-caption text-ash unscanned-desc">
              These URLs were discovered on <code>${esc(data.rootHost)}</code> but were not inspected because the multi-page scan sample limit was reached.
            </p>
            <div class="unscanned-actions">
              <button type="button" class="btn btn-secondary-dark unscanned-export-btn" id="export-unscanned-copy" data-urls="${esc(unscannedUrls.join('\n'))}">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                </svg>
                <span>Copy ${unscannedUrls.length} URLs</span>
              </button>
              <button type="button" class="btn btn-secondary-dark unscanned-export-btn" id="export-unscanned-download" data-host="${esc(data.rootHost)}" data-urls="${esc(unscannedUrls.join('\n'))}">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <span>Export .txt</span>
              </button>
            </div>
          </div>
          <ul class="unscanned-url-list" role="list">
            ${unscannedUrls.map((u, i) => `
              <li class="unscanned-url-item">
                <span class="unscanned-idx type-mono">${i + 1}</span>
                <span class="unscanned-url type-mono" title="${esc(u)}">${esc(u)}</span>
                <button type="button" class="unscanned-item-copy-btn" title="Copy URL" data-single-url="${esc(u)}" aria-label="Copy ${esc(u)}">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                  </svg>
                </button>
              </li>
            `).join('')}
          </ul>
        </div>
      </details>`
    : '';

  return `
    <div class="result-card scan-result">
      <div class="verdict ${isMixed ? 'verdict-mixed' : 'verdict-ok'}" role="status">
        ${esc(verdictText)}
      </div>
      <p class="type-caption text-mute coverage-line">
        ${esc(coverageText)}
        ${limitInfoHTML('page-limit-pop-coverage')}
        ${frontDoorText ? `<span>${esc(frontDoorText)}</span>` : ''}
      </p>
      <div class="stack-summary">
        ${pvTech ? techStackCard('hosting', pvTech) : stackCard('hosting', data.baselineProvider, collectEvidence((p) => !p.error && p.provider === data.baselineProvider))}
        ${fwTech ? techStackCard('framework', fwTech) : stackCard('framework', data.baselineFramework, collectEvidence((p) => !p.error && p.framework === data.baselineFramework))}
      </div>
      <details class="unscanned-dropdown scanned-dropdown"${isMixed ? ' open' : ''}>
        <summary class="unscanned-summary type-caption-tight">
          <div class="unscanned-summary-left">
            <svg class="toggle-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="unscanned-title">${esc(viewLabel)}</span>
            <span class="unscanned-count-badge ${isMixed ? 'badge-mixed' : 'badge-ok'}">${total} Scanned</span>
          </div>
          <span class="type-caption text-mute unscanned-note">${isMixed ? `${oddCount} variant${oddCount > 1 ? 's' : ''} detected` : 'All paths consistent'}</span>
        </summary>
        <div class="unscanned-panel">
          <div class="unscanned-panel-bar">
            <p class="type-caption text-ash unscanned-desc">
              Detailed platform and hosting breakdown across all <code>${total}</code> sampled URLs on <code>${esc(data.rootHost)}</code>.
            </p>
            <div class="unscanned-actions">
              <button type="button" class="btn btn-secondary-dark unscanned-export-btn" id="export-scanned-copy" data-urls="${esc(ordered.map((p) => p.url).join('\n'))}">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                </svg>
                <span>Copy ${total} URLs</span>
              </button>
              <button type="button" class="btn btn-secondary-dark unscanned-export-btn" id="export-scanned-download" data-host="${esc(data.rootHost)}" data-urls="${esc(ordered.map((p) => `${p.url}\t${p.framework}\t${p.provider}\t${p.confidence}`).join('\n'))}">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <span>Export .txt</span>
              </button>
            </div>
          </div>
          <ul class="unscanned-url-list" role="list">
            ${scannedItems}
          </ul>
        </div>
      </details>
      ${unscannedDropdownHtml}
      <div class="result-actions-row">
        <button type="button" class="btn btn-secondary-dark result-action" data-check-another>${esc(t.checkAnother)}</button>
        <button type="button" class="btn btn-secondary-dark result-action" data-copy-link data-url="${esc(shareUrl)}">${esc(t.copyLink)}</button>
      </div>
      <a href="mailto:hello@cmsdetectorai.com?subject=Result+feedback&body=${mailtoBody}" class="report-link type-caption">${esc(t.reportWrong)}</a>
    </div>`;
}

interface ActiveScanState {
  rootUrl: string;
  rootHost: string;
  sampleUrls: string[];
  unscannedUrls?: string[];
  foundApprox: number;
  robotsTxt: string;
  currentIndex: number;
  pages: any[];
  isPaused: boolean;
}

const ACTIVE_SCAN_KEY = 'cmsdetector_active_scan';
let activeScan: ActiveScanState | null = null;
let isScanRunning = false;

function saveActiveScan(st: ActiveScanState | null): void {
  activeScan = st;
  try {
    if (st) sessionStorage.setItem(ACTIVE_SCAN_KEY, JSON.stringify(st));
    else sessionStorage.removeItem(ACTIVE_SCAN_KEY);
  } catch {}
}

function loadActiveScan(): ActiveScanState | null {
  try {
    const raw = sessionStorage.getItem(ACTIVE_SCAN_KEY);
    return raw ? JSON.parse(raw) : null;
  } catch { return null; }
}

function renderResumeBanner(st: ActiveScanState): void {
  if (!errorEl) return;
  const scanned = st.currentIndex;
  const total = st.sampleUrls.length;
  errorEl.innerHTML = `
    <div class="error-card card-dark" style="border-color: rgba(255, 255, 255, 0.2);">
      <span class="badge badge-error" style="background-color: #fbbf24; color: #451a03;">Scan paused</span>
      <p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">
        Multi-page scan paused (${scanned} of ${total} paths scanned).
      </p>
      <div style="margin-block-start: 12px; display: flex; gap: 8px; flex-wrap: wrap;">
        <button type="button" class="btn btn-primary resume-scan-btn" style="min-height: 44px;">Resume scan</button>
        <button type="button" class="btn btn-secondary-dark cancel-scan-btn" style="min-height: 44px;">Cancel</button>
      </div>
    </div>`;
  errorEl.hidden = false;
  errorEl.querySelector('.resume-scan-btn')?.addEventListener('click', () => {
    errorEl.hidden = true;
    resumeScanLoop();
  });
  errorEl.querySelector('.cancel-scan-btn')?.addEventListener('click', () => {
    saveActiveScan(null);
    errorEl.hidden = true;
    setLoading(false);
  });
}

async function resumeScanLoop(): Promise<void> {
  if (!activeScan || isScanRunning) return;
  isScanRunning = true;
  setLoading(true);

  try {
    while (activeScan && activeScan.currentIndex < activeScan.sampleUrls.length) {
      if (activeScan.isPaused) {
        isScanRunning = false;
        renderResumeBanner(activeScan);
        return;
      }
      const idx = activeScan.currentIndex;
      const pageUrl = activeScan.sampleUrls[idx];
      if (submitBtn) {
        submitBtn.innerHTML = `<span>Scanning path ${idx + 1}/${activeScan.sampleUrls.length}…</span>`;
      }
      const statusTicker = document.getElementById('cms-loading-status-text');
      if (statusTicker) {
        let displayPth = pageUrl;
        try { displayPth = new URL(pageUrl).pathname || '/'; } catch {}
        statusTicker.textContent = `Scanning path ${idx + 1} of ${activeScan.sampleUrls.length}: ${displayPth}`;
      }
      const stepIdx = (idx % 4) + 1;
      for (let i = 1; i <= 4; i++) {
        const el = document.getElementById(`cms-step-${i}`);
        if (el) el.classList.toggle('active', i === stepIdx);
      }

      // Step fetch with 1 retry on network error/5xx
      let pageData: any = null;
      for (let attempt = 0; attempt < 2; attempt++) {
        try {
          const stepRes = await fetch('/api/scan/step', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              pageUrl,
              rootHost: activeScan.rootHost,
              robotsTxt: activeScan.robotsTxt,
            }),
          });
          const stepJson = await stepRes.json();
          if (stepJson.ok && stepJson.data) {
            pageData = stepJson.data;
            break;
          }
        } catch {
          if (attempt === 0) await new Promise((r) => setTimeout(r, 400));
        }
      }

      if (!pageData) {
        // Failed step marks that URL unscanned, NEVER consistent
        let pth = '/';
        try { pth = new URL(pageUrl).pathname; } catch {}
        pageData = {
          url: pageUrl,
          path: pth,
          error: 'TIMEOUT',
          framework: 'Unscanned',
          provider: 'Unscanned',
          crossDomainRedirect: false,
          status: 0,
          timingMs: 0,
          confidence: 'Low',
        };
      }

      activeScan.pages.push(pageData);
      activeScan.currentIndex++;
      saveActiveScan(activeScan);
    }

    // All steps completed -> call /api/scan/complete
    if (submitBtn) submitBtn.innerHTML = '<span>Analysing results…</span>';
    const statusTicker = document.getElementById('cms-loading-status-text');
    if (statusTicker) statusTicker.textContent = 'Aggregating deterministic evidence across paths…';

    const compRes = await fetch('/api/scan/complete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        rootUrl: activeScan.rootUrl,
        rootHost: activeScan.rootHost,
        pages: activeScan.pages,
        coverage: {
          checked: activeScan.pages.filter((p: any) => !p.error && !p.skippedByRobots).length,
          foundApprox: activeScan.foundApprox,
          truncated: false,
        },
      }),
    });
    const compJson = await compRes.json();
    setLoading(false);
    isScanRunning = false;

    if (compJson.ok && compJson.data && resultEl) {
      const finishedRoot = activeScan.rootUrl;
      const unscanned = activeScan.unscannedUrls || [];
      saveActiveScan(null);
      saveRecent(finishedRoot);
      renderRecent();
      resultEl.innerHTML = renderScanSummary({
        ...compJson.data,
        unscannedUrls: unscanned,
      });
      resultEl.hidden = false;
      initLimitInfo(resultEl);
      wireScanActions(resultEl);
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      const code = compJson.error?.code ?? 'UNKNOWN';
      if (errorEl) {
        errorEl.innerHTML = `<div class="error-card card-dark"><span class="badge badge-error">Error</span>
          <p class="type-body-sm text-ash">${esc(ERROR_MESSAGES[code] ?? ERROR_MESSAGES['UNKNOWN'])}</p>
          <div style="margin-block-start: 12px;"><button type="button" class="btn btn-secondary-dark detect-retry-btn" style="min-height: 44px;">Try again</button></div></div>`;
        errorEl.hidden = false;
        errorEl.querySelector('.detect-retry-btn')?.addEventListener('click', () => resumeScanLoop());
      }
    }
  } catch {
    setLoading(false);
    isScanRunning = false;
    if (activeScan) {
      renderResumeBanner(activeScan);
    } else if (errorEl) {
      errorEl.innerHTML = `<div class="error-card card-dark"><span class="badge badge-error">Network error</span>
        <p class="type-body-sm text-ash">Could not reach the scan API.</p></div>`;
      errorEl.hidden = false;
    }
  }
}

async function runSiteScan(rawUrl: string): Promise<void> {
  if (!resultEl || !errorEl) return;
  const url = rawUrl.trim();
  if (!url) return;
  setLoading(true);
  if (submitBtn) submitBtn.innerHTML = '<span>Planning scan…</span>';

  try {
    const token = await getTurnstileToken();
    const planRes = await fetch('/api/scan/plan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, extraUrls: parseExtraUrls(), token }),
    });
    const planData = await planRes.json();
    if (!planData.ok) {
      setLoading(false);
      const code = planData.error?.code ?? 'UNKNOWN';
      const retryable = ['TIMEOUT', 'HTTP_ERROR', 'RATE_LIMITED', 'INTERNAL', 'UNKNOWN'].includes(code);
      const retryHtml = retryable
        ? `<div style="margin-block-start: 12px;"><button type="button" class="btn btn-secondary-dark detect-retry-btn" style="min-height: 44px;">Try again</button></div>`
        : '';
      errorEl.innerHTML = `<div class="error-card card-dark"><span class="badge badge-error">Error</span>
        <p class="type-body-sm text-ash">${esc(ERROR_MESSAGES[code] ?? ERROR_MESSAGES['UNKNOWN'])}</p>${retryHtml}</div>`;
      errorEl.hidden = false;
      if (retryable) {
        errorEl.querySelector('.detect-retry-btn')?.addEventListener('click', () => runSiteScan(url));
      }
      return;
    }

    const { rootUrl, rootHost, sampleUrls, unscannedUrls = [], foundApprox, robotsTxt } = planData.data;
    saveActiveScan({
      rootUrl,
      rootHost,
      sampleUrls,
      unscannedUrls,
      foundApprox,
      robotsTxt,
      currentIndex: 0,
      pages: [],
      isPaused: false,
    });

    await resumeScanLoop();
  } catch {
    setLoading(false);
    if (errorEl) {
      errorEl.innerHTML = `<div class="error-card card-dark"><span class="badge badge-error">Network error</span>
        <p class="type-body-sm text-ash">Could not reach the scan API. Check your connection and try again.</p>
        <div style="margin-block-start: 12px;"><button type="button" class="btn btn-secondary-dark detect-retry-btn" style="min-height: 44px;">Try again</button></div></div>`;
      errorEl.hidden = false;
      errorEl.querySelector('.detect-retry-btn')?.addEventListener('click', () => runSiteScan(url));
    }
  }
}

// ----------------------------------------------------------------
// Auto-run from ?url= query param
// ----------------------------------------------------------------
function init(): void {
  renderRecent();
  initLimitInfo(document);

  // Check for interrupted multi-URL scan from sessionStorage
  const pending = loadActiveScan();
  if (pending && pending.currentIndex < pending.sampleUrls.length) {
    activeScan = pending;
    activeScan.isPaused = true;
    renderResumeBanner(activeScan);
  }

  // Handle visibility change (background tab suspension resilience)
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden' && activeScan && isScanRunning) {
      activeScan.isPaused = true;
      saveActiveScan(activeScan);
    } else if (document.visibilityState === 'visible' && activeScan && activeScan.isPaused) {
      renderResumeBanner(activeScan);
    }
  });

  // Shareable result views are pre-rendered as "/" — mark them noindex at
  // runtime too (belt-and-braces next to the canonical pointing at "/").
  const params = new URLSearchParams(window.location.search);
  if (params.has('url') && !document.querySelector('meta[name="robots"]')) {
    const meta = document.createElement('meta');
    meta.name = 'robots';
    meta.content = 'noindex, nofollow';
    document.head.appendChild(meta);
  }

  // Auto-focus input
  input?.focus();

  // Handle ?url=... for shareable links
  const urlParam = params.get('url');
  if (urlParam && input) {
    input.value = urlParam;
    runDetect(urlParam);
  }

  // Form submit — single-page scan by default (multi-path scan when toggled on).
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const url = input?.value.trim() ?? '';
    if (!url) return;
    const multi = (document.getElementById('multipage-toggle') as HTMLInputElement | null)?.checked ?? false;
    if (multi) runSiteScan(url);
    else runDetect(url);
  });

  document.getElementById('recent-clear')?.addEventListener('click', () => {
    clearRecent();
    input?.focus();
  });

  const clearBtn = document.getElementById('detect-clear-btn');
  function updateClearBtn() {
    if (!clearBtn || !input) return;
    clearBtn.hidden = !input.value.trim();
  }
  input?.addEventListener('input', updateClearBtn);
  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
      updateClearBtn();
    }
  });
  updateClearBtn();

  document.querySelectorAll<HTMLButtonElement>('[data-cms-preset]').forEach((presetBtn) => {
    presetBtn.addEventListener('click', () => {
      const p = presetBtn.dataset.cmsPreset;
      if (p && input && form) {
        input.value = p;
        updateClearBtn();
        form.requestSubmit();
      }
    });
  });

  document.getElementById('final-cta-trigger')?.addEventListener('click', () => {
    input?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    input?.focus();
  });
}

init();
</script>

