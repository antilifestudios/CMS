<script>
// ----------------------------------------------------------------
// Client-side detection UI island
// ----------------------------------------------------------------

const STORAGE_KEY = 'cmsdetector_recent';
const MAX_RECENT  = 5;

// Error messages (client-side translation)
const ERROR_MESSAGES: Record<string, string> = {
  INVALID_URL:      'Please enter a valid website URL (e.g. https://example.com).',
  BLOCKED_TARGET:   'Private, internal, or restricted addresses cannot be scanned for security reasons.',
  TARGET_BLOCKED:   'This site returned an automated bot-challenge or access restriction. We cannot scan challenge pages.',
  TIMEOUT:          'The request timed out after 8 seconds. The site may be slow or blocking automated access.',
  TLS_ERROR:        'The site has a secure TLS/SSL certificate error. We cannot safely connect to it.',
  DNS_FAILED:       'We couldn\'t resolve the domain name. Double-check the URL spelling and try again.',
  HTTP_ERROR:       'The target website returned a server error. Please try again later.',
  NOT_HTML:         'The URL returned a non-HTML document (such as binary data, an image, or an API payload).',
  TOO_LARGE:        'The response exceeded the maximum allowed size for analysis.',
  RATE_LIMITED:     'Too many requests. Please wait a moment and try again.',
  BUDGET_EXCEEDED:  'The subrequest budget limit was exceeded for this scan.',
  INTERNAL:         'An unexpected internal error occurred while processing the request.',
  PRIVATE_IP:       'Private or internal addresses can\'t be checked for security reasons.',
  BLOCKED:          'This site returned a bot-protection response. We cannot scan challenge pages.',
  DNS_FAILURE:      'We couldn\'t resolve the domain. Double-check the URL and try again.',
  INVALID_TLS:      'The site has a TLS certificate error. We can\'t safely connect to it.',
  NON_HTML:         'The URL returned a non-HTML response.',
  CLIENT_RENDERED:  'The page appears to be a client-rendered shell. We detected some hints:',
  REDIRECT_LOOP:    'We detected a redirect loop and stopped following redirects.',
  TURNSTILE_FAILED: 'Bot verification failed. Please try again.',
  UNKNOWN:          'An unexpected error occurred. Please try again.',
};

// Badge vocabulary is exactly three levels everywhere. Pipeline labels
// are mapped display-only (the /api/detect shape is unchanged).
function confLevel(label: string): 'High' | 'Medium' | 'Low' {
  if (label === 'confirmed' || label === 'High') return 'High';
  if (label === 'possible' || label === 'Low') return 'Low';
  return 'Medium';
}

function confWord(level: string): string {
  const t = getScanCopy();
  return level === 'High' ? t.confHigh : level === 'Low' ? t.confLow : t.confMedium;
}

function confClass(level: string): string {
  return level === 'High' ? 'conf-high' : level === 'Low' ? 'conf-low' : 'conf-medium';
}

// Badge text is just the level; the tooltip explains what confidence
// means and shows on hover AND keyboard focus.
function confBadge(level: string, tipId: string): string {
  const t = getScanCopy();
  return `<span class="badge ${confClass(level)} conf-badge" tabindex="0" aria-describedby="${tipId}">`
    + `${esc(confWord(level))}`
    + `<span class="conf-tip" role="tooltip" id="${tipId}">${esc(t.confidenceTooltip)}</span>`
    + `</span>`;
}

function renderConfidenceChip(label: 'confirmed' | 'likely' | 'possible', tipId: string): string {
  return confBadge(confLevel(label), tipId);
}

const CATEGORY_LABELS: Record<string, string> = {
  cms:        'CMS / Platform',
  builder:    'Site Builder',
  ecommerce:  'E-commerce',
  framework:  'Framework',
  hosting:    'Hosting & CDN',
  theme:      'Theme',
  plugin:     'Plugins',
  analytics:  'Analytics',
  advertising:'Advertising',
  marketing:  'Marketing',
  payments:   'Payments',
  chat:       'Chat & Support',
  privacy:    'Privacy / Consent',
  security:   'Security',
  other:      'Other',
};

const SIGNAL_LABELS: Record<string, string> = {
  'meta-generator': 'Generator meta tag',
  'html-path':      'HTML asset path',
  'html-regex':     'HTML pattern',
  'script-host':    'Script hostname',
  'stylesheet-url': 'Stylesheet URL',
  'js-global':      'JavaScript global',
  'inline-script':  'Inline script',
  'meta-tag':       'Meta tag',
  'link-relation':  'Link relation',
  'header':         'HTTP header',
  'cookie-name':    'Cookie name',
  'probe':          'Secondary probe',
};

// ----------------------------------------------------------------
// DOM refs
// ----------------------------------------------------------------
const form       = document.getElementById('detect-form') as HTMLFormElement | null;
const input      = document.getElementById('url-input')   as HTMLInputElement | null;
const submitBtn  = document.getElementById('detect-submit') as HTMLButtonElement | null;
const loadingEl  = document.getElementById('result-loading') as HTMLElement | null;
const resultEl   = document.getElementById('result-panel')   as HTMLElement | null;
const errorEl    = document.getElementById('error-panel')    as HTMLElement | null;
const recentEl   = document.getElementById('recent-checks')  as HTMLElement | null;
const recentList = document.getElementById('recent-list')    as HTMLUListElement | null;

// ----------------------------------------------------------------
// Recent checks — localStorage only, stored on successful scans only.
// Normalised form: trim, lowercase, strip protocol, strip leading
// "www.", strip path/query/fragment and trailing slash.
// ----------------------------------------------------------------
function normalizeDomain(raw: string): string {
  let s = raw.trim().toLowerCase();
  if (!s) return '';
  s = s.replace(/^https?:\/\//, '');
  s = s.split(/[/?#]/)[0];
  if (s.startsWith('www.')) s = s.slice(4);
  s = s.replace(/:\d+$/, '');
  s = s.replace(/\.+$/, '');
  if (!/^[\w.-]+\.[a-z]{2,}$/i.test(s)) return '';
  return s;
}

function loadRecent(): string[] {
  try {
    const parsed: unknown = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]');
    if (!Array.isArray(parsed)) return [];
    return parsed.filter((u): u is string => typeof u === 'string' && u.length > 0).slice(0, MAX_RECENT);
  } catch { return []; }
}

function saveRecent(rawUrl: string): void {
  const domain = normalizeDomain(rawUrl);
  if (!domain) return;
  const list = [domain, ...loadRecent().filter((u) => normalizeDomain(u) !== domain)].slice(0, MAX_RECENT);
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch { /* storage unavailable — page still works */ }
}

function clearRecent(): void {
  try { localStorage.removeItem(STORAGE_KEY); } catch { /* noop */ }
  renderRecent();
}

function runCurrentMode(url: string): void {
  const multi = (document.getElementById('multipage-toggle') as HTMLInputElement | null)?.checked ?? false;
  if (multi) void runSiteScan(url);
  else void runDetect(url);
}

function renderRecent(): void {
  const list = loadRecent();
  if (!recentList || !recentEl) return;

  recentList.innerHTML = '';
  list.forEach((domain) => {
    const li = document.createElement('li');
    const btn = document.createElement('button');
    btn.className = 'btn btn-secondary-dark recent-btn';
    btn.textContent = domain;
    btn.title = domain;
    btn.type = 'button';
    btn.addEventListener('click', () => {
      if (input) input.value = domain;
      runCurrentMode(domain);
    });
    li.appendChild(btn);
    recentList.appendChild(li);
  });

  recentEl.hidden = list.length === 0;
}

// ----------------------------------------------------------------
// HTML sanitiser (for evidence artifacts from the page)
// ----------------------------------------------------------------
function esc(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// ----------------------------------------------------------------
// Result rendering
// ----------------------------------------------------------------
interface Evidence {
  type: string;
  artifact: string;
  weight: number;
}

interface Detection {
  id: string;
  name: string;
  category: string;
  confidence: number;
  confidenceLabel: 'confirmed' | 'likely' | 'possible';
  version?: string;
  evidence: Evidence[];
  pageSlug?: string;
}

function renderDetection(d: Detection): string {
  const slug = d.pageSlug ?? d.id;
  const versionStr = d.version ? ` <span class="text-mute type-caption">v${esc(d.version)}</span>` : '';
  const showInHeadline = d.confidenceLabel === 'confirmed' || d.confidenceLabel === 'likely';

  if (!showInHeadline) return '';

  const evidenceHtml = d.evidence
    .map((e) => `
      <li class="evidence-item">
        <span class="type-mono-micro evidence-type">${esc(SIGNAL_LABELS[e.type] ?? e.type)}</span>
        <code class="evidence-artifact">${esc(e.artifact)}</code>
      </li>`)
    .join('');

  return `
    <div class="detection-card" data-id="${esc(d.id)}">
      <div class="detection-header">
        <div class="detection-name-row">
          <span class="type-heading-sm detection-name">
            ${esc(d.name)}
            ${versionStr}
          </span>
          ${renderConfidenceChip(d.confidenceLabel, `conf-tip-single-${esc(d.id)}`)}
        </div>
        <span class="type-mono-caps text-mute category-label">${esc(CATEGORY_LABELS[d.category] ?? d.category)}</span>
      </div>

      <details class="evidence-section">
        <summary class="evidence-toggle type-caption-tight">
          <span>Why we think this</span>
          <svg class="toggle-icon" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <ul class="evidence-list" role="list">
          ${evidenceHtml}
        </ul>
      </details>
    </div>`;
}

function groupByCategory(results: Detection[]): Map<string, Detection[]> {
  const map = new Map<string, Detection[]>();
  for (const r of results) {
    const cat = r.category;
    if (!map.has(cat)) map.set(cat, []);
    map.get(cat)!.push(r);
  }
  return map;
}

function renderResults(data: {
  finalUrl: string;
  results: Detection[];
  isClientRendered: boolean;
}): string {
  const { finalUrl, results, isClientRendered } = data;

  const headlineResult = results.find(
    (r) => (r.confidenceLabel === 'confirmed' || r.confidenceLabel === 'likely') &&
           (r.category === 'cms' || r.category === 'builder' || r.category === 'ecommerce')
  );

  const displayUrl = finalUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
  const mailtoBody = encodeURIComponent(
    `URL: ${finalUrl}\nDetected: ${results.map((r) => r.name).join(', ') || 'nothing'}\nExpected: `
  );

  const groups = groupByCategory(results);
  const groupHtml = [...groups.entries()]
    .map(([_cat, items]) => items.map(renderDetection).join(''))
    .join('');

  const noMatch = results.filter(
    (r) => r.confidenceLabel === 'confirmed' || r.confidenceLabel === 'likely'
  ).length === 0;
  const t = getScanCopy();
  const shareHref = `/?url=${encodeURIComponent(finalUrl)}`;

  return `
    <div class="result-card">
      <div class="result-header">
        <div>
          <p class="type-mono-caps text-mute" style="margin: 0 0 4px 0;">Detection results for</p>
          <h2 class="type-heading-md result-url">${esc(displayUrl)}</h2>
        </div>
      </div>

      ${isClientRendered
        ? `<div class="alert-blue" style="margin-block: 16px;">
             <strong>Client-rendered site:</strong> This page returned an empty HTML shell.
             The site likely uses a JavaScript framework. We detected some technology hints below.
           </div>`
        : ''
      }

      ${noMatch
        ? `<div class="no-match-card card-dark" style="margin-block-start: 16px;">
             <p class="type-heading-sm" style="margin: 0 0 8px 0;">No known platform detected</p>
             <p class="type-body-sm text-ash" style="margin: 0 0 16px 0;">
               This site may be custom-built. Try <a href="/blog/how-to-find-a-cms"
               class="text-link-dark">these manual methods</a> to investigate further.
             </p>
           </div>`
        : groupHtml
      }

      <div class="result-actions-row">
        <button type="button" class="btn btn-secondary-dark result-action" data-check-another>${esc(t.checkAnother)}</button>
        <button type="button" class="btn btn-secondary-dark result-action" data-copy-link data-url="${esc(shareHref)}">${esc(t.copyLink)}</button>
      </div>
      <a href="mailto:hello@cmsdetectorai.com?subject=Result+feedback&body=${mailtoBody}" class="report-link type-caption">${esc(t.reportWrong)}</a>
    </div>`;
}

// ----------------------------------------------------------------
// Bot-protection result (explicit scan state, not a generic error).
// The challenge page's scripts are never reported as technologies —
// partials below are header/cookie-level detections only.
// ----------------------------------------------------------------
interface BotProtection {
  status?: string;
  httpStatus?: number;
  provider?: { name?: string; confidence?: number; evidence?: string[] } | null;
  responseHeaders?: Record<string, string>;
  limitations?: string[];
}

function renderBotProtection(
  err: { httpStatus?: number; partialResults?: Detection[]; botProtection?: BotProtection },
  rawUrl: string
): string {
  const bp = err.botProtection ?? {};
  const prot = bp.provider ?? null;
  const pct = typeof prot?.confidence === 'number' ? Math.round(prot.confidence * 100) : null;
  const status = typeof bp.httpStatus === 'number' ? bp.httpStatus
    : typeof err.httpStatus === 'number' ? err.httpStatus : null;
  const displayUrl = rawUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
  const mailtoBody = encodeURIComponent(`URL: ${rawUrl}\nDetected: bot protection (${prot?.name ?? 'unidentified'})\nExpected: `);

  const evItems = (prot?.evidence ?? []).map((e) => `
    <li class="evidence-item"><code class="evidence-artifact">${esc(e)}</code></li>`).join('');
  const headerItems = Object.entries(bp.responseHeaders ?? {}).map(([k, v]) => `
    <li class="evidence-item">
      <span class="type-mono-micro evidence-type">${esc(k)}</span>
      <code class="evidence-artifact">${esc(v)}</code>
    </li>`).join('');

  const partials = (err.partialResults ?? []).filter(
    (r) => typeof (r as { score?: number }).score === 'number'
      ? ((r as { score?: number }).score ?? 0) >= 40
      : r.confidenceLabel === 'confirmed' || r.confidenceLabel === 'likely'
  );
  const partialHtml = partials.length === 0
    ? `<p class="type-body-sm text-ash" style="margin: 0;">The blocking response carried no identifiable technology headers or cookies either.</p>`
    : `<ul class="evidence-list" role="list">${partials.map((r) => `
      <li class="evidence-item">
        <span class="type-mono-micro evidence-type">${esc(CATEGORY_LABELS[r.category] ?? r.category)}</span>
        <code class="evidence-artifact">${esc(r.name)} — header/cookie evidence only</code>
      </li>`).join('')}</ul>`;

  return `
    <div class="result-card">
      <div class="result-header"><div>
        <p class="type-mono-caps text-mute" style="margin: 0 0 4px 0;">Bot protection detected</p>
        <h2 class="type-heading-md result-url">${esc(displayUrl)}</h2>
      </div></div>
      <p class="type-body-sm text-ash" style="margin: 0;">
        This website is protected against automated requests. We could inspect the
        protection layer, but the site's normal page could not be retrieved —
        full technology detection was not possible.
      </p>
      <div class="detection-card" data-id="bot-protection">
        <div class="detection-header"><div class="detection-name-row">
          <span class="type-heading-sm detection-name">${esc(prot?.name ?? 'Unknown protection layer')}</span>
          ${pct !== null ? `<span class="badge conf-medium conf-badge">${esc(String(pct))}%</span>` : ''}
        </div>
        <span class="type-mono-caps text-mute category-label">Protection${status !== null ? ` · Status ${esc(String(status))}` : ''}</span>
        </div>
        ${evItems || headerItems ? `<ul class="evidence-list" role="list">${evItems}${headerItems}</ul>` : ''}
        ${(bp.limitations ?? []).length > 0 ? `<p class="type-caption text-mute" style="margin: 8px 0 0 0;">${esc(bp.limitations!.join(' '))}</p>` : ''}
      </div>
      <p class="type-caption-tight text-mute" style="margin: 0;">Limited detection — from response headers and cookies only:</p>
      ${partialHtml}
      <div class="result-actions-row">
        <button type="button" class="btn btn-secondary-dark result-action" data-check-another>${esc(t_checkAnother())}</button>
      </div>
      <a href="mailto:hello@cmsdetectorai.com?subject=Result+feedback&body=${mailtoBody}" class="report-link type-caption">Report a wrong result</a>
    </div>`;
}

// Minimal accessor (avoids threading locale copy through the new branch).
function t_checkAnother(): string {
  return document.getElementById('detector-root')?.dataset?.checkAnother ?? 'Check another site';
}

// ----------------------------------------------------------------
// Turnstile token (empty string when the challenge is not configured)
// ----------------------------------------------------------------
async function getTurnstileToken(): Promise<string> {
  try {
    const key = (document.querySelector('meta[name="turnstile-sitekey"]') as HTMLMetaElement | null)?.content ?? '';
    const t = (window as unknown as { turnstile?: { execute: (k: string, o: unknown) => Promise<string> } }).turnstile;
    if (key && t) return await t.execute(key, { action: 'detect' });
  } catch { /* challenge unavailable — server decides */ }
  return '';
}

// ----------------------------------------------------------------
// Detection runner
// ----------------------------------------------------------------
const CMS_SCAN_STAGES = [
  'Connecting to destination edge node…',
  'Analyzing HTML DOM structure & generator meta tags…',
  'Inspecting JavaScript bundles, asset paths & client runtimes…',
  'Auditing HTTP response headers, cookies & CDN edge layers…',
  'Cross-verifying multi-path consistency across discovered pages…',
  'Evaluating deterministic technology signatures…'
];
let cmsTickerInterval: any = null;

function startCmsTicker(): void {
  if (cmsTickerInterval) clearInterval(cmsTickerInterval);
  let idx = 0;
  const statusEl = document.getElementById('cms-loading-status-text');
  if (statusEl) statusEl.textContent = CMS_SCAN_STAGES[0];
  for (let i = 1; i <= 4; i++) {
    const el = document.getElementById(`cms-step-${i}`);
    if (el) el.classList.toggle('active', i === 1);
  }
  cmsTickerInterval = setInterval(() => {
    idx = (idx + 1) % CMS_SCAN_STAGES.length;
    if (statusEl && (!activeScan || activeScan.sampleUrls.length <= 1)) {
      statusEl.textContent = CMS_SCAN_STAGES[idx];
    }
    const stepIdx = (idx % 4) + 1;
    for (let i = 1; i <= 4; i++) {
      const el = document.getElementById(`cms-step-${i}`);
      if (el) el.classList.toggle('active', i === stepIdx);
    }
  }, 1400);
}

function stopCmsTicker(): void {
  if (cmsTickerInterval) {
    clearInterval(cmsTickerInterval);
    cmsTickerInterval = null;
  }
}

function setLoading(loading: boolean): void {
  if (!submitBtn || !loadingEl || !resultEl || !errorEl) return;
  if (loading) {
    submitBtn.disabled = true;
    submitBtn.innerHTML = `<span>Detecting…</span>`;
    loadingEl.hidden = false;
    resultEl.hidden  = true;
    errorEl.hidden   = true;
    startCmsTicker();
  } else {
    submitBtn.disabled = false;
    submitBtn.innerHTML = `
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span>Detect</span>`;
    loadingEl.hidden = true;
    stopCmsTicker();
  }
}

async function runDetect(rawUrl: string): Promise<void> {
  if (!resultEl || !errorEl) return;

  const url = rawUrl.trim();
  if (!url) return;

  setLoading(true);

  // Update URL bar for shareability
  const shareUrl = new URL(window.location.href);
  shareUrl.searchParams.set('url', url);
  window.history.replaceState({}, '', shareUrl.toString());

  try {
    const token = await getTurnstileToken();
    const res = await fetch('/api/detect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, token }),
    });

    const data = await res.json() as
      | { ok: true; data: { finalUrl: string; results: Detection[]; isClientRendered: boolean } }
      | { ok: false; error: { code: string; partialResults: Detection[] } };

    setLoading(false);

    if (data.ok) {
      saveRecent(url);
      renderRecent();
      resultEl.innerHTML = renderResults(data.data);
      resultEl.hidden = false;
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });

      wireScanActions(resultEl);
    } else {
      const code = data.error?.code ?? 'UNKNOWN';
      const bp = (data.error as { botProtection?: BotProtection } | undefined)?.botProtection;
      if (code === 'BLOCKED' && bp && bp.status === 'bot_protected') {
        errorEl.innerHTML = renderBotProtection(
          data.error as { httpStatus?: number; partialResults?: Detection[]; botProtection?: BotProtection },
          url
        );
        errorEl.hidden = false;
        wireScanActions(errorEl);
      } else {
      const msg  = ERROR_MESSAGES[code] ?? ERROR_MESSAGES['UNKNOWN'];
      const partial = data.error?.partialResults ?? [];

      let partialHtml = '';
      if (partial.length > 0) {
        partialHtml = `
          <div style="margin-block-start: 16px;">
            <p class="type-caption-tight text-mute" style="margin-block-end: 8px;">
              Despite the error, we detected:
            </p>
            ${partial.map(renderDetection).join('')}
          </div>`;
      }

      const retryable = ['TIMEOUT', 'HTTP_ERROR', 'RATE_LIMITED', 'INTERNAL', 'UNKNOWN', 'DNS_FAILED'].includes(code);
      const retryHtml = retryable
        ? `<div style="margin-block-start: 12px;"><button type="button" class="btn btn-secondary-dark detect-retry-btn" style="min-height: 44px; min-width: 44px;">Try again</button></div>`
        : '';

      errorEl.innerHTML = `
        <div class="error-card card-dark">
          <div style="display: flex; align-items: center; gap: 8px; margin-block-end: 8px;">
            <span class="badge badge-error">Error</span>
            <span class="type-caption-tight text-mute">${esc(code)}</span>
          </div>
          <p class="type-body-sm text-ash" style="margin: 0;">${esc(msg)}</p>
          ${retryHtml}
          ${partialHtml}
        </div>`;
      errorEl.hidden = false;
      if (retryable) {
        errorEl.querySelector('.detect-retry-btn')?.addEventListener('click', () => runDetect(url));
      }
      }
    }
  } catch (e) {
    setLoading(false);
    if (errorEl) {
      errorEl.innerHTML = `
        <div class="error-card card-dark">
          <span class="badge badge-error">Network error</span>
          <p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">
            Could not reach the detection API. Check your connection and try again.
          </p>
          <div style="margin-block-start: 12px;"><button type="button" class="btn btn-secondary-dark detect-retry-btn" style="min-height: 44px; min-width: 44px;">Try again</button></div>
        </div>`;
      errorEl.hidden = false;
      errorEl.querySelector('.detect-retry-btn')?.addEventListener('click', () => runDetect(url));
    }
  }
}

function parseExtraUrls(): string[] {
  const ta = document.getElementById('extra-urls-input') as HTMLTextAreaElement | null;
  if (!ta) return [];
  return ta.value.split('\n').map((s) => s.trim()).filter(Boolean).slice(0, 5);
}

// ----------------------------------------------------------------
// Result actions: secondary "check another" + compact copy link.
// Single primary per screen (the Detect submit); everything here
// is secondary or a text link.
// ----------------------------------------------------------------
async function copyText(text: string): Promise<boolean> {
  try {
    await navigator.clipboard.writeText(text);
    return true;
  } catch {
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
      return true;
    } catch { return false; }
  }
}

function wireScanActions(scope: ParentNode): void {
  const t = getScanCopy();
  scope.querySelectorAll('[data-check-another]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (resultEl) resultEl.hidden = true;
      if (errorEl) errorEl.hidden = true;
      if (input) {
        input.value = '';
        input.focus();
        const clearBtn = document.getElementById('detect-clear-btn');
        if (clearBtn) clearBtn.hidden = true;
      }
      try { window.history.replaceState({}, '', '/'); } catch { /* noop */ }
      document.getElementById('detector-root')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
  scope.querySelectorAll('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const href = b.dataset.url ?? window.location.href;
      const absolute = href.startsWith('http') ? href : `${window.location.origin}${href}`;
      const ok = await copyText(absolute);
      const original = b.textContent ?? t.copyLink;
      b.textContent = ok ? t.copiedLabel : t.copyLink;
      b.disabled = false;
      window.setTimeout(() => { b.textContent = original; }, 1600);
    });
  });

  // Export all discovered unscanned URLs to clipboard
  scope.querySelectorAll('#export-unscanned-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const urls = b.dataset.urls ?? '';
      const ok = await copyText(urls);
      const span = b.querySelector('span');
      if (span) {
        const orig = span.textContent;
        span.textContent = ok ? 'Copied URLs!' : 'Failed to Copy';
        setTimeout(() => { span.textContent = orig; }, 1800);
      }
    });
  });

  // Download discovered unscanned URLs as a text file
  scope.querySelectorAll('#export-unscanned-download').forEach((btn) => {
    btn.addEventListener('click', () => {
      const b = btn as HTMLButtonElement;
      const host = b.dataset.host || 'website';
      const urls = b.dataset.urls ?? '';
      const blob = new Blob([urls], { type: 'text/plain;charset=utf-8' });
      const dlUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = dlUrl;
      a.download = `unscanned-urls-${host}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(dlUrl);
    });
  });

  // Export all scanned URLs to clipboard
  scope.querySelectorAll('#export-scanned-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const urls = b.dataset.urls ?? '';
      const ok = await copyText(urls);
      const span = b.querySelector('span');
      if (span) {
        const orig = span.textContent;
        span.textContent = ok ? 'Copied URLs!' : 'Failed to Copy';
        setTimeout(() => { span.textContent = orig; }, 1800);
      }
    });
  });

  // Download scanned URLs with technology findings as a text file
  scope.querySelectorAll('#export-scanned-download').forEach((btn) => {
    btn.addEventListener('click', () => {
      const b = btn as HTMLButtonElement;
      const host = b.dataset.host || 'website';
      const urls = b.dataset.urls ?? '';
      const header = "URL\tCMS / Framework\tHosting Provider\tConfidence\n";
      const blob = new Blob([header + urls], { type: 'text/plain;charset=utf-8' });
      const dlUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = dlUrl;
      a.download = `scanned-pages-${host}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(dlUrl);
    });
  });

  // Copy single unscanned URL
  scope.querySelectorAll('[data-single-url]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const u = b.dataset.singleUrl ?? '';
      const ok = await copyText(u);
      b.style.color = ok ? 'var(--color-brand)' : 'var(--color-mute)';
      setTimeout(() => { b.style.color = ''; }, 1200);
    });
  });
}

