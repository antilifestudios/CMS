  /* One-Click Copy Button */
  .gm-copy-btn {
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--color-hairline-soft);
    color: var(--color-mute);
    border-radius: var(--radius-app-sm);
    font-size: 10.5px;
    font-family: var(--font-mono);
    padding: 4px 8px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    line-height: 1;
    transition: all 0.15s ease;
  }
  .gm-copy-btn:hover {
    color: var(--color-on-primary);
    border-color: var(--color-graphite);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Actions Bar */
  .gm-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: 12px;
  }
  .gm-action-btn {
    font-size: 13px;
    height: 38px;
    padding-inline: 16px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .gm-report-link {
    color: var(--color-mute);
    text-decoration: underline;
    text-underline-offset: 2px;
    padding: 8px 0;
    font-size: 13px;
    margin-inline-start: auto;
  }
  .gm-report-link:hover { color: var(--color-ash); }

  /* Empty State & Errors */
  .gm-empty-card {
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-app-lg);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gm-empty-title {
    margin: 0;
    color: var(--color-on-primary);
    font-size: 20px;
    font-weight: 600;
  }
  .gm-empty-body {
    margin: 0;
    font-size: 14px;
    color: var(--color-ash);
    line-height: 1.6;
  }
  .gm-empty-body a {
    color: var(--color-link-blue-soft);
    text-decoration: underline;
  }
  .gm-error-card {
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-app-lg);
    padding: var(--spacing-xl);
  }

  @media (max-width: 768px) {
    .gm-tech-grid { grid-template-columns: 1fr; }
    .gm-telemetry-grid { grid-template-columns: repeat(2, 1fr); }
    .gm-card { padding: var(--spacing-md); }
  }
</style>

<script>
(() => {
  const root = document.getElementById('gm-root');
  if (!root) return;

  const STORAGE_KEY = 'growth_recent';
  const MAX_RECENT = 5;

  const FAMILY_LABELS: Record<string, string> = {
    SCRIPT: 'Scripts & SDK Loaders',
    HTML: 'HTML Markers & DOM Elements',
    COOKIE: 'Cookies & Storage',
    VIA_GTM: 'Google Tag Manager Container',
    PLATFORM_IDENTIFIER: 'Platform Identifiers',
    NETWORK: 'HTTP Headers & DNS',
    META: 'Meta Tags',
    ASSET: 'Asset Paths',
  };

  const SCAN_STAGES = [
    'Scanning HTML DOM, script sources & iframe hosts for tracking tags…',
    'Auditing Google Tag Manager containers & deobfuscating tags…',
    'Inspecting advertising pixels, payment SDKs & live-chat widgets…',
    'Extracting measurement IDs (GA4, GTM, Meta Pixel, Stripe keys)…',
    'Analyzing behavioral analytics & CRM webhook initializers…',
  ];

  const ERROR_MESSAGES: Record<string, string> = {
    INVALID_URL: 'Please enter a valid website URL or domain (e.g. example.com or https://example.com).',
    BLOCKED_TARGET: 'Private, internal, or restricted addresses cannot be scanned for security reasons.',
    TARGET_BLOCKED: 'This site returned an automated bot-challenge or access restriction. We cannot scan challenge pages.',
    TIMEOUT: 'The request timed out after 8 seconds. The target site may be slow or blocking automated access.',
    TLS_ERROR: 'The site has a secure TLS/SSL certificate error. We cannot safely connect to it.',
    DNS_FAILED: "We couldn't resolve the domain name. Double-check the URL spelling and try again.",
    HTTP_ERROR: 'The target website returned a server error. Please try again later.',
    NOT_HTML: 'The URL returned a non-HTML document (such as binary data, an image, or an API payload).',
    TOO_LARGE: 'The response exceeded the maximum allowed size for analysis.',
    RATE_LIMITED: 'Too many requests. Please wait a moment and try again.',
    INTERNAL: 'An unexpected internal error occurred while processing the request.',
    UNKNOWN: 'An unexpected error occurred while analyzing the website. Please try again.',
  };

  const form = document.getElementById('gm-form') as HTMLFormElement | null;
  const input = document.getElementById('gm-input') as HTMLInputElement | null;
  const submitBtn = document.getElementById('gm-submit') as HTMLButtonElement | null;
  const clearBtn = document.getElementById('gm-clear-btn') as HTMLButtonElement | null;
  const loadEl = document.getElementById('gm-loading');
  const resEl = document.getElementById('gm-result');
  const errEl = document.getElementById('gm-error');
  const recentEl = document.getElementById('gm-recent');
  const recentList = document.getElementById('gm-recent-list');
  const recentClear = document.getElementById('gm-recent-clear');
  const statusTicker = document.getElementById('gm-loading-status-text');

  let tickerInterval: ReturnType<typeof setInterval> | null = null;

  function esc(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function normalizeDomain(raw: string): string {
    let s = String(raw ?? '').trim().toLowerCase();
    if (!s) return '';
    s = s.replace(/^https?:\/\//, '');
    s = s.split(/[/?#]/)[0];
    if (s.startsWith('www.')) s = s.slice(4);
    s = s.replace(/:\d+$/, '').replace(/\.+$/, '');
    if (!/^[\w.-]+\.[a-z]{2,}$/i.test(s)) return '';
    return s;
  }

  function loadRecent(): string[] {
    try {
      const p = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]');
      if (!Array.isArray(p)) return [];
      return p.filter((u) => typeof u === 'string' && u.length > 0).slice(0, MAX_RECENT);
    } catch { return []; }
  }

  function saveRecent(rawUrl: string) {
    const domain = normalizeDomain(rawUrl);
    if (!domain) return;
    const list = [domain, ...loadRecent().filter((u) => normalizeDomain(u) !== domain)].slice(0, MAX_RECENT);
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch { /* noop */ }
  }

  function renderRecent() {
    if (!recentList || !recentEl) return;
    recentList.innerHTML = '';
    const list = loadRecent();
    list.forEach((domain) => {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.className = 'gm-recent-btn';
      b.textContent = domain;
      b.title = domain;
      b.type = 'button';
      b.addEventListener('click', () => {
        if (input) {
          input.value = domain;
          updateClearBtn();
          run(domain);
        }
      });
      li.appendChild(b);
      recentList.appendChild(li);
    });
    recentEl.hidden = list.length === 0;
  }

  function updateClearBtn() {
    if (!clearBtn || !input) return;
    clearBtn.hidden = !input.value.trim();
  }

  function startTicker() {
    if (tickerInterval) clearInterval(tickerInterval);
    let idx = 0;
    if (statusTicker) statusTicker.textContent = SCAN_STAGES[0];
    tickerInterval = setInterval(() => {
      idx = (idx + 1) % SCAN_STAGES.length;
      if (statusTicker) statusTicker.textContent = SCAN_STAGES[idx];
      const stepIdx = (idx % 4) + 1;
      for (let i = 1; i <= 4; i++) {
        const el = document.getElementById(`gm-step-${i}`);
        if (el) el.classList.toggle('active', i === stepIdx);
      }
    }, 1200);
  }

  function stopTicker() {
    if (tickerInterval) {
      clearInterval(tickerInterval);
      tickerInterval = null;
    }
  }

  function setLoading(on: boolean) {
    if (!submitBtn || !loadEl || !resEl || !errEl) return;
    if (on) {
      submitBtn.disabled = true;
      submitBtn.classList.add('loading');
      loadEl.hidden = false;
      resEl.hidden = true;
      errEl.hidden = true;
      startTicker();
    } else {
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
      loadEl.hidden = true;
      stopTicker();
    }
  }

  function normLabel(score100: unknown, label: unknown): string {
    if (typeof score100 === 'number') {
      if (score100 >= 90) return 'VERY HIGH';
      if (score100 >= 75) return 'HIGH';
      if (score100 >= 60) return 'MEDIUM';
      return 'LOW';
    }
    const u = String(label ?? '').toUpperCase().replace(/-/g, ' ');
    if (u === 'VERY HIGH' || u === 'HIGH' || u === 'MEDIUM' || u === 'LOW') return u;
    if (u === 'CONFIRMED') return 'VERY HIGH';
    if (u === 'LIKELY') return 'HIGH';
    if (u === 'POSSIBLE') return 'LOW';
    return u || 'LOW';
  }

  function badgeClass(label: string): string {
    const u = normLabel(null, label);
    if (u === 'VERY HIGH') return 'gm-badge-very-high';
    if (u === 'HIGH') return 'gm-badge-high';
    if (u === 'MEDIUM') return 'gm-badge-medium';
    return 'gm-badge-low';
  }

  function splitEvidence(raw: unknown) {
    const s = String(raw ?? '').trim().replace(/^["']|["']$/g, '');
    if (!s) return { host: '', path: '', single: '', full: String(raw ?? '') };
    const m = s.match(/((?:https?:)?\/\/)?(([a-z0-9-]+\.)+[a-z]{2,})(:\d+)?(\/[^\s"'<>]*)?/i);
    if (m) {
      const host = (m[2] + (m[4] ?? '')).toLowerCase();
      let path = m[5] ?? '';
      if (path.length > 90) path = path.slice(0, 87) + '…';
      if (host.includes('.') && (path || s.length < 80)) {
        return { host, path: path || '', single: '', full: s };
      }
    }
    const single = s.length > 120 ? s.slice(0, 117) + '…' : s;
    return { host: '', path: '', single, full: s };
  }

  function evRowHtml(displayValue: unknown, fullRaw: unknown, description: unknown): string {
    const parts = splitEvidence(displayValue);
    const desc = String(description ?? '').trim();
    const text = parts.host
      ? `<span class="gm-ev-text" title="${esc(parts.full)}"><span class="gm-ev-host">${esc(parts.host)}</span>${parts.path ? `<span class="gm-ev-path">${esc(parts.path)}</span>` : ''}</span>`
      : `<span class="gm-ev-text" title="${esc(parts.full)}"><span class="gm-ev-single">${esc(parts.single || parts.full)}</span></span>`;
    return `<li class="gm-ev-row"><span class="gm-ev-main">${desc ? `<span class="gm-ev-desc">${esc(desc)}</span>` : ''}${text}</span><button type="button" class="gm-copy-btn" data-copy="${esc(parts.full || fullRaw || displayValue)}">Copy</button></li>`;
  }

  function buildCategoryGroups(t: any) {
    const byFamily = new Map<string, any[]>();
    for (const e of t.evidence ?? []) {
      const fam = e.family ?? 'HTML';
      if (!byFamily.has(fam)) byFamily.set(fam, []);
      byFamily.get(fam)!.push({ value: e.value ?? e.artifact ?? e.detail ?? '', description: e.detail ?? e.description ?? '' });
    }
    const names = [...byFamily.keys()].map((f) => FAMILY_LABELS[f] ?? f);
    const html = [...byFamily.entries()].map(([fam, items]) => `
      <li><span class="type-mono-caps text-mute gm-ev-group-label">${esc(FAMILY_LABELS[fam] ?? fam)}</span>
      <ul class="gm-ev-rows" role="list">
        ${items.map((e) => evRowHtml(e.value, e.value, e.description)).join('')}
      </ul></li>`).join('');
    return { count: byFamily.size, names, html };
  }

  function renderCard(d: any): string {
    const label = normLabel(d.score100 ?? d.score, d.band ?? d.confidence);
    const fams = typeof d.families === 'number' ? d.families : (d._groupCount ?? 1);
    const famNames = Array.isArray(d._famNames) && d._famNames.length ? d._famNames : null;
    const isLow = label === 'LOW';
    const ids = Array.isArray(d.extractedIds) ? d.extractedIds.filter((x: any) => x && x.value) : [];
    const idsHtml = ids.length
      ? `<div class="gm-ids-box"><span class="type-mono-caps text-mute gm-ids-lbl">Extracted Identifiers</span><ul class="gm-ids-list" role="list">${ids.map((x: any) => `
          <li class="gm-id-item">
            <div class="gm-id-meta">
              <span class="gm-id-kind">${esc(x.kind ?? 'ID')}</span>
              <span class="gm-id-val">${esc(x.value)}</span>
            </div>
            <button type="button" class="gm-copy-btn" data-copy="${esc(x.value)}">Copy</button>
          </li>`).join('')}</ul></div>`
      : '';
    const note = d.variantNote || d.subNote;
    const noteHtml = note ? `<p class="gm-variant-note">${esc(note)}</p>` : '';
    const webLink = d.website ? `<a href="${esc(d.website)}" target="_blank" rel="noopener noreferrer" class="gm-tech-link" title="Visit ${esc(d.name)}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>` : '';

    return `
    <article class="gm-card" data-cat="${esc(d._cat)}">
      <div class="gm-card-top">
        <div class="gm-tech-name-lockup">
          <h4 class="gm-tech-name">${esc(d.name)}</h4>
          ${webLink}
        </div>
        <span class="gm-badge ${badgeClass(label)}">${esc(label)}</span>
      </div>
      <p class="gm-fams-summary">Detected across ${fams} independent evidence famil${fams === 1 ? 'y' : 'ies'}</p>
      ${famNames ? `<p class="gm-fams-list">${esc(famNames.join(' + '))}</p>` : ''}
      ${noteHtml}
      ${isLow ? `<p class="gm-low-hint">Limited supporting evidence. Treat as a signal, not a guarantee.</p>` : ''}
      ${idsHtml}
      <details class="gm-ev">
        <summary class="gm-ev-toggle">
          <span>Why we think this</span>
          <svg class="gm-toggle-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <ul class="gm-ev-groups" role="list">${d._groupsHtml}</ul>
      </details>
    </article>`;
  }

  function botProtectionHtml(err: any, displayUrl: string): string {
    const bp = err.botProtection ?? {};
    const prot = bp.provider ?? null;
    const status = typeof bp.httpStatus === 'number' ? bp.httpStatus : (typeof err.httpStatus === 'number' ? err.httpStatus : null);
    const respHeaders = bp.responseHeaders ?? {};
    const headerRows = Object.entries(respHeaders).map(([k, v]) => evRowHtml(`${k}: ${v}`, `${k}: ${v}`, '')).join('');
    const protRows = (prot?.evidence ?? []).map((e: any) => evRowHtml(e, e, '')).join('');

    return `
    <div class="gm-report">
      <div class="gm-overview-card">
        <div class="gm-domain-lockup">
          <span class="type-mono-caps text-brand">Edge Challenge Detected</span>
          <h2 class="gm-domain-title">${esc(displayUrl)}</h2>
          <p class="type-body-sm text-ash" style="margin: 4px 0 0 0;">This website answered with a bot protection challenge. We could identify the protection layer, but normal client marketing tags could not be executed.</p>
        </div>
      </div>
      <article class="gm-card">
        <div class="gm-card-top">
          <h4 class="gm-tech-name">${esc(prot ? prot.name : 'Automated Edge Firewall')}</h4>
          <span class="gm-badge gm-badge-medium">CHALLENGE</span>
        </div>
        <p class="gm-fams-summary">Detected protection${status !== null ? ` · Status ${esc(String(status))}` : ''}</p>
        ${(protRows || headerRows) ? `<ul class="gm-ev-groups" role="list">
          ${protRows ? `<li><span class="type-mono-caps text-mute gm-ev-group-label">Evidence</span><ul class="gm-ev-rows" role="list">${protRows}</ul></li>` : ''}
          ${headerRows ? `<li><span class="type-mono-caps text-mute gm-ev-group-label">Response headers</span><ul class="gm-ev-rows" role="list">${headerRows}</ul></li>` : ''}
        </ul>` : ''}
      </article>
      ${actionsHtml()}
    </div>`;
  }

  function actionsHtml(): string {
    return `
    <div class="gm-actions">
      <button type="button" class="btn btn-secondary-dark gm-action-btn" data-gm-another>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        <span>Check another site</span>
      </button>
      <button type="button" class="btn btn-secondary-dark gm-action-btn" data-gm-copy>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <span>Copy link</span>
      </button>
      <a class="gm-report-link" href="mailto:hello@cmsdetectorai.com?subject=Marketing+Stack+Feedback">Report a wrong result</a>
    </div>`;
  }

  function wireActions(scope: HTMLElement) {
    scope.querySelectorAll('[data-gm-another]').forEach((b) => {
      b.addEventListener('click', () => {
        if (resEl) resEl.hidden = true;
        if (errEl) errEl.hidden = true;
        if (input) {
          input.value = '';
          updateClearBtn();
          input.focus();
        }
      });
    });

    scope.querySelectorAll('[data-gm-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        const btnEl = b as HTMLElement;
        const origHtml = btnEl.innerHTML;
        try {
          await navigator.clipboard.writeText(window.location.href);
          btnEl.textContent = 'Copied!';
        } catch {
          btnEl.textContent = 'Copied!';
        }
        setTimeout(() => { btnEl.innerHTML = origHtml; }, 1600);
      });
    });

    scope.querySelectorAll('.gm-copy-btn').forEach((b) => {
      b.addEventListener('click', async () => {
        const btnEl = b as HTMLElement;
        const raw = btnEl.getAttribute('data-copy') ?? '';
        const orig = btnEl.textContent ?? 'Copy';
        try {
          await navigator.clipboard.writeText(raw);
          btnEl.textContent = 'Copied!';
        } catch {
          btnEl.textContent = 'Copied!';
        }
        setTimeout(() => { btnEl.textContent = orig; }, 1200);
      });
    });
  }

  function wireCategoryTabs(scope: HTMLElement) {
    const tabs = scope.querySelectorAll<HTMLButtonElement>('.gm-tab-btn');
    const sections = scope.querySelectorAll<HTMLElement>('.gm-cat-section');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-cat-filter');
        tabs.forEach((t) => t.classList.toggle('active', t === tab));
        sections.forEach((sec) => {
          if (!target || target === 'all') {
            sec.hidden = false;
          } else {
            sec.hidden = sec.getAttribute('data-cat-id') !== target;
          }
        });
      });
    });
  }

  function renderReport(data: any, url: string) {
    const cats = Array.isArray(data.categories) ? data.categories : [];
    const displayUrl = String(data.finalUrl ?? url).replace(/^https?:\/\//, '').replace(/\/$/, '');
    const isHttps = /^https:\/\//i.test(String(data.finalUrl ?? url));
    const scannedAt = data.scannedAt ? new Date(data.scannedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Just now';

    const sorted: any[] = [];
    let totalIds = 0;
    for (const c of cats) {
      for (const t of c.technologies ?? []) {
        const score = typeof t.score100 === 'number' ? t.score100 : (typeof t.score === 'number' ? t.score : 0);
        if (score < 40) continue;
        const g = buildCategoryGroups(t);
        const ids = Array.isArray(t.extractedIds) ? t.extractedIds.filter((x: any) => x && x.value) : [];
        totalIds += ids.length;
        sorted.push({
          ...t,
          _cat: c.id,
          _catName: c.name ?? c.id,
          families: g.count,
          _groupCount: g.count,
          _famNames: g.names,
          _groupsHtml: g.html,
        });
      }
    }

    const byCat = new Map<string, { id: string; name: string; items: any[] }>();
    for (const r of sorted) {
      if (!byCat.has(r._cat)) byCat.set(r._cat, { id: r._cat, name: r._catName, items: [] });
      byCat.get(r._cat)!.items.push(r);
    }

    const highCount = sorted.filter((r) => {
      const l = normLabel(r.score100 ?? r.score, r.band ?? r.confidence);
      return l === 'HIGH' || l === 'VERY HIGH';
    }).length;

    const warnings = Array.isArray(data.warnings) ? data.warnings.filter(Boolean) : [];
    const warningsHtml = warnings.map((w: string) => `<p class="gm-notice">${esc(w)}</p>`).join('');

    // If completely empty
    if (sorted.length === 0) {
      return `
      <div class="gm-report">
        <div class="gm-overview-card">
          <div class="gm-domain-lockup">
            <div class="gm-domain-eyebrow"><span class="edge-dot"></span><span>Real-Time Edge Analysis</span></div>
            <div class="gm-domain-headline-row">
              <h2 class="gm-domain-title">${esc(displayUrl)}</h2>
              <span class="gm-domain-protocol-badge">${isHttps ? 'HTTPS' : 'HTTP'}</span>
            </div>
            <p class="gm-domain-meta">Scanned at ${esc(scannedAt)} · Verified against 38+ growth signatures</p>
          </div>
        </div>
        <div class="gm-empty-card">
          <h3 class="gm-empty-title">No growth &amp; marketing technologies detected</h3>
          <p class="gm-empty-body">We found no confident analytics, advertising, marketing, payment, or chat signals on this site. This means no supported technical signals were found in the static document — not that these technologies are definitely absent (they may be loaded dynamically via server-side tagging or after user consent). <a href="/">Try the full technology scan</a> for CMS, hosting, and framework detection.</p>
        </div>
        ${actionsHtml()}
      </div>`;
    }

    // Category Tabs
    const tabsHtml = `
    <div class="gm-tabs-row" role="tablist" aria-label="Category filters">
      <button type="button" class="gm-tab-btn active" data-cat-filter="all">All <span class="gm-tab-count">(${sorted.length})</span></button>
      ${[...byCat.values()].map((g) => `<button type="button" class="gm-tab-btn" data-cat-filter="${esc(g.id)}">${esc(g.name)} <span class="gm-tab-count">(${g.items.length})</span></button>`).join('')}
    </div>`;

    // Sections
    const sectionsHtml = [...byCat.values()].map((g) => `
      <section class="gm-cat-section" data-cat-id="${esc(g.id)}" aria-label="${esc(g.name)}">
        <div class="gm-cat-head">
          <h3 class="gm-cat-title">${esc(g.name)}</h3>
          <span class="type-mono-caps gm-cat-count">${g.items.length} technolog${g.items.length === 1 ? 'y' : 'ies'}</span>
        </div>
        <div class="gm-tech-grid">
          ${g.items.map(renderCard).join('')}
        </div>
      </section>`).join('');

    return `
    <div class="gm-report">
      <div class="gm-overview-card">
        <div class="gm-overview-top">
          <div class="gm-domain-lockup">
            <div class="gm-domain-eyebrow"><span class="edge-dot"></span><span>Real-Time Edge Analysis</span></div>
            <div class="gm-domain-headline-row">
              <h2 class="gm-domain-title">${esc(displayUrl)}</h2>
              <span class="gm-domain-protocol-badge">${isHttps ? 'HTTPS' : 'HTTP'}</span>
            </div>
            <p class="gm-domain-meta">Scanned at ${esc(scannedAt)} · Verified against 38+ growth signatures</p>
          </div>
        </div>
        <div class="gm-telemetry-grid">
          <div class="gm-telemetry-tile">
            <span class="gm-telemetry-label">Technologies</span>
            <span class="gm-telemetry-value">${sorted.length}</span>
          </div>
          <div class="gm-telemetry-tile">
            <span class="gm-telemetry-label">Categories</span>
            <span class="gm-telemetry-value">${byCat.size} / 5</span>
          </div>
          <div class="gm-telemetry-tile">
            <span class="gm-telemetry-label">High Confidence</span>
            <span class="gm-telemetry-value">${highCount}</span>
          </div>
          <div class="gm-telemetry-tile">
            <span class="gm-telemetry-label">Extracted IDs</span>
            <span class="gm-telemetry-value">${totalIds}</span>
          </div>
        </div>
        ${warningsHtml}
      </div>
      ${tabsHtml}
      ${sectionsHtml}
      ${actionsHtml()}
    </div>`;
  }

  function showError(err: any, url: string) {
    const code = err?.code ?? 'UNKNOWN';
    if ((code === 'BLOCKED' || code === 'TARGET_BLOCKED') && err?.botProtection && resEl) {
      const raw = String(err?.finalUrl ?? url ?? '').replace(/^https?:\/\//, '').replace(/\/$/, '');
      resEl.innerHTML = botProtectionHtml(err, raw || String(url ?? ''));
      resEl.hidden = false;
      if (errEl) errEl.hidden = true;
      wireActions(resEl);
      resEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
    if (!errEl) return;
    const retryable = ['TIMEOUT', 'HTTP_ERROR', 'RATE_LIMITED', 'INTERNAL', 'UNKNOWN', 'DNS_FAILED'].includes(code);
    const retryHtml = retryable
      ? `<div style="margin-block-start: 12px;"><button type="button" class="btn btn-secondary-dark gm-retry-btn">Try again</button></div>`
      : '';
    errEl.innerHTML = `
      <div class="gm-error-card">
        <span class="badge badge-error">Error</span>
        <p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">${esc(ERROR_MESSAGES[code] ?? ERROR_MESSAGES.UNKNOWN)}</p>
        ${retryHtml}
      </div>`;
    errEl.hidden = false;
    if (retryable) {
      errEl.querySelector('.gm-retry-btn')?.addEventListener('click', () => run(url));
    }
  }

  async function runDetect(url: string) {
    const res = await fetch('/api/growth-detect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url }),
    });
    const data = await res.json();
    setLoading(false);
    if (data.ok) {
      saveRecent(url);
      renderRecent();
      const payload = (data.data && typeof data.data === 'object') ? data.data : data;
      if (resEl) {
        resEl.innerHTML = renderReport(payload, url);
        resEl.hidden = false;
        wireActions(resEl);
        wireCategoryTabs(resEl);
        resEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    } else {
      showError(data.error ?? { code: 'UNKNOWN' }, url);
    }
  }

  async function run(url: string) {
    const clean = String(url ?? '').trim();
    if (!clean) return;
    try {
      const u = new URL(window.location.href);
      u.searchParams.set('url', clean);
      window.history.replaceState({}, '', u.toString());
    } catch { /* noop */ }
    setLoading(true);
    try {
      await runDetect(clean);
    } catch {
      setLoading(false);
      if (errEl) {
        errEl.innerHTML = `
          <div class="gm-error-card">
            <span class="badge badge-error">Network Error</span>
            <p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">Could not reach the detection API. Please check your internet connection and try again.</p>
            <div style="margin-block-start: 12px;"><button type="button" class="btn btn-secondary-dark gm-retry-btn">Try again</button></div>
          </div>`;
        errEl.hidden = false;
        errEl.querySelector('.gm-retry-btn')?.addEventListener('click', () => run(clean));
      }
    }
  }

  // Presets
  document.querySelectorAll<HTMLButtonElement>('.gm-preset-chip').forEach((btnEl) => {
    btnEl.addEventListener('click', () => {
      const p = btnEl.getAttribute('data-preset');
      if (p && input) {
        input.value = p;
        updateClearBtn();
        run(p);
      }
    });
  });

  input?.addEventListener('input', updateClearBtn);
  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
      updateClearBtn();
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input) run(input.value);
  });

  recentClear?.addEventListener('click', () => {
    try { localStorage.removeItem(STORAGE_KEY); } catch { /* noop */ }
    renderRecent();
    input?.focus();
  });

  renderRecent();
  updateClearBtn();

  // Check URL parameter on initial load
  const urlParam = new URLSearchParams(window.location.search).get('url');
  if (urlParam && input) {
    input.value = urlParam;
    updateClearBtn();
    run(urlParam);
  } else {
    input?.focus();
  }
})();
</script>
