---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CoverageDirectory from '../components/CoverageDirectory.astro';
import NavIcon from '../components/layout/NavIcon.astro';

const groups = [
  {
    label: 'Analytics',
    blurb: 'Measurement scripts, tag managers, and behavioural analytics.',
    items: ['Google Analytics', 'Google Tag Manager', 'Microsoft Clarity', 'Hotjar', 'Matomo', 'Plausible', 'Mixpanel', 'PostHog', 'Segment', 'Adobe Analytics'],
  },
  {
    label: 'Advertising',
    blurb: 'Ad platforms and conversion pixels matched by script host.',
    items: ['Google Ads', 'Google AdSense', 'Meta Pixel', 'TikTok Pixel', 'LinkedIn Insight Tag', 'Pinterest Tag', 'Reddit Pixel', 'Snapchat Pixel'],
  },
  {
    label: 'Marketing & CRM',
    blurb: 'Automation and CRM platforms matched by SDK and asset evidence.',
    items: ['HubSpot', 'Klaviyo', 'Mailchimp', 'ActiveCampaign', 'Marketo', 'Salesforce'],
  },
  {
    label: 'Payments & Checkout',
    blurb: 'Checkout and wallet providers matched by SDK scripts.',
    items: ['Stripe', 'PayPal', 'Razorpay', 'Square', 'Adyen', 'Apple Pay', 'Google Pay'],
  },
  {
    label: 'Chat & Support',
    blurb: 'Live-chat and customer support widgets matched by embed scripts.',
    items: ['Intercom', 'Zendesk', 'Crisp', 'Tawk.to', 'Drift', 'LiveChat', 'HubSpot Chat'],
  },
];

const faqs = [
  {
    q: 'How do you detect marketing technology on a website?',
    a: 'We perform a real-time, isolated edge inspection of the website. We match known vendor script hosts, SDK initialization calls, DOM elements, asset paths, tracking cookies, and Google Tag Manager (GTM) container tags. Passing mentions of a brand name in page copy or footer links are never counted.',
  },
  {
    q: 'Can this tool detect server-side tracking (GTM Server-Side, Segment, or CNAME cloaking)?',
    a: 'Server-side tagging routes data through first-party domains or backend APIs rather than loading third-party vendor scripts in the browser. When a site uses purely server-side tracking, third-party client scripts are intentionally absent from the DOM, so client-side scanners will not observe them. However, if any client SDK, cookie, or container hook remains, our scanner detects it.',
  },
  {
    q: 'How do you decompile or inspect Google Tag Manager (GTM) containers?',
    a: 'When our edge scanner detects a Google Tag Manager container ID (e.g. GTM-XXXX), we fetch the public container JavaScript bundle and parse the tags, triggers, and vendor endpoints registered inside it. This allows us to reveal advertising pixels and analytics tags that were bundled inside GTM.',
  },
  {
    q: 'What do the confidence ratings (Very High, High, Medium, Low) mean?',
    a: 'Confidence is computed mathematically using noisy-OR over distinct evidence types. "Very High" (90%+) indicates multiple independent technical evidence families (e.g., vendor script host + SDK initialization + extracted ID). "High" (75–89%) reflects direct canonical script loaders. "Medium" (60–74%) stems from verified DOM elements or container tags. "Low" (40–59%) indicates a single supporting hook or partial match.',
  },
  {
    q: 'Can this tool extract public measurement IDs like GA4 IDs or Meta Pixel IDs?',
    a: 'Yes. Wherever supported vendors expose initializers or embed parameters (such as Google Analytics Measurement IDs G-XXXXX, GTM container IDs GTM-XXXXX, Meta Pixel IDs, or Stripe publishable keys), our analyzer extracts and formats them for one-click copying.',
  },
  {
    q: 'Does this tool store the websites or URLs I submit?',
    a: 'No. Submitted URLs are evaluated in real time at the Cloudflare edge purely to execute the requested stack analysis. We do not store browsing history, track user identifiers, or log sensitive authentication tokens.',
  },
];
---
<Base
  title="What Marketing Tech Is This Site Using? Free MarTech Detector | CMS Detector AI"
  description="Detect the analytics, advertising pixels, marketing platforms, payment providers, and chat widgets any website uses — free, evidence-based, no sign-up."
  pagePath="/growth-marketing-detector"
  canonical="https://cmsdetectorai.com/growth-marketing-detector"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Growth & Marketing Tech Detector',
      url: 'https://cmsdetectorai.com/growth-marketing-detector',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'All',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'Detect the analytics, advertising pixels, marketing platforms, payment providers, and chat widgets any website uses — free, evidence-based, no sign-up.',
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
      inLanguage: 'en',
    },
  ]}
>
  {/* Hero / Interactive Checker */}
  <Section theme="dark" class="gm-hero-section" ariaLabelledby="growth-h1">
    <div class="container">
      <div class="gm-hero-shell">
        <div class="eyebrow-lockup">
          <div class="badge-glow" style="margin-block-end: 2px; align-self: flex-start;">
            <span class="dot"></span>
            <span>Real-Time MarTech Intelligence · Cloudflare Edge</span>
          </div>
          <div class="gm-eyebrow-row">
            <span class="eyebrow type-mono-eyebrow eyebrow-with-icon">
              <NavIcon name="growth" size={16} />Growth &amp; Marketing Tech Detector
            </span>
          </div>
          <h1 id="growth-h1" class="type-display-xl gm-hero-title">
            What Marketing Tech<br />Is This Site Using?
          </h1>
          <p class="type-subtitle text-ash gm-hero-sub">
            Detect analytics, advertising pixels, marketing platforms, payment
            providers, and chat widgets — with the exact evidence behind every
            finding. Free, instant, no sign-up.
          </p>
        </div>

        <div class="gm-scanner-container">
          <div class="gm-detector" id="gm-root">
            <form id="gm-form" class="gm-form" novalidate aria-label="Marketing Tech Detector">
              <div class="gm-search-bar">
                <div class="gm-search-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                </div>
                <label for="gm-input" class="sr-only">Website URL or Domain</label>
                <input
                  id="gm-input"
                  type="url"
                  inputmode="url"
                  autocomplete="url"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  class="gm-url-input"
                  placeholder="https://example.com or domain.com"
                  required
                />
                <button type="button" id="gm-clear-btn" class="gm-clear-btn" aria-label="Clear input" hidden>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </button>
                <button type="submit" class="btn btn-primary gm-detect-btn" id="gm-submit">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                  <span>Detect Stack</span>
                </button>
              </div>

              {/* Quick Presets (Verified Rich Working Examples) */}
              <div class="gm-preset-bar">
                <span class="type-mono-caps text-mute gm-preset-lbl">Try:</span>
                <div class="gm-preset-chips">
                  <button type="button" class="gm-preset-chip" data-preset="loom.com">loom.com</button>
                  <button type="button" class="gm-preset-chip" data-preset="notion.so">notion.so</button>
                  <button type="button" class="gm-preset-chip" data-preset="grammarly.com">grammarly.com</button>
                  <button type="button" class="gm-preset-chip" data-preset="zapier.com">zapier.com</button>
                  <button type="button" class="gm-preset-chip" data-preset="linear.app">linear.app</button>
                </div>
              </div>

              {/* Privacy Reassurance Note */}
              <div class="gm-privacy-note type-caption text-mute">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>Automated &amp; private stack analysis. Submitted domains are evaluated in real time without storing browsing history.</span>
              </div>
            </form>

            {/* Recent Searches */}
            <div id="gm-recent" class="gm-recent" hidden>
              <span class="type-mono-caps text-mute">Recent:</span>
              <ul id="gm-recent-list" role="list" class="gm-recent-list"></ul>
              <button type="button" id="gm-recent-clear" class="gm-recent-clear type-caption">Clear</button>
            </div>

            {/* High-Tech Animated Radar Loading Card */}
            <div id="gm-loading" class="gm-loading" hidden aria-live="polite" aria-busy="true">
              <div class="gm-loading-card">
                <div class="gm-loading-head">
                  <div class="gm-radar-spinner" aria-hidden="true"></div>
                  <div class="gm-loading-titles">
                    <span class="type-mono-caps text-brand">Running Multi-Channel MarTech Audit</span>
                    <h3 class="gm-loading-headline" id="gm-loading-status-text">Connecting to destination edge node…</h3>
                  </div>
                </div>
                <div class="gm-scan-progress-bar">
                  <div class="gm-scan-progress-fill"></div>
                </div>
                <div class="gm-scan-steps">
                  <div class="gm-scan-step active" id="gm-step-1">
                    <span class="gm-step-dot"></span>
                    <span>Scanning HTML DOM, script sources &amp; iframe hosts for tracking tags</span>
                  </div>
                  <div class="gm-scan-step" id="gm-step-2">
                    <span class="gm-step-dot"></span>
                    <span>Auditing Google Tag Manager containers &amp; deobfuscating tags</span>
                  </div>
                  <div class="gm-scan-step" id="gm-step-3">
                    <span class="gm-step-dot"></span>
                    <span>Inspecting advertising pixels, payment SDKs &amp; live-chat widgets</span>
                  </div>
                  <div class="gm-scan-step" id="gm-step-4">
                    <span class="gm-step-dot"></span>
                    <span>Extracting measurement IDs (GA4, GTM, Meta Pixel, Stripe keys)</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Result Report Container */}
            <div id="gm-result" class="gm-result" hidden aria-live="polite"></div>

            {/* Error Message Alert */}
            <div id="gm-error" class="gm-error" hidden aria-live="assertive" role="alert"></div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 1: How to check */}
  <Section theme="light" ariaLabelledby="growth-how-to" class="gm-how-to-section">
    <div class="container">
      <div style="max-inline-size: 860px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xl);">
          <span class="eyebrow" style="color: var(--color-mute);">Step-by-step discovery</span>
          <h2 id="growth-how-to" class="type-display-sm" style="color: var(--color-ink);">
            How to Detect What Marketing Tech a Website Uses
          </h2>
          <p class="type-subtitle" style="color: var(--color-slate);">
            Modern websites orchestrate dozens of third-party scripts for measurement, attribution, payments, and customer support. Follow these three verification steps:
          </p>
        </div>

        <div class="gm-guide-grid">
          <div class="gm-guide-card">
            <div class="gm-guide-num">01</div>
            <h3 class="gm-guide-title">Submit the Exact Domain or URL</h3>
            <p class="gm-guide-text">
              Paste the target URL (e.g. <code>https://example.com</code> or <code>example.com</code>) into the detector. Our edge worker safely downloads the document, first-party bundles, and GTM container files without running untrusted scripts in your browser.
            </p>
          </div>
          <div class="gm-guide-card">
            <div class="gm-guide-num">02</div>
            <h3 class="gm-guide-title">Explore Grouped Categories &amp; Tools</h3>
            <p class="gm-guide-text">
              Filter findings across five key growth pillars: Analytics, Advertising, Marketing &amp; CRM, Payments, and Live Chat. Each finding is tagged with a transparent confidence rating.
            </p>
          </div>
          <div class="gm-guide-card">
            <div class="gm-guide-num">03</div>
            <h3 class="gm-guide-title">Inspect Raw Script Evidence &amp; IDs</h3>
            <p class="gm-guide-text">
              Expand any tool card to see the verbatim technical evidence: matched script hosts, SDK initialization code, container tags, and extracted IDs (such as GA4 measurement IDs or Stripe keys) with one-click copying.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 2: What we check */}
  <Section theme="dark" ariaLabelledby="growth-checks" class="gm-checks-section">
    <div class="container">
      <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
        <span class="eyebrow type-mono-eyebrow">Comprehensive Inspection Engine</span>
        <h2 id="growth-checks" class="type-display-sm" style="color: var(--color-on-primary);">
          What Marketing Technologies Can You Detect?
        </h2>
        <p class="type-subtitle text-ash" style="max-inline-size: 680px;">
          Rather than relying on keyword guessing, our analyzer verifies technical evidence across 38+ industry-standard marketing and growth platforms:
        </p>
      </div>

      <div class="gm-checks-grid">
        <div class="gm-check-box">
          <div class="gm-check-head">
            <span class="gm-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Measurement</span>
          </div>
          <h3 class="gm-check-title">Web &amp; Product Analytics</h3>
          <p class="gm-check-desc">
            Identifies Google Analytics (GA4), Plausible, PostHog, Mixpanel, Hotjar, Microsoft Clarity, Matomo, Heap, and Segment by tracking script hosts and global initializers.
          </p>
        </div>

        <div class="gm-check-box">
          <div class="gm-check-head">
            <span class="gm-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Attribution</span>
          </div>
          <h3 class="gm-check-title">Ad Pixels &amp; Retargeting</h3>
          <p class="gm-check-desc">
            Detects Meta Pixel (Facebook), Google Ads, LinkedIn Insight Tag, TikTok Pixel, Reddit Pixel, Pinterest Tag, and Snapchat Pixel conversion tracking beacons.
          </p>
        </div>

        <div class="gm-check-box">
          <div class="gm-check-head">
            <span class="gm-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Automation</span>
          </div>
          <h3 class="gm-check-title">Marketing Automation &amp; CRM</h3>
          <p class="gm-check-desc">
            Audits inbound marketing forms and tracking scripts from HubSpot, Klaviyo, Mailchimp, Marketo, ActiveCampaign, and Salesforce Marketing Cloud.
          </p>
        </div>

        <div class="gm-check-box">
          <div class="gm-check-head">
            <span class="gm-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Checkout</span>
          </div>
          <h3 class="gm-check-title">Payment Gateways &amp; Wallets</h3>
          <p class="gm-check-desc">
            Verifies billing SDKs and digital wallet hooks including Stripe (Elements &amp; Checkout), PayPal SDK, Apple Pay, Google Pay, Adyen, Razorpay, and Square.
          </p>
        </div>

        <div class="gm-check-box">
          <div class="gm-check-head">
            <span class="gm-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Messaging</span>
          </div>
          <h3 class="gm-check-title">Customer Chat &amp; Support</h3>
          <p class="gm-check-desc">
            Finds live-chat widgets, support hubs, and conversational bots including Intercom, Zendesk Web Widget, Crisp, Drift, Tawk.to, LiveChat, and HubSpot Chat.
          </p>
        </div>

        <div class="gm-check-box">
          <div class="gm-check-head">
            <span class="gm-check-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </span>
            <span class="type-mono-caps text-mute">Containers</span>
          </div>
          <h3 class="gm-check-title">Tag Management &amp; Containers</h3>
          <p class="gm-check-desc">
            Expands and deobfuscates Google Tag Manager (GTM) containers to discover nested analytics tags, third-party triggers, Segment events, and Adobe Launch suites.
          </p>
        </div>
      </div>
    </div>
  </Section>

  {/* Educational Section 3: Client vs Server side & methodology */}
  <Section theme="light" ariaLabelledby="growth-methodology" class="gm-safety-guide-section">
    <div class="container">
      <div style="max-inline-size: 860px; display: flex; flex-direction: column; gap: var(--spacing-xxl);">
        <div>
          <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-lg);">
            <span class="eyebrow" style="color: var(--color-mute);">Methodology &amp; Architecture</span>
            <h2 id="growth-methodology" class="type-display-sm" style="color: var(--color-ink);">
              Understanding Client-Side vs. Server-Side Marketing Tech
            </h2>
          </div>
          <p class="type-body" style="color: var(--color-slate); line-height: 1.7;">
            How marketing technology is loaded has changed dramatically over recent years. Understanding these patterns helps you interpret scanner results accurately:
          </p>
          <ul class="gm-cues-list">
            <li>
              <span class="gm-cue-bullet" aria-hidden="true">01</span>
              <div><strong>Client-Side Tagging (Standard):</strong> The browser directly fetches JavaScript files from vendor CDNs (e.g., <code>connect.facebook.net</code> or <code>js.stripe.com</code>). These are reliably detected with High or Very High confidence.</div>
            </li>
            <li>
              <span class="gm-cue-bullet" aria-hidden="true">02</span>
              <div><strong>Tag Manager Containers:</strong> Rather than hardcoding 10 different scripts into the HTML, developers bundle them inside Google Tag Manager. Our scanner expands GTM containers in real time to reveal what tags are active inside.</div>
            </li>
            <li>
              <span class="gm-cue-bullet" aria-hidden="true">03</span>
              <div><strong>Consent Management Delays:</strong> Under GDPR or CCPA rules, some platforms defer loading marketing pixels until a visitor gives cookie consent. If tags are strictly withheld prior to consent, our static scan reports what is present at initial load.</div>
            </li>
            <li>
              <span class="gm-cue-bullet" aria-hidden="true">04</span>
              <div><strong>Server-Side Tagging (SS-GTM):</strong> Tracking events sent through custom first-party reverse proxies or backend API endpoints emit no third-party script URLs, keeping them invisible to client DOM analysis.</div>
            </li>
          </ul>
        </div>

        <div class="gm-callout-card">
          <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-sm);">
            <span class="type-mono-caps text-brand">Core Detection Principle</span>
            <h2 id="growth-truth" class="type-heading-sm" style="color: var(--color-ink); margin: 0;">
              Why Technical Evidence Matters (No Keyword Guessing)
            </h2>
          </div>
          <p class="type-body" style="color: var(--color-slate); line-height: 1.7; margin: 0;">
            A common flaw of generic web tools is reporting a technology merely because its name appears in an article, a footer paragraph, or a standard link like <code>buy.stripe.com</code>.
          </p>
          <p class="type-body" style="color: var(--color-slate); line-height: 1.7; margin: 0;">
            <strong>We never do that.</strong> Every single finding in our detector requires active, verifiable technical usage evidence: a dedicated SDK script host, an initialization snippet with product keys, DOM form hooks, or platform cookies. If we cannot prove usage with verifiable technical evidence, we report <em>Not confidently detected</em>.
          </p>
        </div>

        <div style="border-block-start: 1px solid var(--color-hairline); padding-block-start: var(--spacing-xxl);">
          <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-lg);">
            <span class="eyebrow" style="color: var(--color-mute);">Interpreting confidence</span>
            <h2 id="growth-conf-explained" class="type-display-sm" style="color: var(--color-ink);">
              How Confidence Bands Are Calculated
            </h2>
          </div>
          <div class="gm-verdict-grid">
            <div class="gm-verdict-card-light">
              <div class="gm-verdict-card-top">
                <span class="gm-status-dot-glow dot-green"></span>
                <span class="gm-status-title-clean">VERY HIGH (90%+)</span>
              </div>
              <p class="gm-verdict-card-desc">Confirmed across multiple independent technical evidence families (e.g. verified script host + SDK initialization code + extracted identifier).</p>
            </div>
            <div class="gm-verdict-card-light">
              <div class="gm-verdict-card-top">
                <span class="gm-status-dot-glow dot-mint"></span>
                <span class="gm-status-title-mint">HIGH (75–89%)</span>
              </div>
              <p class="gm-verdict-card-desc">Verified by canonical third-party vendor script host, official embed endpoint, or primary SDK bundle with high specificity.</p>
            </div>
            <div class="gm-verdict-card-light">
              <div class="gm-verdict-card-top">
                <span class="gm-status-dot-glow dot-amber"></span>
                <span class="gm-status-title-warn">MEDIUM (60–74%)</span>
              </div>
              <p class="gm-verdict-card-desc">Solid technical signal from characteristic DOM element, deobfuscated GTM container tag, or platform tracking cookie.</p>
            </div>
            <div class="gm-verdict-card-light">
              <div class="gm-verdict-card-top">
                <span class="gm-status-dot-glow dot-gray"></span>
                <span class="gm-status-title-info">LOW (40–59%)</span>
              </div>
              <p class="gm-verdict-card-desc">Limited supporting signal (e.g. CSP header policy or generic SDK hook). Treated as a hint rather than a definitive confirmation.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Supported Technologies Directory */}
  <Section theme="dark" ariaLabelledby="growth-coverage" class="gm-coverage-section">
    <div class="container">
      <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
        <span class="eyebrow type-mono-eyebrow">Comprehensive Directory</span>
        <h2 id="growth-coverage" class="type-display-sm" style="color: var(--color-on-primary);">
          One Detector, Five Growth Categories
        </h2>
        <p class="type-subtitle text-ash" style="max-width: 620px;">
          Explore the 38+ analytics engines, advertising pixels, CRMs, payment providers, and customer support widgets supported by our scanner:
        </p>
      </div>
      <CoverageDirectory groups={groups} />
    </div>
  </Section>

  {/* Frequently Asked Questions */}
  <Section theme="light" ariaLabelledby="growth-faq">
    <div class="container">
      <div style="max-inline-size: 860px;">
        <div class="eyebrow-lockup" style="margin-block-end: var(--spacing-xxl);">
          <span class="eyebrow" style="color: var(--color-mute);">Common questions</span>
          <h2 id="growth-faq" class="type-display-sm" style="color: var(--color-ink);">
