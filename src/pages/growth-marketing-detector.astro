          </h2>
          <p class="type-subtitle" style="color: var(--color-slate);">
            Clear, honest answers about marketing technology detection, tag decompilation, and privacy standards.
          </p>
        </div>

        <div class="gm-faqs">
          {faqs.map((f, i) => (
            <details class="gm-faq-item" id={`faq-${i}`}>
              <summary class="gm-faq-summary">
                <span class="gm-faq-q">{f.q}</span>
                <svg class="gm-faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="gm-faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </Section>
</Base>

