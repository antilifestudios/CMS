  .gm-fams-summary {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-mute);
    line-height: 1.5;
  }
  .gm-fams-list {
    margin: 0;
    font-size: 11px;
    color: var(--color-slate-soft);
    font-family: var(--font-mono);
  }
  .gm-variant-note {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-ash);
    line-height: 1.5;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-app-sm);
    padding: 6px 10px;
    border-left: 2px solid var(--color-brand);
  }
  .gm-low-hint {
    margin: 0;
    font-size: 12px;
    color: var(--color-ash);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-app-sm);
    padding: 6px 10px;
  }

  /* Extracted Identifiers */
  .gm-ids-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-block-start: 4px;
  }
  .gm-ids-lbl {
    font-size: 10px;
    letter-spacing: 0.06em;
  }
  .gm-ids-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .gm-id-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-app-sm);
    padding: 6px 10px;
    min-inline-size: 0;
  }
  .gm-id-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-inline-size: 0;
    overflow: hidden;
  }
  .gm-id-kind {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-mute);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }
  .gm-id-val {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-on-primary);
    overflow-wrap: anywhere;
    word-break: break-all;
  }

  /* Evidence Accordion */
  .gm-ev {
    margin-block-start: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 8px;
  }
  .gm-ev-toggle {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-mute);
    list-style: none;
    font-size: 12.5px;
    font-weight: 500;
    padding-block: 4px;
  }
  .gm-ev-toggle::-webkit-details-marker { display: none; }
  .gm-ev-toggle:hover { color: var(--color-ash); }
  details[open] .gm-toggle-icon { transform: rotate(180deg); }
  .gm-toggle-icon { transition: transform 0.15s ease; }
  .gm-ev-groups {
    margin: 8px 0 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gm-ev-group-label {
    display: block;
    margin-block-end: 4px;
    font-size: 10px;
  }
  .gm-ev-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .gm-ev-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    background-color: var(--color-canvas);
    border-radius: var(--radius-app-sm);
    padding: 6px 8px;
    min-inline-size: 0;
  }
  .gm-ev-main {
    flex: 1;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .gm-ev-desc {
    font-size: 11.5px;
    color: var(--color-ash);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .gm-ev-text {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-ash);
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .gm-ev-host {
    color: var(--color-on-primary);
    font-weight: 500;
    display: block;
  }
  .gm-ev-path {
    color: var(--color-mute);
    display: block;
