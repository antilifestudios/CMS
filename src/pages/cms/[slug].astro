---
/**
 * Per-technology SEO pages: /cms/[slug]
 * Fully prerendered (static HTML, no JS needed to read).
 * Each page: what it is, how we detect it, manual verification,
 * alternatives, FAQ + JSON-LD, mini-checker island, related links.
 */
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { TECHNOLOGIES, CATEGORY_LABELS } from '../../data/technologies';

export function getStaticPaths() {
  return TECHNOLOGIES.map((t) => ({ params: { slug: t.slug }, props: { tech: t } }));
}

const { tech } = Astro.props;
const pagePath = `/cms/${tech.slug}`;
const siteUrl = 'https://cmsdetectorai.com';
const canonical = `${siteUrl}${pagePath}`;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tech.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
  inLanguage: 'en',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Technologies', item: `${siteUrl}/#technologies` },
    { '@type': 'ListItem', position: 3, name: tech.name, item: canonical },
  ],
};

const categoryLabel =
  tech.category === 'cms' ? 'CMS' : CATEGORY_LABELS[tech.category].replace(/s$/, '');
---

<Base
  title={tech.metaTitle}
  description={tech.metaDescription}
  pagePath={pagePath}
  jsonLd={[faqJsonLd, breadcrumbJsonLd]}
>
  <!-- Hero (dark) -->
  <section class="section-dark" aria-labelledby="tech-h1" style="padding-block: var(--spacing-section);">
    <div class="container">
      <nav aria-label="Breadcrumb" class="crumbs type-mono-micro text-mute">
        <a href="/" class="text-link-dark">Home</a>
        <span aria-hidden="true"> / </span>
        <span>{tech.name}</span>
      </nav>
      <div class="eyebrow-lockup" style="margin-block-start: var(--spacing-md);">
        <span class="eyebrow type-mono-eyebrow">{categoryLabel} detection</span>
        <h1 id="tech-h1" class="type-display-md" style="color: var(--color-on-primary); margin: 0;">
          {tech.name}: how to detect it
        </h1>
        <p class="type-subtitle text-ash" style="margin: 0; max-inline-size: 620px;">{tech.tagline}</p>
      </div>

      <!-- Mini checker -->
      <form id="mini-form" class="mini-form" aria-label={`Check a site for ${tech.name}`} novalidate>
        <label for="mini-input" class="sr-only">Website URL to check for {tech.name}</label>
        <input
          id="mini-input"
          type="url"
          inputmode="url"
          autocomplete="url"
          class="input mini-input"
          placeholder="https://example.com"
          required
        />
        <button type="submit" class="btn btn-primary mini-btn" id="mini-submit">
          Check this site
        </button>
      </form>
      <div id="mini-loading" hidden aria-live="polite" style="margin-block-start: 16px;">
        <div class="skeleton" style="block-size: 64px; border-radius: 12px; max-inline-size: 640px;"></div>
      </div>
      <div id="mini-result" hidden aria-live="polite" style="margin-block-start: 16px;"></div>
      <div id="mini-error" hidden role="alert" style="margin-block-start: 16px;"></div>
    </div>
  </section>

  <!-- About (light) -->
  <section class="section-light" aria-labelledby="about-h2">
    <div class="container">
      <div class="prose">
        <h2 id="about-h2" class="type-display-sm" style="color: var(--color-ink); margin: 0 0 16px 0;">
          What is {tech.name}?
        </h2>
        {tech.about.map((p) => (
          <p class="type-body" style="color: var(--color-slate);">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Detection + verify (paper) -->
  <section class="section-paper" aria-labelledby="detect-h2">
    <div class="container">
      <div class="two-col">
        <div class="card-light">
          <h2 id="detect-h2" class="type-heading-sm" style="color: var(--color-ink); margin: 0 0 12px 0;">
            How we detect {tech.name}
          </h2>
          <p class="type-body-sm" style="color: var(--color-slate); margin: 0 0 12px 0;">
            Our detector matches these artifact kinds, then scores them into
            <strong>Confirmed</strong>, <strong>Likely</strong>, or <strong>Possible</strong>.
            <a href="/methodology" class="text-link-light">How scoring works</a>.
          </p>
          <ul role="list" class="check-list">
            {tech.detects.map((d) => (
              <li class="type-body-sm" style="color: var(--color-ink);">{d}</li>
            ))}
          </ul>
        </div>
        <div class="card-light">
          <h2 class="type-heading-sm" style="color: var(--color-ink); margin: 0 0 12px 0;">
            Verify manually in under a minute
          </h2>
          <ol class="verify-list">
            {tech.verify.map((v) => (
              <li class="type-body-sm" style="color: var(--color-slate);">{v}</li>
            ))}
          </ol>
          <p class="type-body-sm" style="margin-block-end: 0;">
            <a href="/guides/how-to-find-what-cms-a-website-uses" class="text-link-light">
              Full manual guide: view-source and DevTools steps
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternatives (dark) -->
  <section class="section-dark" aria-labelledby="alts-h2">
    <div class="container">
      <h2 id="alts-h2" class="type-display-sm" style="margin: 0 0 24px 0;">Common alternatives</h2>
      <div class="alt-grid">
        {tech.alternatives.map((a) => (
          <a href={`/cms/${a.slug}`} class="card-dark alt-card">
            <span class="type-heading-sm" style="margin: 0;">{a.name}</span>
            <span class="type-caption text-mute">How to detect {a.name} →</span>
          </a>
        ))}
        <a href="/" class="card-dark alt-card">
          <span class="type-heading-sm" style="margin: 0;">Run the detector</span>
          <span class="type-caption text-mute">Check any site free →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ (light) -->
  <section class="section-light" aria-labelledby="faq-h2">
    <div class="container">
      <div class="prose">
        <h2 id="faq-h2" class="type-display-sm" style="color: var(--color-ink); margin: 0 0 24px 0;">
          {tech.name} FAQ
        </h2>
        <div class="faq-list">
          {tech.faqs.map((f) => (
            <details class="faq-item card-light">
              <summary class="type-heading-sm faq-q" style="color: var(--color-ink);">{f.q}</summary>
              <p class="type-body" style="color: var(--color-slate); margin-block-end: 0;">{f.a}</p>
            </details>
          ))}
        </div>
        <h3 class="type-heading-sm" style="color: var(--color-ink); margin-block: 32px 16px;">
          Related technologies
        </h3>
        <ul role="list" class="related-list">
          {tech.related.map((r) => (
            <li><a href={`/cms/${r.slug}`} class="text-link-light type-body-sm">How to detect {r.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { margin-block-end: 8px; }
  .crumbs a { text-decoration: underline; }
  .mini-form { display: flex; gap: 8px; margin-block-start: 24px; max-inline-size: 640px; }
  .mini-input {
    flex: 1; block-size: 52px; font-size: 16px; border-radius: var(--radius-app-lg);
    padding-inline: var(--spacing-lg); background-color: rgba(255,255,255,0.06);
    border: 1px solid var(--color-hairline-soft); color: var(--color-on-primary);
  }
  .mini-input:focus { outline: none; border-color: rgba(255,255,255,0.5); }
  .mini-input::placeholder { color: var(--color-slate-soft); }
  .mini-btn { block-size: 52px; flex-shrink: 0; }
  .prose { max-inline-size: 720px; }
  .prose p { margin: 0 0 16px 0; }
  .two-col { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-lg); }
  .check-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .check-list li { padding-inline-start: 24px; position: relative; }
  .check-list li::before {
    content: ""; position: absolute; inset-inline-start: 0; inset-block-start: 7px;
    inline-size: 12px; block-size: 12px; border-radius: 9999px;
    border: 2px solid var(--color-ink);
  }
  .verify-list { margin: 0 0 16px 0; padding-inline-start: 20px; display: flex; flex-direction: column; gap: 8px; }
  .alt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-lg); }
  .alt-card { display: flex; flex-direction: column; gap: 8px; text-decoration: none; transition: transform 0.15s ease; }
  .alt-card:hover { transform: translateY(-2px); }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { padding: var(--spacing-lg); }
  .faq-q { cursor: pointer; margin: 0; }
  .related-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  @media (max-width: 768px) {
    .two-col { grid-template-columns: 1fr; }
    .alt-grid { grid-template-columns: 1fr; }
    .mini-form { flex-direction: column; }
    .mini-btn { inline-size: 100%; }
  }
</style>

<script define:vars={{ slug: tech.slug, techName: tech.name }}>
const form = document.getElementById('mini-form');
const input = document.getElementById('mini-input');
const submit = document.getElementById('mini-submit');
const loading = document.getElementById('mini-loading');
const result = document.getElementById('mini-result');
const errorBox = document.getElementById('mini-error');

function esc(s) {
  return String(s ?? '')
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

form?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const url = input?.value.trim() ?? '';
  if (!url || !result || !loading || !errorBox) return;
  loading.hidden = false; result.hidden = true; errorBox.hidden = true;
  if (submit) { submit.disabled = true; submit.textContent = 'Checking…'; }
  try {
    const w = window as unknown as { cmsDetectorToken?: () => Promise<string> };
    const token = await (w.cmsDetectorToken ? w.cmsDetectorToken() : Promise.resolve(''));
    const res = await fetch('/api/detect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, token }),
    });
    const data = await res.json();
    loading.hidden = true;
    if (submit) { submit.disabled = false; submit.textContent = 'Check this site'; }
    if (data.ok) {
      const match = (data.data.results ?? []).find((r) => (r.pageSlug ?? r.id) === slug);
      if (match) {
        result.innerHTML = `<div class="card-dark" style="max-inline-size: 640px;">
          <p class="type-mono-caps text-mute" style="margin: 0 0 4px 0;">Result</p>
          <p class="type-heading-sm" style="color: var(--color-on-primary); margin: 0;">
            Yes — ${esc(match.name)} detected
            <span class="badge chip-${esc(match.confidenceLabel)}">${esc(match.confidenceLabel)}</span>
          </p></div>`;
      } else {
        result.innerHTML = `<div class="card-dark" style="max-inline-size: 640px;">
          <p class="type-heading-sm" style="color: var(--color-on-primary); margin: 0 0 4px 0;">No ${esc(techName)} detected</p>
          <p class="type-body-sm text-ash" style="margin: 0;">This site does not appear to use ${esc(techName)}.
          <a href="/" class="text-link-dark">Run the full check</a> to see what it does use.</p></div>`;
      }
      result.hidden = false;
    } else {
      errorBox.innerHTML = `<div class="card-dark" style="max-inline-size: 640px;">
        <p class="type-body-sm text-ash" style="margin: 0;">Could not check that URL (${esc(data.error?.code ?? 'UNKNOWN')}). Please verify it and try again.</p></div>`;
      errorBox.hidden = false;
    }
  } catch {
    loading.hidden = true;
    if (submit) { submit.disabled = false; submit.textContent = 'Check this site'; }
    errorBox.innerHTML = `<div class="card-dark" style="max-inline-size: 640px;">
      <p class="type-body-sm text-ash" style="margin: 0;">Network error. Please try again.</p></div>`;
    errorBox.hidden = false;
  }
});
</script>
