---
export const prerender = true;
import Base from '../../layouts/Base.astro';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the fastest way to find what CMS a website uses?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Paste the URL into a detector, or view page source (Ctrl+U) and search for generator, wp-content, or CDN hostnames. Checking response headers in DevTools takes under a minute.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I find a website’s CMS without any tools?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. View-source for generator tags and asset paths, DevTools Network tab for platform headers, and /wp-json/ or /ghost/ probes cover most platforms with only a browser.',
      },
    },
  ],
  inLanguage: 'en',
};
---

<Base
  title="How to Find What CMS a Website Uses (Manual Methods)"
  description="Find any site's CMS manually: view-source checks, DevTools headers, and platform probes. Step-by-step, under a minute."
  pagePath="/guides/how-to-find-what-cms-a-website-uses"
  jsonLd={faqJsonLd}
>
  <section class="section-dark" style="padding-block: var(--spacing-section);" aria-labelledby="g-h1">
    <div class="container">
      <div class="eyebrow-lockup">
        <span class="eyebrow type-mono-eyebrow">Guide · Manual methods</span>
        <h1 id="g-h1" class="type-display-md" style="color: var(--color-on-primary); margin: 0; max-inline-size: 800px;">
          How to find what CMS a website uses
        </h1>
        <p class="type-subtitle text-ash" style="margin: 0; max-inline-size: 620px;">
          Three browser-only methods that take under a minute — no installs, no sign-ups.
        </p>
      </div>
    </div>
  </section>

  <section class="section-light" aria-labelledby="m1">
    <div class="container">
      <div class="prose">
        <h2 id="m1" class="type-heading-md" style="color: var(--color-ink); margin: 0 0 12px 0;">Method 1 — View page source (30 seconds)</h2>
        <ol class="steps">
          <li>Open the site, press <kbd>Ctrl</kbd>+<kbd>U</kbd> (Windows/Linux) or <kbd>Cmd</kbd>+<kbd>Option</kbd>+<kbd>U</kbd> (Mac).</li>
          <li>Press <kbd>Ctrl</kbd>+<kbd>F</kbd> and search for <code>generator</code> — a meta tag often names the CMS and version outright.</li>
          <li>Search for <code>wp-content</code> (WordPress), <code>cdn.shopify.com</code> (Shopify), <code>website-files</code> (Webflow), <code>__NEXT_DATA__</code> (Next.js), or <code>ctfassets</code> (Contentful).</li>
          <li>Check script <code>src</code> hosts — platform CDNs (<code>wixstatic.com</code>, <code>squarespace-cdn.com</code>) are decisive.</li>
        </ol>

        <h2 class="type-heading-md" style="color: var(--color-ink); margin: 32px 0 12px 0;">Method 2 — Response headers in DevTools (30 seconds)</h2>
        <ol class="steps">
          <li>Press <kbd>F12</kbd>, open the <strong>Network</strong> tab, and reload the page.</li>
          <li>Click the top document request and open <strong>Response Headers</strong>.</li>
          <li>Look for <code>x-powered-by</code>, <code>server</code>, <code>cf-ray</code> (Cloudflare), <code>x-vercel-id</code> (Vercel), <code>x-nf-request-id</code> (Netlify), or <code>x-shopify-stage</code> (Shopify).</li>
          <li>Open the <strong>Application → Cookies</strong> panel: <code>wordpress_</code>, <code>_shopify_</code>, <code>csrftoken</code>, or 32-hex-char session IDs each point somewhere specific.</li>
        </ol>

        <h2 class="type-heading-md" style="color: var(--color-ink); margin: 32px 0 12px 0;">Method 3 — Platform probes (20 seconds)</h2>
        <ol class="steps">
          <li>Append <code>/wp-json/</code> — a JSON namespaces listing confirms WordPress.</li>
          <li>Append <code>/ghost/</code> — Ghost’s admin screen confirms Ghost.</li>
          <li>Append <code>/products.json</code> on a suspected store — Shopify’s catalogue API confirms Shopify.</li>
          <li>Append <code>/config</code> — a login redirect confirms Squarespace.</li>
        </ol>

        <h2 class="type-heading-md" style="color: var(--color-ink); margin: 32px 0 12px 0;">When manual checks fail</h2>
        <p class="type-body" style="color: var(--color-slate);">Hardened, headless, or custom-built sites may expose nothing — that absence is itself information. Our <a href="/" class="text-link-light">automatic detector</a> runs all of these checks plus header, cookie, and DNS analysis in under 3 seconds and explains its confidence. Read <a href="/methodology" class="text-link-light">how scoring works</a> before trusting any single clue.</p>

        <h2 class="type-heading-md" style="color: var(--color-ink); margin: 32px 0 12px 0;">FAQ</h2>
        <details class="card-light" style="margin-block-end: 12px;">
          <summary class="type-heading-sm" style="color: var(--color-ink); cursor: pointer;">What is the fastest way to find what CMS a website uses?</summary>
          <p class="type-body" style="color: var(--color-slate);">Paste the URL into a detector, or view page source and search for generator tags and platform paths. Headers in DevTools take under a minute.</p>
        </details>
        <details class="card-light">
          <summary class="type-heading-sm" style="color: var(--color-ink); cursor: pointer;">Can I find a website’s CMS without any tools?</summary>
          <p class="type-body" style="color: var(--color-slate);">Yes — view-source, DevTools headers, and direct probes like /wp-json/ cover most platforms with only a browser.</p>
        </details>
      </div>
    </div>
  </section>
</Base>

<style>
  .prose { max-inline-size: 720px; }
  .prose p { margin: 0 0 16px 0; }
  .steps { margin: 0 0 16px 0; padding-inline-start: 22px; display: flex; flex-direction: column; gap: 10px; }
  .steps li { color: var(--color-slate); font-size: 16px; line-height: 1.6; }
  .steps li strong { color: var(--color-ink); }
  .prose code, .prose kbd { font-family: var(--font-mono); font-size: 13px; background: var(--color-hairline); padding: 2px 6px; border-radius: 3px; }
</style>
