---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Is This Site WordPress? — Instant WordPress Checker',
  url: 'https://cmsdetectorai.com/is-this-site-wordpress',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Check whether any website runs on WordPress. Clear yes/no answer backed by real evidence.',
  inLanguage: 'en',
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How can I tell if a website is WordPress?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'View page source and search for "wp-content", check the generator meta tag, or open /wp-json/. Our checker automates all three and shows the evidence.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can a WordPress site hide that it uses WordPress?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hardened sites can remove the generator tag, but REST API endpoints, feed URLs, and plugin asset paths usually remain visible.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this WordPress checker free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — unlimited checks, no sign-up, and we never store the URLs you enter.',
      },
    },
  ],
  inLanguage: 'en',
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cmsdetectorai.com' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Is This Site WordPress?',
      item: 'https://cmsdetectorai.com/is-this-site-wordpress',
    },
  ],
};
---

<Base
  title="Is This Site Built on WordPress? — Instant WordPress Checker"
  description="Quickly check whether any website runs on WordPress. Get a clear yes/no answer backed by real evidence."
  pagePath="/is-this-site-wordpress"
  jsonLd={[webAppJsonLd, faqJsonLd, breadcrumbJsonLd]}
>
  <Section theme="dark" style="min-block-size: 60vh; display: flex; align-items: center;" ariaLabelledby="wp-h1">
    <div class="container">
      <div style="max-inline-size: 860px;">
        <div class="eyebrow-lockup">
          <span class="eyebrow type-mono-eyebrow">WordPress checker</span>
          <h1 id="wp-h1" class="type-display-xl" style="color: var(--color-on-primary); margin: 0;">
            Is This Site<br />Built on WordPress?
          </h1>
          <p class="type-subtitle text-ash" style="margin: 0; max-inline-size: 540px;">
            Paste any URL for a clear yes-or-no answer — backed by the exact
            evidence we found, never a guess.
          </p>
        </div>
        <div style="margin-block-start: var(--spacing-xxl);">
          <form id="iswp-form" novalidate aria-label="WordPress yes/no check">
            <div class="input-row">
              <label for="iswp-input" class="sr-only">Website URL</label>
              <input
                id="iswp-input" type="url" inputmode="url" autocomplete="url"
                class="input url-input" placeholder="https://example.com" required
              />
              <button type="submit" class="btn btn-primary detect-btn" id="iswp-submit">Check</button>
            </div>
          </form>
          <div id="iswp-loading" hidden aria-live="polite" aria-busy="true" style="margin-block-start: 24px;">
            <div class="skeleton-card">
              <div class="skeleton sk-row" style="block-size: 32px; inline-size: 50%; border-radius: 4px;"></div>
              <div class="skeleton sk-row" style="block-size: 20px; inline-size: 70%; border-radius: 4px;"></div>
            </div>
          </div>
          <div id="iswp-result" hidden aria-live="polite" style="margin-block-start: 24px;"></div>
          <div id="iswp-error" hidden role="alert" style="margin-block-start: 24px;"></div>
        </div>
      </div>
    </div>
  </Section>

  <Section theme="light" ariaLabelledby="iswp-how">
    <div class="container">
      <div style="max-inline-size: 680px;">
        <h2 id="iswp-how" class="type-display-sm" style="color: var(--color-ink); margin: 0 0 16px 0;">
          What counts as a “yes”
        </h2>
        <p class="type-body" style="color: var(--color-slate);">
          A <strong style="color: var(--color-ink);">Yes</strong> means we found WordPress-specific
          proof: a generator tag, <code class="inline-code">wp-content</code> asset paths, the
          REST API at <code class="inline-code">/wp-json/</code>, or WordPress cookies.
          A <strong style="color: var(--color-ink);">No</strong> means none of these appeared —
          the site runs on something else or is custom-built.
        </p>
        <p class="type-body" style="color: var(--color-slate);">
          Want the full picture — theme, plugins, and hosting?
          <a href="/" class="text-link-light">Run the complete CMS check</a> or read
          <a href="/cms/wordpress" class="text-link-light">how WordPress detection works</a>.
        </p>
      </div>
    </div>
  </Section>

  <Section theme="light" ariaLabelledby="iswp-faq">
    <div class="container">
      <div style="max-inline-size: 680px;">
        <h2 id="iswp-faq" class="type-display-sm" style="color: var(--color-ink); margin: 0 0 24px 0;">
          Frequently asked questions
        </h2>
        <details class="card-light" style="margin-block-end: 12px;">
          <summary class="type-heading-sm" style="color: var(--color-ink); cursor: pointer;">How can I tell if a website is WordPress?</summary>
          <p class="type-body" style="color: var(--color-slate);">View page source and search for “wp-content”, check the generator meta tag, or open /wp-json/. Our checker automates all three and shows the evidence.</p>
        </details>
        <details class="card-light" style="margin-block-end: 12px;">
          <summary class="type-heading-sm" style="color: var(--color-ink); cursor: pointer;">Can a WordPress site hide that it uses WordPress?</summary>
          <p class="type-body" style="color: var(--color-slate);">Hardened sites can remove the generator tag, but REST API endpoints, feed URLs, and plugin asset paths usually remain visible.</p>
        </details>
        <details class="card-light">
          <summary class="type-heading-sm" style="color: var(--color-ink); cursor: pointer;">Is this WordPress checker free?</summary>
          <p class="type-body" style="color: var(--color-slate);">Yes — unlimited checks, no sign-up, and we never store the URLs you enter.</p>
        </details>
      </div>
    </div>
  </Section>
</Base>

<style>
  .input-row { display: flex; gap: 8px; }
  .url-input {
    flex: 1; block-size: 56px; font-size: 17px; border-radius: var(--radius-app-lg);
    padding-inline: var(--spacing-lg); background-color: rgba(255,255,255,0.06);
    border: 1px solid var(--color-hairline-soft); color: var(--color-on-primary);
  }
  .url-input:focus { outline: none; border-color: rgba(255,255,255,0.5); }
  .url-input::placeholder { color: var(--color-slate-soft); }
  .detect-btn { block-size: 56px; }
  .inline-code { font-family: var(--font-mono); font-size: 13px; background: var(--color-hairline); padding: 2px 6px; border-radius: 3px; }
  .skeleton-card { background: var(--color-canvas-soft); border-radius: var(--radius-marketing); padding: var(--spacing-xl); border: 1px solid var(--color-hairline-soft); display: flex; flex-direction: column; gap: 12px; }
  @media (max-width: 480px) { .input-row { flex-direction: column; } .detect-btn { inline-size: 100%; } }
</style>

<script>
const form = document.getElementById('iswp-form') as HTMLFormElement | null;
const input = document.getElementById('iswp-input') as HTMLInputElement | null;
const btn = document.getElementById('iswp-submit') as HTMLButtonElement | null;
const loadEl = document.getElementById('iswp-loading') as HTMLElement | null;
const resEl = document.getElementById('iswp-result') as HTMLElement | null;
const errEl = document.getElementById('iswp-error') as HTMLElement | null;

function esc(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
input?.focus();
form?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const url = input?.value.trim() ?? '';
  if (!url || !resEl || !loadEl || !errEl) return;
  loadEl.hidden = false; resEl.hidden = true; errEl.hidden = true;
  if (btn) { btn.disabled = true; btn.textContent = 'Checking…'; }
  try {
    const token = await ((window as any).cmsDetectorToken ? (window as any).cmsDetectorToken() : '');
    const res = await fetch('/api/detect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, token }),
    });
    const data = await res.json() as any;
    if (loadEl) loadEl.hidden = true;
    if (btn) { btn.disabled = false; btn.textContent = 'Check'; }
    if (data.ok) {
      const wp = (data.data.results ?? []).find((r: any) => r.id === 'wordpress' && r.confidenceLabel !== 'possible');
      const theme = data.data.wordpressTheme;
      const themeLine = theme?.name
        ? `<p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">Active theme: ${esc(theme.name)}${theme.version ? ` v${esc(theme.version)}` : ''}</p>`
        : '';
      resEl.innerHTML = wp
        ? `<div class="card-dark"><p class="type-mono-caps text-mute" style="margin: 0 0 4px 0;">Answer</p>
           <p class="type-display-sm" style="color: var(--color-on-primary); margin: 0;">Yes — this is WordPress.</p>
           <p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">Confidence: ${esc(wp.confidenceLabel)} (${esc(String(wp.confidence))}/100). <a href="/cms/wordpress" class="text-link-dark">Why we think this</a></p>${themeLine}</div>`
        : `<div class="card-dark"><p class="type-mono-caps text-mute" style="margin: 0 0 4px 0;">Answer</p>
           <p class="type-display-sm" style="color: var(--color-on-primary); margin: 0;">No — not WordPress.</p>
           <p class="type-body-sm text-ash" style="margin: 8px 0 0 0;">No WordPress fingerprints found. <a href="/" class="text-link-dark">See what it does use</a></p></div>`;
      resEl.hidden = false;
    } else {
      if (errEl) {
        errEl.innerHTML = `<div class="card-dark"><p class="type-body-sm text-ash" style="margin: 0;">Could not check that URL (${esc(data.error?.code ?? 'UNKNOWN')}). Please verify it and try again.</p></div>`;
        errEl.hidden = false;
      }
    }
  } catch {
    if (loadEl) loadEl.hidden = true;
    if (btn) { btn.disabled = false; btn.textContent = 'Check'; }
    if (errEl) {
      errEl.innerHTML = `<div class="card-dark"><p class="type-body-sm text-ash" style="margin: 0;">Network error. Please try again.</p></div>`;
      errEl.hidden = false;
    }
  }
});
</script>
